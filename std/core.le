namespace libc;
global pub, external;

fn atoi(string str) @alias(string::atoi) -> i32;
fn atol(string str) @alias(string::atol) -> i64;
fn atof(string str) @alias(string::atof) -> f64;
fn strtol(string str, string *endptr, i32 base) @alias(string::strtol) -> i64;

fn abort() @alias(libc::abort);
fn exit(i32 code) @alias(libc::exit);
fn system(string cmd) @alias(libc::system);
fn sleep(i32 seconds) @alias(libc::sleep);
