use std/libc/io;
use std/core;

global pub, external;

fn io::dbg(ElleMeta meta, ...args) @fmt;
fn io::print(ElleMeta meta, ...args) @fmt;
fn io::println(ElleMeta meta, ...args) @fmt;
fn io::eprint(ElleMeta meta, ...args) @fmt;
fn io::eprintln(ElleMeta meta, ...args) @fmt;
fn io::printf(ElleMeta meta, string fmt, ...args) @fmt;
fn io::eprintf(ElleMeta meta, string fmt, ...) @fmt;
fn io::panic(ElleMeta meta, string fmt, ...) @fmt;
fn io::die(ElleMeta meta);
fn io::todo(ElleMeta meta, string message);
fn io::unimplemented(ElleMeta meta);
fn io::assert(ElleMeta meta, bool condition, ...);

// These functions shouldn't have aliases because they're not as common
fn io::input(string message) -> string;
fn io::read_to_string(string path) -> string;
fn io::read_file_binary(string path) -> u8[];
fn io::write_to_file(string path, string content) -> bool;

fn io::dbg(ElleMeta meta, ...args) @fmt @alias($dbg);
fn io::print(ElleMeta meta, ...args) @fmt @alias($print);
fn io::println(ElleMeta meta, ...args) @fmt @alias($println);
fn io::eprint(ElleMeta meta, ...args) @fmt @alias($eprint);
fn io::eprint(ElleMeta meta, ...args) @fmt @alias($eprintln);
fn io::printf(ElleMeta meta, string fmt, ...args) @fmt @alias($printf);
fn io::eprintf(ElleMeta meta, string fmt, ...args) @fmt @alias($eprintf);
fn io::panic(ElleMeta meta, string fmt, ...) @fmt @alias($panic);
fn io::die(ElleMeta meta) @alias($die);
fn io::todo(ElleMeta meta, string message) @alias($todo);
fn io::unimplemented(ElleMeta meta) @alias($unimplemented);
fn io::assert(ElleMeta meta, bool condition, ...) @alias($assert);
