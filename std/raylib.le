fn DrawCircleSector(Vector2 center, f32 radius, f32 startAngle, f32 endAngle, i32 segments, Color color)      @alias(rl::draw_circle_sector);            // Draw a piece of a circle
fn DrawCircleSectorLines(Vector2 center, f32 radius, f32 startAngle, f32 endAngle, i32 segments, Color color) @alias(rl::draw_circle_sector_lines);      // Draw circle sector outline
fn DrawCircleGradient(i32 centerX, i32 centerY, f32 radius, Color color1, Color color2)                 @alias(rl::draw_circle_gradient);                   // Draw a gradient-filled circle
fn DrawCircleV(Vector2 center, f32 radius, Color color)                                                 @alias(rl::draw_circle_v);                          // Draw a color-filled circle (Vector version)
fn DrawCircleLines(i32 centerX, i32 centerY, f32 radius, Color color)                                   @alias(rl::draw_circle_lines);                      // Draw circle outline
fn DrawCircleLinesV(Vector2 center, f32 radius, Color color)                                            @alias(rl::draw_circle_lines_v);                    // Draw circle outline (Vector version)
