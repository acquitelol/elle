// Text codepoints management functions (unicode characters)
fn LoadUTF8(i32 *codepoints, i32 length)                        @alias(rl::load_utf8)               -> string;           // Load UTF-8 text encoded from codepoints array
fn UnloadUTF8(string text)                                      @alias(rl::unload_utf8);                                 // Unload UTF-8 text encoded from codepoints array
fn LoadCodepoints(string text, i32 *count)                      @alias(rl::load_codepoints)         -> i32 *;            // Load all codepoints from a UTF-8 text string, codepoints count returned by parameter
fn UnloadCodepoints(i32 *codepoints)                            @alias(rl::unload_codepoints);                           // Unload codepoints data from memory
fn GetCodepointCount(string text)                               @alias(rl::get_codepoint_count)     -> i32;              // Get total number of codepoints in a UTF-8 encoded string
fn GetCodepoint(string text, i32 *codepointSize)                @alias(rl::get_codepoint)           -> i32;              // Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
