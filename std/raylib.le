fn DrawRectangle(i32 posX, i32 posY, i32 width, i32 height, Color color)                                @alias(rl::draw_rectangle);                         // Draw a color-filled rectangle
fn DrawRectangleV(Vector2 position, Vector2 size, Color color)                                          @alias(rl::draw_rectangle_v);                       // Draw a color-filled rectangle (Vector version)
fn DrawRectangleRec(Rectangle rec, Color color)                                                         @alias(rl::draw_rectangle_rec);                     // Draw a color-filled rectangle
fn DrawRectanglePro(Rectangle rec, Vector2 origin, f32 rotation, Color color)                           @alias(rl::draw_rectangle_pro);                     // Draw a color-filled rectangle with pro parameters
fn DrawRectangleGradientV(i32 posX, i32 posY, i32 width, i32 height, Color color1, Color color2)        @alias(rl::draw_rectangle_gradient_v);              // Draw a vertical-gradient-filled rectangle
fn DrawRectangleGradientH(i32 posX, i32 posY, i32 width, i32 height, Color color1, Color color2)        @alias(rl::draw_rectangle_gradient_h);              // Draw a horizontal-gradient-filled rectangle
fn DrawRectangleGradientEx(Rectangle rec, Color col1, Color col2, Color col3, Color col4)               @alias(rl::draw_rectangle_gradient_ex);             // Draw a gradient-filled rectangle with custom vertex colors
fn DrawRectangleLines(i32 posX, i32 posY, i32 width, i32 height, Color color)                           @alias(rl::draw_rectangle_lines);                   // Draw rectangle outline
fn DrawRectangleLinesEx(Rectangle rec, f32 lineThick, Color color)                                      @alias(rl::draw_rectangle_lines_ex);                // Draw rectangle outline with extended parameters
fn DrawRectangleRounded(Rectangle rec, f32 roundness, i32 segments, Color color)                        @alias(rl::draw_rectangle_rounded);                 // Draw rectangle with rounded edges
fn DrawRectangleRoundedLines(Rectangle rec, f32 roundness, i32 segments, f32 lineThick, Color color)    @alias(rl::draw_rectangle_rounded_lines);           // Draw rectangle with rounded edges outline
