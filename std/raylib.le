fn ExportImageToMemory(Image image, string fileType, i32 *fileSize)                         @alias(rl::export_image_to_memory)    -> u8 *;      // Export image to memory buffer
fn ExportImageAsCode(Image image, string fileName)                                          @alias(rl::export_image_as_code)      -> bool;      // Export image as code file defining an array of bytes, returns true on success

// Image generation functions
