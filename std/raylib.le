fn LoadImageFromMemory(string fileType, u8 *fileData, i32 dataSize)                         @alias(rl::load_image_from_memory)    -> Image;     // Load image from memory buffer, fileType refers to extension: i.e. '.png'
fn LoadImageFromTexture(Texture texture)                                                  @alias(rl::load_image_from_texture)   -> Image;     // Load image from GPU texture data
fn LoadImageFromScreen()                                                                    @alias(rl::load_image_from_screen)    -> Image;     // Load image from screen buffer and (screenshot)
fn IsImageReady(Image image)                                                                @alias(rl::is_image_ready)            -> bool;      // Check if an image is ready
fn UnloadImage(Image image)                                                                 @alias(rl::unload_image);                           // Unload image from CPU memory (RAM)
