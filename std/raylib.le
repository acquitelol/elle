fn DrawLineEx(Vector2 startPos, Vector2 endPos, f32 thick, Color color)                                 @alias(rl::draw_line_ex);                           // Draw a line (using triangles/quads)
fn DrawLineStrip(Vector2 *points, i32 pointCount, Color color)                                          @alias(rl::draw_line_strip);                        // Draw lines sequence (using gl lines)
fn DrawLineBezier(Vector2 startPos, Vector2 endPos, i32 thick, Color color)                             @alias(rl::draw_line_bezier);                       // Draw line segment cubic-bezier in-out interpolation
