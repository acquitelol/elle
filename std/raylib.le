// Splines drawing functions
fn DrawSplineLinear(Vector2 *points, i32 pointCount, f32 thick, Color color)                            @alias(rl::draw_spline_linear);                     // Draw spline: Linear, minimum 2 points
fn DrawSplineBasis(Vector2 *points, i32 pointCount, f32 thick, Color color)                             @alias(rl::draw_line_basis);                        // Draw spline: B-Spline, minimum 4 points
fn DrawSplineCatmullRom(Vector2 *points, i32 pointCount, f32 thick, Color color)                        @alias(rl::draw_spline_catmull_rom);                // Draw spline: Catmull-Rom, minimum 4 points
fn DrawSplineBezierQuadratic(Vector2 *points, i32 pointCount, f32 thick, Color color)                   @alias(rl::draw_spline_bezier_quadratic);           // Draw spline: Quadratic Bezier, minimum 3 points (1 control point): [p1, c2, p3, c4...]
fn DrawSplineBezierCubic(Vector2 *points, i32 pointCount, f32 thick, Color color)                       @alias(rl::draw_spline_bezier_cubic);               // Draw spline: Cubic Bezier, minimum 4 points (2 control points): [p1, c2, c3, p4, c5, c6...]
fn DrawSplineSegmentLinear(Vector2 p1, Vector2 p2, f32 thick, Color color)                              @alias(rl::draw_spline_segment_linear);             // Draw spline segment: Linear, 2 points
fn DrawSplineSegmentBasis(Vector2 p1, Vector2 p2, Vector2 p3, Vector2 p4, f32 thick, Color color)       @alias(rl::draw_spline_segment_basis);              // Draw spline segment: B-Spline, 4 points
fn DrawSplineSegmentCatmullRom(Vector2 p1, Vector2 p2, Vector2 p3, Vector2 p4, f32 thick, Color color)  @alias(rl::draw_spline_segment_catmull_rom);        // Draw spline segment: Catmull-Rom, 4 points
fn DrawSplineSegmentBezierQuadratic(Vector2 p1, Vector2 c2, Vector2 p3, f32 thick, Color color)         @alias(rl::draw_spline_segment_bezier_quadratic);   // Draw spline segment: Quadratic Bezier, 2 points, 1 control point
fn DrawSplineSegmentBezierCubic(Vector2 p1, Vector2 c2, Vector2 c3, Vector2 p4, f32 thick, Color color) @alias(rl::draw_spline_segment_bezier_cubic);       // Draw spline segment: Cubic Bezier, 2 points, 2 control points

// Spline segment point evaluation functions, for a given t [0.0f .. 1.0f]
fn GetSplinePointLinear(Vector2 startPos, Vector2 endPos, f32 t)                     @alias(rl::get_spline_point_linear)        -> Vector2;     // Get (evaluate) spline point: Linear
fn GetSplinePointBasis(Vector2 p1, Vector2 p2, Vector2 p3, Vector2 p4, f32 t)        @alias(rl::get_spline_point_basis)         -> Vector2;     // Get (evaluate) spline point: B-Spline
fn GetSplinePointCatmullRom(Vector2 p1, Vector2 p2, Vector2 p3, Vector2 p4, f32 t)   @alias(rl::get_spline_point_catmull_rom)   -> Vector2;     // Get (evaluate) spline point: Catmull-Rom
fn GetSplinePointBezierQuad(Vector2 p1, Vector2 c2, Vector2 p3, f32 t)               @alias(rl::get_spline_point_bezier_quad)   -> Vector2;     // Get (evaluate) spline point: Quadratic Bezier
fn GetSplinePointBezierCubic(Vector2 p1, Vector2 c2, Vector2 c3, Vector2 p4, f32 t)  @alias(rl::get_spline_point_bezier_cubic)  -> Vector2;     // Get (evaluate) spline point: Cubic Bezier

// Basic shapes collision detection functions
fn CheckCollisionRecs(Rectangle rec1, Rectangle rec2)                                @alias(rl::check_collision_recs)           -> bool;        // Check collision between two rectangles
fn CheckCollisionCircles(Vector2 center1, f32 radius1, Vector2 center2, f32 radius2) @alias(rl::check_collision_circles)        -> bool;        // Check collision between two circles
fn CheckCollisionCircleRec(Vector2 center, f32 radius, Rectangle rec)                @alias(rl::check_collision_circle_rec)     -> bool;        // Check collision between circle and rectangle
fn CheckCollisionPointRec(Vector2 point, Rectangle rec)                              @alias(rl::check_collision_point_rec)      -> bool;        // Check if point is inside rectangle
fn CheckCollisionPointCircle(Vector2 point, Vector2 center, f32 radius)              @alias(rl::check_collision_point_circle)   -> bool;        // Check if point is inside circle
fn CheckCollisionPointTriangle(Vector2 point, Vector2 p1, Vector2 p2, Vector2 p3)    @alias(rl::check_collision_point_triangle) -> bool;        // Check if point is inside a triangle
fn CheckCollisionPointPoly(Vector2 point, Vector2 *points, i32 pointCount)           @alias(rl::check_collision_point_poly)     -> bool;        // Check if point is within a polygon described by array of vertices
fn CheckCollisionLines(Vector2 startPos1, Vector2 endPos1, Vector2 startPos2, Vector2 endPos2, Vector2 *collisionPoint) @alias(rl::check_collision_lines) -> bool; // Check the collision between two lines defined by two points each, returns collision point by reference
fn CheckCollisionPointLine(Vector2 point, Vector2 p1, Vector2 p2, i32 threshold)     @alias(rl::check_collision_point_line)     -> bool;        // Check if point belongs to line created between two points [p1] and [p2] with defined margin in pixels [threshold]
fn GetCollisionRec(Rectangle rec1, Rectangle rec2)                                   @alias(rl::get_collision_rec)              -> Rectangle;   // Get collision rectangle for two rectangles collision

// raylib's implementation is faulty for the y axis
!external fn rl::elle_check_collision_point_rec(Vector2 point, Rectangle rec) {
    return point.x >= rec.x &&
        point.x <= rec.x + rec.width &&
        point.y >= rec.y &&
        point.y <= rec.y + rec.height;
}

