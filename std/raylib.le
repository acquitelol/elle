fn GetTouchY()                                      @alias(rl::get_touch_y)                -> i32;     // Get touch position Y for touch point 0 (relative to screen size)
fn GetTouchPosition(i32 index)                      @alias(rl::get_touch_position)         -> Vector2; // Get touch position XY for a touch point index (relative to screen size)
fn GetTouchPointId(i32 index)                       @alias(rl::get_touch_point_id)         -> i32;     // Get touch point identifier for given index
fn GetTouchPointCount()                             @alias(rl::get_touch_point_count)      -> i32;     // Get number of touch points

