fn GenImageGradientLinear(i32 width, i32 height, i32 direction, Color start, Color end)     @alias(rl::gen_image_gradient_linear) -> Image;     // Generate image: linear gradient, direction in degrees [0..360], 0=Vertical gradient
fn GenImageGradientRadial(i32 width, i32 height, f32 density, Color inner, Color outer)     @alias(rl::gen_image_gradient_radial) -> Image;     // Generate image: radial gradient
fn GenImageGradientSquare(i32 width, i32 height, f32 density, Color inner, Color outer)     @alias(rl::gen_image_gradient_square) -> Image;     // Generate image: square gradient
