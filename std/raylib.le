fn DrawSphereEx(Vector3 centerPos, f32 radius, i32 rings, i32 slices, Color color)    @alias(rl::draw_sphere_ex);         // Draw sphere with extended parameters
fn DrawSphereWires(Vector3 centerPos, f32 radius, i32 rings, i32 slices, Color color) @alias(rl::draw_sphere_wires);      // Draw sphere wires
fn DrawCylinder(Vector3 position, f32 radiusTop, f32 radiusBottom, f32 height, i32 slices, Color color)          @alias(rl::draw_cylinder);          // Draw a cylinder/cone
fn DrawCylinderEx(Vector3 startPos, Vector3 endPos, f32 startRadius, f32 endRadius, i32 sides, Color color)      @alias(rl::draw_cylinder_ex);       // Draw a cylinder with base at startPos and top at endPos
fn DrawCylinderWires(Vector3 position, f32 radiusTop, f32 radiusBottom, f32 height, i32 slices, Color color)     @alias(rl::draw_cylinder_wires);    // Draw a cylinder/cone wires
fn DrawCylinderWiresEx(Vector3 startPos, Vector3 endPos, f32 startRadius, f32 endRadius, i32 sides, Color color) @alias(rl::draw_cylinder_wires_ex); // Draw a cylinder wires with base at startPos and top at endPos
fn DrawCapsule(Vector3 startPos, Vector3 endPos, f32 radius, i32 slices, i32 rings, Color color)                 @alias(rl::draw_capsule);           // Draw a capsule with the center of its sphere caps at startPos and endPos
fn DrawCapsuleWires(Vector3 startPos, Vector3 endPos, f32 radius, i32 slices, i32 rings, Color color)            @alias(rl::draw_capsule_wires);     // Draw capsule wireframe with the center of its sphere caps at startPos and endPos
fn DrawPlane(Vector3 centerPos, Vector2 size, Color color)                            @alias(rl::draw_plane);             // Draw a plane XZ
fn DrawRay(Ray ray, Color color)                                                      @alias(rl::draw_ray);               // Draw a ray line
fn DrawGrid(i32 slices, f32 spacing)                                                  @alias(rl::draw_grid);              // Draw a grid (centered at (0, 0, 0))

//------------------------------------------------------------------------------------
// Model 3d Loading and Drawing Functions (Module: models)
//------------------------------------------------------------------------------------

// Model management functions
fn LoadModel(string fileName)       @alias(rl::load_model)             -> Model;       // Load model from files (meshes and materials)
fn LoadModelFromMesh(Mesh mesh)     @alias(rl::load_model_from_mesh)   -> Model;       // Load model from generated mesh (default material)
fn IsModelReady(Model model)        @alias(rl::is_model_ready)         -> bool;        // Check if a model is ready
fn UnloadModel(Model model)         @alias(rl::unload_model);                          // Unload model (including meshes) from memory (RAM and/or VRAM)
fn GetModelBoundingBox(Model model) @alias(rl::get_model_bounding_box) -> BoundingBox; // Compute model bounding box limits (considers all meshes)

// Model drawing functions
fn DrawModel(Model model, Vector3 position, f32 scale, Color tint)                                                     @alias(rl::draw_model);          // Draw a model (with texture if set)
fn DrawModelEx(Model model, Vector3 position, Vector3 rotationAxis, f32 rotationAngle, Vector3 scale, Color tint)      @alias(rl::draw_model_ex);       // Draw a model with extended parameters
fn DrawModelWires(Model model, Vector3 position, f32 scale, Color tint)                                                @alias(rl::draw_model_wires);    // Draw a model wires (with texture if set)
fn DrawModelWiresEx(Model model, Vector3 position, Vector3 rotationAxis, f32 rotationAngle, Vector3 scale, Color tint) @alias(rl::draw_model_wires_ex); // Draw a model wires (with texture if set) with extended parameters
fn DrawBoundingBox(BoundingBox box, Color color)                                                                       @alias(rl::draw_bounding_box);   // Draw bounding box (wires)
fn DrawBillboard(Camera camera, Texture texture, Vector3 position, f32 size, Color tint)                             @alias(rl::draw_billboard);      // Draw a billboard texture
fn DrawBillboardRec(Camera camera, Texture texture, Rectangle source, Vector3 position, Vector2 size, Color tint)    @alias(rl::draw_billboard_rec);  // Draw a billboard texture defined by source
fn DrawBillboardPro(Camera camera, Texture texture, Rectangle source, Vector3 position, Vector3 up, Vector2 size, Vector2 origin, f32 rotation, Color tint)
    @alias(rl::draw_billboard_pro); // Draw a billboard texture defined by source and rotation

// Mesh management functions
fn UploadMesh(Mesh *mesh, bool dynamic)                                               @alias(rl::upload_mesh);                          // Upload mesh vertex data in GPU and provide VAO/VBO ids
fn UpdateMeshBuffer(Mesh mesh, i32 index, void *data, i32 dataSize, i32 offset)       @alias(rl::upload_mesh_buffer);                   // Update mesh vertex data in GPU for a specific buffer index
fn UnloadMesh(Mesh mesh)                                                              @alias(rl::unload_mesh);                          // Unload mesh data from CPU and GPU
fn DrawMesh(Mesh mesh, Material material, Matrix transform)                           @alias(rl::draw_mesh);                            // Draw a 3d mesh with material and transform
fn DrawMeshInstanced(Mesh mesh, Material material, Matrix *transforms, i32 instances) @alias(rl::draw_mesh_instanced);                  // Draw multiple mesh instances with material and different transforms
fn ExportMesh(Mesh mesh, string fileName)                                             @alias(rl::export_mesh)           -> bool;        // Export mesh data to file, returns true on success
fn GetMeshBoundingBox(Mesh mesh)                                                      @alias(rl::get_mesh_bounding_box) -> BoundingBox; // Compute mesh bounding box limits
fn GenMeshTangents(Mesh *mesh)                                                        @alias(rl::gen_mesh_tangents);                    // Compute mesh tangents

// Mesh generation functions
fn GenMeshPoly(i32 sides, f32 radius)                        @alias(rl::gen_mesh_poly)         -> Mesh;             // Generate polygonal mesh
fn GenMeshPlane(f32 width, f32 length, i32 resX, i32 resZ)   @alias(rl::gen_mesh_plane)        -> Mesh;             // Generate plane mesh (with subdivisions)
fn GenMeshCube(f32 width, f32 height, f32 length)            @alias(rl::gen_mesh_cube)         -> Mesh;             // Generate cuboid mesh
fn GenMeshSphere(f32 radius, i32 rings, i32 slices)          @alias(rl::gen_mesh_sphere)       -> Mesh;             // Generate sphere mesh (standard sphere)
fn GenMeshHemiSphere(f32 radius, i32 rings, i32 slices)      @alias(rl::gen_mesh_hemisphere)   -> Mesh;             // Generate half-sphere mesh (no bottom cap)
fn GenMeshCylinder(f32 radius, f32 height, i32 slices)       @alias(rl::gen_mesh_cylinder)     -> Mesh;             // Generate cylinder mesh
fn GenMeshCone(f32 radius, f32 height, i32 slices)           @alias(rl::gen_mesh_cone)         -> Mesh;             // Generate cone/pyramid mesh
fn GenMeshTorus(f32 radius, f32 size, i32 radSeg, i32 sides) @alias(rl::gen_mesh_torus)        -> Mesh;             // Generate torus mesh
fn GenMeshKnot(f32 radius, f32 size, i32 radSeg, i32 sides)  @alias(rl::gen_mesh_knot)         -> Mesh;             // Generate trefoil knot mesh
fn GenMeshHeightmap(Image heightmap, Vector3 size)           @alias(rl::gen_mesh_heightmap)    -> Mesh;             // Generate heightmap mesh from image data
fn GenMeshCubicmap(Image cubicmap, Vector3 cubeSize)         @alias(rl::gen_mesh_cubicmap)     -> Mesh;             // Generate cubes-based map mesh from image data

// Material loading/unloading functions
fn LoadMaterials(string fileName, i32 *materialCount)        @alias(rl::load_materials)        -> Material *;       // Load materials from model file
fn LoadMaterialDefault()                                     @alias(rl::load_material_default) -> Material;         // Load default material (Supports: DIFFUSE, SPECULAR, NORMAL maps)
fn IsMaterialReady(Material material)                        @alias(rl::is_material_ready)     -> bool;             // Check if a material is ready
fn UnloadMaterial(Material material)                         @alias(rl::unload_material);                           // Unload material from GPU memory (VRAM)
fn SetMaterialTexture(Material *material, i32 mapType, Texture texture) @alias(rl::set_material_texture);           // Set texture for a material map type (MATERIAL_MAP_DIFFUSE, MATERIAL_MAP_SPECULAR...)
fn SetModelMeshMaterial(Model *model, i32 meshId, i32 materialId)         @alias(rl::set_model_mesh_material);      // Set material for a mesh

// Model animations loading/unloading functions
fn LoadModelAnimations(string fileName, i32 *animCount)      @alias(rl::load_model_animations) -> ModelAnimation *; // Load model animations from file
fn UpdateModelAnimation(Model model, ModelAnimation anim, i32 frame)      @alias(rl::update_model_animation);       // Update model animation pose
fn UnloadModelAnimation(ModelAnimation anim)                              @alias(rl::unload_model_animation);       // Unload animation data
fn UnloadModelAnimations(ModelAnimation *animations, i32 animCount)       @alias(rl::unload_model_animations);      // Unload animation array data
fn IsModelAnimationValid(Model model, ModelAnimation anim)   @alias(rl::is_model_animation_valid) -> bool;          // Check model animation skeleton match

// Collision detection functions
fn CheckCollisionSpheres(Vector3 center1, f32 radius1, Vector3 center2, f32 radius2) @alias(rl::check_collision_spheres)    -> bool;         // Check collision between two spheres
fn CheckCollisionBoxes(BoundingBox box1, BoundingBox box2)                           @alias(rl::check_collision_boxes)      -> bool;         // Check collision between two bounding boxes
fn CheckCollisionBoxSphere(BoundingBox box, Vector3 center, f32 radius)              @alias(rl::check_collision_box_sphere) -> bool;         // Check collision between box and sphere
fn GetRayCollisionSphere(Ray ray, Vector3 center, f32 radius)                        @alias(rl::get_ray_collision_sphere)   -> RayCollision; // Get collision info between ray and sphere
fn GetRayCollisionBox(Ray ray, BoundingBox box)                                      @alias(rl::get_ray_collision_box)      -> RayCollision; // Get collision info between ray and box
fn GetRayCollisionMesh(Ray ray, Mesh mesh, Matrix transform)                         @alias(rl::get_ray_collision_mesh)     -> RayCollision; // Get collision info between ray and mesh
fn GetRayCollisionTriangle(Ray ray, Vector3 p1, Vector3 p2, Vector3 p3)              @alias(rl::get_ray_collision_triangle) -> RayCollision; // Get collision info between ray and triangle
fn GetRayCollisionQuad(Ray ray, Vector3 p1, Vector3 p2, Vector3 p3, Vector3 p4)      @alias(rl::get_ray_collision_quad)     -> RayCollision; // Get collision info between ray and quad

//------------------------------------------------------------------------------------
// Audio Loading and Playing Functions (Module: audio)
//------------------------------------------------------------------------------------
// typedef void (*AudioCallback)(void *bufferData, unsigned int frames);

// Audio device management functions
fn InitAudioDevice()                                                 @alias(rl::init_audio_device);              // Initialize audio device and context
fn CloseAudioDevice()                                                @alias(rl::close_audio_device);             // Close the audio device and context
fn IsAudioDeviceReady()                                              @alias(rl::is_audio_device_ready) -> bool;  // Check if audio device has been initialized successfully
fn SetMasterVolume(f32 volume)                                       @alias(rl::set_master_volume);              // Set master volume (listener)
fn GetMasterVolume()                                                 @alias(rl::get_master_volume)     -> f32;   // Get master volume (listener)

// Wave/Sound loading/unloading functions
fn LoadWave(string fileName)                                         @alias(rl::load_wave)             -> Wave;  // Load wave data from file
fn LoadWaveFromMemory(string fileType, u8 *fileData, i32 dataSize)   @alias(rl::load_wave_from_memory) -> Wave;  // Load wave from memory buffer, fileType refers to extension: i.e. '.wav'
fn IsWaveReady(Wave wave)                                            @alias(rl::is_wave_ready)         -> bool;  // Checks if wave data is ready
fn LoadSound(string fileName)                                        @alias(rl::load_sound)            -> Sound; // Load sound from file
fn LoadSoundFromWave(Wave wave)                                      @alias(rl::load_sound_from_wave)  -> Sound; // Load sound from wave data
fn LoadSoundAlias(Sound source)                                      @alias(rl::load_sound_alias)      -> Sound; // Create a new sound that shares the same sample data as the source sound, does not own the sound data
fn IsSoundReady(Sound sound)                                         @alias(rl::is_sound_ready)        -> bool;  // Checks if a sound is ready
fn UpdateSound(Sound sound, void *data, i32 sampleCount)             @alias(rl::update_sound);                   // Update sound buffer with new data
fn UnloadWave(Wave wave)                                             @alias(rl::unload_wave);                    // Unload wave data
fn UnloadSound(Sound sound)                                          @alias(rl::unload_sound);                   // Unload sound
fn UnloadSoundAlias(Sound alias)                                     @alias(rl::unload_sound_alias);             // Unload a sound alias (does not deallocate sample data)
fn ExportWave(Wave wave, string fileName)                            @alias(rl::export_wave)           -> bool;  // Export wave data to file, returns true on success
fn ExportWaveAsCode(Wave wave, string fileName)                      @alias(rl::export_wave_as_code)   -> bool;  // Export wave sample data to code (.h), returns true on success

// Wave/Sound management functions
fn PlaySound(Sound sound)                                            @alias(rl::play_sound);                     // Play a sound
fn StopSound(Sound sound)                                            @alias(rl::stop_sound);                     // Stop playing a sound
fn PauseSound(Sound sound)                                           @alias(rl::pause_sound);                    // Pause a sound
fn ResumeSound(Sound sound)                                          @alias(rl::resume_sound);                   // Resume a paused sound
fn IsSoundPlaying(Sound sound)                                       @alias(rl::is_sound_playing)      -> bool;  // Check if a sound is currently playing
fn SetSoundVolume(Sound sound, f32 volume)                           @alias(rl::set_sound_volume);               // Set volume for a sound (1.0 is max level)
fn SetSoundPitch(Sound sound, f32 pitch)                             @alias(rl::set_sound_pitch);                // Set pitch for a sound (1.0 is base level)
fn SetSoundPan(Sound sound, f32 pan)                                 @alias(rl::set_sound_pan);                  // Set pan for a sound (0.5 is center)
fn WaveCopy(Wave wave)                                               @alias(rl::wave_copy)             -> Wave;  // Copy a wave to a new wave
fn WaveCrop(Wave *wave, i32 initSample, i32 finalSample)             @alias(rl::wave_crop);                      // Crop a wave to defined samples range
fn WaveFormat(Wave *wave, i32 sampleRate, i32 sampleSize, i32 channels) @alias(rl::wave_format);               // Convert wave data to desired format
fn LoadWaveSamples(Wave wave)                                        @alias(rl::load_wave_samples)     -> f32 *; // Load samples data from wave as a 32bit float data array
fn UnloadWaveSamples(f32 *samples)                                   @alias(rl::unload_wave_samples);            // Unload samples data loaded with LoadWaveSamples()

// Music management functions
fn LoadMusicStream(string fileName)                                  @alias(rl::load_music_stream)             -> Music;      // Load music stream from file
fn LoadMusicStreamFromMemory(string fileType, u8 *data, i32 size)    @alias(rl::load_music_stream_from_memory) -> Music;      // Load music stream from data
fn IsMusicReady(Music music)                                         @alias(rl::is_music_ready)                -> bool;       // Checks if a music stream is ready
fn UnloadMusicStream(Music music)                                    @alias(rl::unload_music_stream);                         // Unload music stream
fn PlayMusicStream(Music music)                                      @alias(rl::play_music_stream);                           // Start music playing
fn IsMusicStreamPlaying(Music music)                                 @alias(rl::is_music_stream_playing)       -> bool;       // Check if music is playing
fn UpdateMusicStream(Music music)                                    @alias(rl::update_music_stream);                         // Updates buffers for music streaming
fn StopMusicStream(Music music)                                      @alias(rl::stop_music_stream);                           // Stop music playing
fn PauseMusicStream(Music music)                                     @alias(rl::pause_music_stream);                          // Pause music playing
fn ResumeMusicStream(Music music)                                    @alias(rl::resume_music_stream);                         // Resume playing paused music
fn SeekMusicStream(Music music, f32 position)                        @alias(rl::seek_music_stream);                           // Seek music to a position (in seconds)
fn SetMusicVolume(Music music, f32 volume)                           @alias(rl::set_music_volume);                            // Set volume for music (1.0 is max level)
fn SetMusicPitch(Music music, f32 pitch)                             @alias(rl::set_music_pitch);                             // Set pitch for a music (1.0 is base level)
fn SetMusicPan(Music music, f32 pan)                                 @alias(rl::set_music_pan);                               // Set pan for a music (0.5 is center)
fn GetMusicTimeLength(Music music)                                   @alias(rl::get_music_time_length)         -> f32;        // Get music time length (in seconds)
fn GetMusicTimePlayed(Music music)                                   @alias(rl::get_music_time_played)         -> f32;        // Get current music time played (in seconds)

// AudioStream management functions
fn LoadAudioStream(u32 sampleRate, u32 sampleSize, u32 channels)     @alias(rl::load_audio_stream)            -> AudioStream; // Load audio stream (to stream raw audio pcm data)
fn IsAudioStreamReady(AudioStream stream)                            @alias(rl::is_audio_stream_ready)        -> bool;        // Checks if an audio stream is ready
fn UnloadAudioStream(AudioStream stream)                             @alias(rl::unload_audio_stream);                         // Unload audio stream and free memory
fn UpdateAudioStream(AudioStream stream, void *data, i32 frameCount) @alias(rl::update_audio_stream);                         // Update audio stream buffers with data
fn IsAudioStreamProcessed(AudioStream stream)                        @alias(rl::is_audio_stream_processed)    -> bool;        // Check if any audio stream buffers requires refill
fn PlayAudioStream(AudioStream stream)                               @alias(rl::play_audio_stream);                           // Play audio stream
fn PauseAudioStream(AudioStream stream)                              @alias(rl::pause_audio_stream);                          // Pause audio stream
fn ResumeAudioStream(AudioStream stream)                             @alias(rl::resume_audio_stream);                         // Resume audio stream
fn IsAudioStreamPlaying(AudioStream stream)                          @alias(rl::is_audio_stream_playing)      -> bool;        // Check if audio stream is playing
fn StopAudioStream(AudioStream stream)                               @alias(rl::stop_audio_stream);                           // Stop audio stream
fn SetAudioStreamVolume(AudioStream stream, f32 volume)              @alias(rl::set_audio_stream_volume);                     // Set volume for audio stream (1.0 is max level)
fn SetAudioStreamPitch(AudioStream stream, f32 pitch)                @alias(rl::set_audio_stream_pitch);                      // Set pitch for audio stream (1.0 is base level)
fn SetAudioStreamPan(AudioStream stream, f32 pan)                    @alias(rl::set_audio_stream_pan);                        // Set pan for audio stream (0.5 is centered)
fn SetAudioStreamBufferSizeDefault(i32 size)                         @alias(rl::set_audio_stream_buffer_size_default);        // Default size for new audio streams
fn SetAudioStreamCallback(AudioStream stream, fn(void *, u32) callback)          @alias(rl::set_audio_stream_callback);                   // Audio thread callback to request new data

fn AttachAudioStreamProcessor(AudioStream stream, fn(void *, u32) processor)     @alias(rl::attach_audio_stream_processor);               // Attach audio stream processor to stream, receives the samples as <float>s
fn DetachAudioStreamProcessor(AudioStream stream, fn(void *, u32) processor)     @alias(rl::detach_audio_stream_processor);               // Detach audio stream processor from stream

fn AttachAudioMixedProcessor(fn(void *, u32) processor)                          @alias(rl::attach_audio_mixed_processor);                // Attach audio stream processor to the entire audio pipeline, receives the samples as <float>s
fn DetachAudioMixedProcessor(fn(void *, u32) processor)                          @alias(rl::detach_audio_mixed_processor);                // Detach audio stream processor from the entire audio pipeline
