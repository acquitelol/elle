fn DrawEllipseLines(i32 centerX, i32 centerY, f32 radiusH, f32 radiusV, Color color)                    @alias(rl::draw_ellipse_lines);                     // Draw ellipse outline
fn DrawRing(Vector2 center, f32 innerRadius, f32 outerRadius, f32 startAngle, f32 endAngle, i32 segments, Color color)      @alias(rl::draw_ring);       // Draw ring
