use std/math;
use std/vectors;

global pub, external;

//----------------------------------------------------------------------------------
// Some basic Defines
//----------------------------------------------------------------------------------
const DEG2RAD = PI / 180.0;
const RAD2DEG = 180.0 / PI;

// Some Basic Colors
// NOTE: Custom raylib color palette for amazing visuals on WHITE background
const LIGHTGRAY  = Color { r = 200, g = 200, b = 200, a = 255 };
const GRAY       = Color { r = 130, g = 130, b = 130, a = 255 };
const DARKGRAY   = Color { r = 80,  g = 80,  b = 80,  a = 255 };
const YELLOW     = Color { r = 253, g = 249, b = 0,   a = 255 };
const GOLD       = Color { r = 255, g = 203, b = 0,   a = 255 };
const ORANGE     = Color { r = 255, g = 161, b = 0,   a = 255 };
const PINK       = Color { r = 255, g = 109, b = 194, a = 255 };
const RED        = Color { r = 230, g = 41,  b = 55,  a = 255 };
const MAROON     = Color { r = 190, g = 33,  b = 55,  a = 255 };
const GREEN      = Color { r = 0,   g = 228, b = 48,  a = 255 };
const LIME       = Color { r = 0,   g = 158, b = 47,  a = 255 };
const DARKGREEN  = Color { r = 0,   g = 117, b = 44,  a = 255 };
const SKYBLUE    = Color { r = 102, g = 191, b = 255, a = 255 };
const BLUE       = Color { r = 0,   g = 121, b = 241, a = 255 };
const DARKBLUE   = Color { r = 0,   g = 82,  b = 172, a = 255 };
const PURPLE     = Color { r = 200, g = 122, b = 255, a = 255 };
const VIOLET     = Color { r = 135, g = 60,  b = 190, a = 255 };
const DARKPURPLE = Color { r = 112, g = 31,  b = 126, a = 255 };
const BEIGE      = Color { r = 211, g = 176, b = 131, a = 255 };
const BROWN      = Color { r = 127, g = 106, b = 79,  a = 255 };
const DARKBROWN  = Color { r = 76,  g = 63,  b = 47,  a = 255 };

const WHITE      = Color { r = 255, g = 255, b = 255, a = 255 };
const BLACK      = Color { r = 0,   g = 0,   b = 0,   a = 255 };
const BLANK      = Color { r = 0,   g = 0,   b = 0,   a = 0   };
const MAGENTA    = Color { r = 255, g = 0,   b = 255, a = 255 };
const RAYWHITE   = Color { r = 245, g = 245, b = 245, a = 255 };

//----------------------------------------------------------------------------------
// Structures Definition
//----------------------------------------------------------------------------------

// Matrix, 4x4 components, column major, OpenGL style, right-handed
struct Matrix {
    f32 m0, f32 m4, f32 m8, f32 m12,  // Matrix first row (4 components)
    f32 m1, f32 m5, f32 m9, f32 m13,  // Matrix second row (4 components)
    f32 m2, f32 m6, f32 m10, f32 m14, // Matrix third row (4 components)
    f32 m3, f32 m7, f32 m11, f32 m15, // Matrix fourth row (4 components)
}

// NOTE:
// Vector2 and Vector3 are already an Elle feature, they come from std/vectors;

// Vector4, 4 components
struct Vector4 {
    f32 x,                  // Vector x component
    f32 y,                  // Vector y component
    f32 z,                  // Vector z component
    f32 w,                  // Vector x component
}

// Quaternion, 4 components
// Elle doesn't have typedef aliases
struct Quaternion {
    f32 x,                  // Vector x component
    f32 y,                  // Vector y component
    f32 z,                  // Vector z component
    f32 w,                  // Vector x component
}

// Color, 4 components, R8G8B8A8 (32bit)
struct Color {
    u8 r,                   // Color red value
    u8 g,                   // Color green value
    u8 b,                   // Color blue value
    u8 a,                   // Color alpha value
}

// Rectangle, 4 components
struct Rectangle {
    f32 x,                  // Rectangle top-left corner position x
    f32 y,                  // Rectangle top-left corner position y
    f32 width,              // Rectangle width
    f32 height,             // Rectangle top-left corner position x
}

// Image, pixel data stored in CPU memory (RAM)
struct Image {
    void *data,             // Image raw data
    i32 width,              // Image base width
    i32 height,             // Image base height
    i32 mipmaps,            // Mipmap levels, 1 by default
    i32 format,             // Data format (PixelFormat type)
}

// Texture, tex data stored in GPU memory (VRAM)
struct Texture {
    u32 id,                 // OpenGL texture id
    i32 width,              // Image base width
    i32 height,             // Image base height
    i32 mipmaps,            // Mipmap levels, 1 by default
    i32 format,             // Data format (PixelFormat type)
}

// TextureCubemap, same as Texture
struct TextureCubemap {
    u32 id,                 // OpenGL texture id
    i32 width,              // Image base width
    i32 height,             // Image base height
    i32 mipmaps,            // Mipmap levels, 1 by default
    i32 format,             // Data format (PixelFormat type)
}

// RenderTexture, fbo for texture rendering
struct RenderTexture {
    u32 id,                 // OpenGL framebuffer object id
    Texture texture,        // Color buffer attachment texture
    Texture depth,          // Depth buffer attachment texture
}

// RenderTexture2D, same as RenderTexture
struct RenderTexture2D {
    u32 id,                 // OpenGL framebuffer object id
    Texture texture,        // Color buffer attachment texture
    Texture depth,          // Depth buffer attachment texture
}

// NPatchInfo, n-patch layout info
struct NPatchInfo {
    Rectangle source,       // Texture source rectangle
    i32 left,               // Left border offset
    i32 top,                // Top border offset
    i32 right,              // Right border offset
    i32 bottom,             // Bottom border offset
    i32 layout,             // Layout of the n-patch: 3x3, 1x3 or 3x1
}

// GlyphInfo, font characters glyphs info
struct GlyphInfo {
    i32 value,              // Character value (Unicode)
    i32 offsetX,            // Character offset X when drawing
    i32 offsetY,            // Character offset Y when drawing
    i32 advanceX,           // Character advance position X
    Image image,            // Character image data
}

// Font, font texture and GlyphInfo array data
struct Font {
    i32 baseSize,           // Base size (default chars height)
    i32 glyphCount,         // Number of glyph characters
    i32 glyphPadding,       // Padding around the glyph characters
    Texture texture,      // Texture atlas containing the glyphs
    Rectangle *recs,        // Rectangles in texture for the glyphs
    GlyphInfo *glyphs,      // Glyphs info data
}

// Camera, defines position/orientation in 3d space
struct Camera3D {
    Vector3 position,       // Camera position
    Vector3 target,         // Camera target it looks-at
    Vector3 up,             // Camera up vector (rotation over its axis)
    f32 fovy,               // Camera field-of-view aperture in Y (degrees) in perspective, used as near plane width in orthographic
    i32 projection,         // Camera projection: CAMERA_PERSPECTIVE or CAMERA_ORTHOGRAPHIC
}

// Camera type fallback, defaults to Camera3D
struct Camera {
    Vector3 position,       // Camera position
    Vector3 target,         // Camera target it looks-at
    Vector3 up,             // Camera up vector (rotation over its axis)
    f32 fovy,               // Camera field-of-view aperture in Y (degrees) in perspective, used as near plane width in orthographic
    i32 projection,         // Camera projection: CAMERA_PERSPECTIVE or CAMERA_ORTHOGRAPHIC
}

// Camera2D, defines position/orientation in 2d space
struct Camera2D {
    Vector2 offset,         // Camera offset (displacement from target)
    Vector2 target,         // Camera target (rotation and zoom origin)
    f32 rotation,           // Camera rotation in degrees
    f32 zoom,               // Camera zoom (scaling), should be 1.0f by default
}

// Mesh, vertex data and vao/vbo
struct Mesh {
    i32 vertexCount,        // Number of vertices stored in arrays
    i32 triangleCount,      // Number of triangles stored (indexed or not)

    // Vertex attributes data
    f32 *vertices,          // Vertex position (XYZ - 3 components per vertex) (shader-location = 0)
    f32 *texcoords,         // Vertex texture coordinates (UV - 2 components per vertex) (shader-location = 1)
    f32 *texcoords2,        // Vertex texture second coordinates (UV - 2 components per vertex) (shader-location = 5)
    f32 *normals,           // Vertex normals (XYZ - 3 components per vertex) (shader-location = 2)
    f32 *tangents,          // Vertex tangents (XYZW - 4 components per vertex) (shader-location = 4)
    u8 *colors,             // Vertex colors (RGBA - 4 components per vertex) (shader-location = 3)
    u16 *indices,           // Vertex indices (in case vertex data comes indexed)

    // Animation vertex data
    f32 *animVertices,      // Animated vertex positions (after bones transformations)
    f32 *animNormals,       // Animated normals (after bones transformations)
    u8 *boneIds,            // Vertex bone ids, max 255 bone ids, up to 4 bones influence by vertex (skinning)
    f32 *boneWeights,       // Vertex bone weight, up to 4 bones influence by vertex (skinning)

    // OpenGL identifiers
    u32 vaoId,              // OpenGL Vertex Array Object id
    u32 *vboId,             // OpenGL Vertex Buffer Objects id (default vertex data)
}

// Shader
struct Shader {
    u32 id,                 // Shader program id
    i32 *locs,              // Shader locations array (RL_MAX_SHADER_LOCATIONS)
}

// MaterialMap
struct MaterialMap {
    Texture texture,      // Material map texture
    Color color,            // Material map color
    f32 value,              // Material map value
}

// Material, includes shader and maps
struct Material {
    Shader shader,          // Material shader
    MaterialMap *maps,      // Material maps array (MAX_MATERIAL_MAPS)
    f32 params0,            // Material generic parameters (if required)
    f32 params1,            // Elle does not support static array types
    f32 params2,
    f32 params3,
}

// Transform, vertex transformation data
struct Transform {
    Vector3 translation,    // Translation
    Quaternion rotation,    // Rotation
    Vector3 scale,          // Scale
}

// Bone, skeletal animation bone
struct BoneInfo {
    i64 n0, i64 n1,         // Bone name
    i64 n2, i64 n3,         // Elle does not support static array types
    i32 parent,             // Bone parent
}

// Model, meshes, materials and animation data
struct Model {
    Matrix transform,       // Local transform matrix

    i32 meshCount,          // Number of meshes
    i32 materialCount,      // Number of materials
    Mesh *meshes,           // Meshes array
    Material *materials,    // Materials array
    i32 *meshMaterial,      // Mesh material number

    // Animation data
    i32 boneCount,          // Number of bones
    BoneInfo *bones,        // Bones information (skeleton)
    Transform *bindPose,    // Bones base transformation (pose)
}

// ModelAnimation
struct ModelAnimation {
    i32 boneCount,          // Number of bones
    i32 frameCount,         // Number of animation frames
    BoneInfo *bones,        // Bones information (skeleton)
    Transform **framePoses, // Poses array by frame
    i64 n0, i64 n1,         // Animation name
    i64 n2, i64 n3,         // Elle does not support static array types
}

// Ray, ray for raycasting
struct Ray {
    Vector3 position,       // Ray position (origin)
    Vector3 direction,      // Ray direction
}

// RayCollision, ray hit information
struct RayCollision {
    bool hit,               // Did the ray hit something?
    f32 distance,           // Distance to the nearest hit
    Vector3 point,          // Point of the nearest hit
    Vector3 normal,         // Surface normal of hit
}

// BoundingBox
struct BoundingBox {
    Vector3 min,            // Minimum vertex box-corner
    Vector3 max,            // Maximum vertex box-corner
}

// Wave, audio wave data
struct Wave {
    u64 frameCount,         // Total number of frames (considering channels)
    u64 sampleRate,         // Frequency (samples per second)
    u64 sampleSize,         // Bit depth (bits per sample): 8, 16, 32 (24 not supported)
    u64 channels,           // Number of channels (1-mono, 2-stereo, ...)
    void *data,             // Buffer data pointer
}

// AudioStream, custom audio stream
struct AudioStream {
    void *buffer,          // Pointer to internal data used by the audio system
    void *processor,       // Pointer to internal data processor, useful for audio effects

    u64 sampleRate,        // Frequency (samples per second)
    u64 sampleSize,        // Bit depth (bits per sample): 8, 16, 32 (24 not supported)
    u64 channels,          // Number of channels (1-mono, 2-stereo, ...)
}

// Sound
struct Sound {
    AudioStream stream,    // Audio stream
    u64 frameCount,        // Total number of frames (considering channels)
}

// Music, audio stream, anything longer than ~10 seconds should be streamed
struct Music {
    AudioStream stream,    // Audio stream
    u64 frameCount,        // Total number of frames (considering channels)
    bool looping,          // Music looping enable

    i32 ctxType,           // Type of music context (audio filetype)
    void *ctxData,         // Audio context data, depends on type
}

// File path list
struct FilePathList {
    u32 capacity,          // Filepaths max entries
    u32 count,             // Filepaths entries count
    string *paths,         // Filepaths entries
}

!external fn FilePathList::__len__(FilePathList self) {
    return self.count;
}

!external fn FilePathList::__load__(FilePathList self, u32 i) {
    return self.paths[i];
}

// Automation event
struct AutomationEvent {
    u64 frame,             // Event frame
    u64 ty,                // Event type (AutomationEventType)
    i32 params0,           // Event parameters (if required)
    i32 params1,           // Elle does not support static array types
    i32 params2,
    i32 params3,
}

// Automation event list
struct AutomationEventList {
    u64 capacity,                   // Events max entries (MAX_AUTOMATION_EVENTS)
    u64 count,                      // Events entries count
    AutomationEvent *events,        // Events entries
}

// VrDeviceInfo, Head-Mounted-Display device parameters
struct VrDeviceInfo {
    i32 hResolution,                // Horizontal resolution in pixels
    i32 vResolution,                // Vertical resolution in pixels
    f32 hScreenSize,                // Horizontal size in meters
    f32 vScreenSize,                // Vertical size in meters
    f32 vScreenCenter,              // Screen center in meters
    f32 eyeToScreenDistance,        // Distance between eye and display in meters
    f32 lensSeparationDistance,     // Lens separation distance in meters
    f32 interpupillaryDistance,     // IPD (distance between pupils) in meters
    f32 lensDistortionValues0,      // Lens distortion constant parameters
    f32 lensDistortionValues1,      // Elle does not support static array types
    f32 lensDistortionValues2,
    f32 lensDistortionValues3,
    f32 chromaAbCorrection0,        // Chromatic aberration correction parameters
    f32 chromaAbCorrection1,        // Elle does not support static array types
    f32 chromaAbCorrection2,
    f32 chromaAbCorrection3,
}

// VrStereoConfig, VR stereo rendering configuration for simulator
// Elle does not support static array types but the struct must remain the same size
struct VrStereoConfig {
    Matrix projection0,             // VR projection matrices (per eye)
    Matrix projection1,
    Matrix viewOffset0,             // VR view offset matrices (per eye)
    Matrix viewOffset1,
    f32 leftLensCenter0,            // VR left lens center
    f32 leftLensCenter1,
    f32 rightLensCenter0,           // VR right lens center
    f32 rightLensCenter1,
    f32 leftScreenCenter0,          // VR left screen center
    f32 leftScreenCenter1,
    f32 rightScreenCenter0,         // VR right screen center
    f32 rightScreenCenter1,
    f32 scale0,                     // VR distortion scale
    f32 scale1,
    f32 scaleIn0,                   // VR distortion scale in
    f32 scaleIn1,
}

//----------------------------------------------------------------------------------
// Enumerators Definition
//----------------------------------------------------------------------------------
// System/Window config flags
// NOTE: Every bit registers one state (use it with bit masks)
// By default all flags are set to 0
enum ConfigFlags @repr(u32) {
    FLAG_VSYNC_HINT               = 0x00000040,   // Set to try enabling V-Sync on GPU
    FLAG_FULLSCREEN_MODE          = 0x00000002,   // Set to run program in fullscreen
    FLAG_WINDOW_RESIZABLE         = 0x00000004,   // Set to allow resizable window
    FLAG_WINDOW_UNDECORATED       = 0x00000008,   // Set to disable window decoration (frame and buttons)
    FLAG_WINDOW_HIDDEN            = 0x00000080,   // Set to hide window
    FLAG_WINDOW_MINIMIZED         = 0x00000200,   // Set to minimize window (iconify)
    FLAG_WINDOW_MAXIMIZED         = 0x00000400,   // Set to maximize window (expanded to monitor)
    FLAG_WINDOW_UNFOCUSED         = 0x00000800,   // Set to window non focused
    FLAG_WINDOW_TOPMOST           = 0x00001000,   // Set to window always on top
    FLAG_WINDOW_ALWAYS_RUN        = 0x00000100,   // Set to allow windows running while minimized
    FLAG_WINDOW_TRANSPARENT       = 0x00000010,   // Set to allow transparent framebuffer
    FLAG_WINDOW_HIGHDPI           = 0x00002000,   // Set to support HighDPI
    FLAG_WINDOW_MOUSE_PASSTHROUGH = 0x00004000,   // Set to support mouse passthrough, only supported when FLAG_WINDOW_UNDECORATED
    FLAG_BORDERLESS_WINDOWED_MODE = 0x00008000,   // Set to run program in borderless windowed mode
    FLAG_MSAA_4X_HINT             = 0x00000020,   // Set to try enabling MSAA 4X
    FLAG_INTERLACED_HINT          = 0x00010000    // Set to try enabling interlaced video format (for V3D)
}

// Trace log level
// NOTE: Organized by priority level
enum TraceLogLevel {
    LOG_ALL,        // Display all logs
    LOG_TRACE,      // Trace logging, intended for internal use only
    LOG_DEBUG,      // Debug logging, used for internal debugging, it should be disabled on release builds
    LOG_INFO,       // Info logging, used for program execution info
    LOG_WARNING,    // Warning logging, used on recoverable failures
    LOG_ERROR,      // Error logging, used on unrecoverable failures
    LOG_FATAL,      // Fatal logging, used to abort program: exit(EXIT_FAILURE)
    LOG_NONE        // Disable logging
}

// Keyboard keys (US keyboard layout)
// NOTE: Use GetKeyPressed() to allow redefining
// required keys for alternative layouts
enum KeyboardKey {
    KEY_NULL            = 0,        // Key: NULL, used for no key pressed
    // Alphanumeric keys
    KEY_APOSTROPHE      = 39,       // Key: '
    KEY_COMMA           = 44,       // Key: ,
    KEY_MINUS           = 45,       // Key: -
    KEY_PERIOD          = 46,       // Key: .
    KEY_SLASH           = 47,       // Key: /
    KEY_ZERO            = 48,       // Key: 0
    KEY_ONE             = 49,       // Key: 1
    KEY_TWO             = 50,       // Key: 2
    KEY_THREE           = 51,       // Key: 3
    KEY_FOUR            = 52,       // Key: 4
    KEY_FIVE            = 53,       // Key: 5
    KEY_SIX             = 54,       // Key: 6
    KEY_SEVEN           = 55,       // Key: 7
    KEY_EIGHT           = 56,       // Key: 8
    KEY_NINE            = 57,       // Key: 9
    KEY_SEMICOLON       = 59,       // Key: ;
    KEY_EQUAL           = 61,       // Key: =
    KEY_A               = 65,       // Key: A | a
    KEY_B               = 66,       // Key: B | b
    KEY_C               = 67,       // Key: C | c
    KEY_D               = 68,       // Key: D | d
    KEY_E               = 69,       // Key: E | e
    KEY_F               = 70,       // Key: F | f
    KEY_G               = 71,       // Key: G | g
    KEY_H               = 72,       // Key: H | h
    KEY_I               = 73,       // Key: I | i
    KEY_J               = 74,       // Key: J | j
    KEY_K               = 75,       // Key: K | k
    KEY_L               = 76,       // Key: L | l
    KEY_M               = 77,       // Key: M | m
    KEY_N               = 78,       // Key: N | n
    KEY_O               = 79,       // Key: O | o
    KEY_P               = 80,       // Key: P | p
    KEY_Q               = 81,       // Key: Q | q
    KEY_R               = 82,       // Key: R | r
    KEY_S               = 83,       // Key: S | s
    KEY_T               = 84,       // Key: T | t
    KEY_U               = 85,       // Key: U | u
    KEY_V               = 86,       // Key: V | v
    KEY_W               = 87,       // Key: W | w
    KEY_X               = 88,       // Key: X | x
    KEY_Y               = 89,       // Key: Y | y
    KEY_Z               = 90,       // Key: Z | z
    KEY_LEFT_BRACKET    = 91,       // Key: [
    KEY_BACKSLASH       = 92,       // Key: '\'
    KEY_RIGHT_BRACKET   = 93,       // Key: ]
    KEY_GRAVE           = 96,       // Key: `
    // Function keys
    KEY_SPACE           = 32,       // Key: Space
    KEY_ESCAPE          = 256,      // Key: Esc
    KEY_ENTER           = 257,      // Key: Enter
    KEY_TAB             = 258,      // Key: Tab
    KEY_BACKSPACE       = 259,      // Key: Backspace
    KEY_INSERT          = 260,      // Key: Ins
    KEY_DELETE          = 261,      // Key: Del
    KEY_RIGHT           = 262,      // Key: Cursor right
    KEY_LEFT            = 263,      // Key: Cursor left
    KEY_DOWN            = 264,      // Key: Cursor down
    KEY_UP              = 265,      // Key: Cursor up
    KEY_PAGE_UP         = 266,      // Key: Page up
    KEY_PAGE_DOWN       = 267,      // Key: Page down
    KEY_HOME            = 268,      // Key: Home
    KEY_END             = 269,      // Key: End
    KEY_CAPS_LOCK       = 280,      // Key: Caps lock
    KEY_SCROLL_LOCK     = 281,      // Key: Scroll down
    KEY_NUM_LOCK        = 282,      // Key: Num lock
    KEY_PRINT_SCREEN    = 283,      // Key: Print screen
    KEY_PAUSE           = 284,      // Key: Pause
    KEY_F1              = 290,      // Key: F1
    KEY_F2              = 291,      // Key: F2
    KEY_F3              = 292,      // Key: F3
    KEY_F4              = 293,      // Key: F4
    KEY_F5              = 294,      // Key: F5
    KEY_F6              = 295,      // Key: F6
    KEY_F7              = 296,      // Key: F7
    KEY_F8              = 297,      // Key: F8
    KEY_F9              = 298,      // Key: F9
    KEY_F10             = 299,      // Key: F10
    KEY_F11             = 300,      // Key: F11
    KEY_F12             = 301,      // Key: F12
    KEY_LEFT_SHIFT      = 340,      // Key: Shift left
    KEY_LEFT_CONTROL    = 341,      // Key: Control left
    KEY_LEFT_ALT        = 342,      // Key: Alt left
    KEY_LEFT_SUPER      = 343,      // Key: Super left
    KEY_RIGHT_SHIFT     = 344,      // Key: Shift right
    KEY_RIGHT_CONTROL   = 345,      // Key: Control right
    KEY_RIGHT_ALT       = 346,      // Key: Alt right
    KEY_RIGHT_SUPER     = 347,      // Key: Super right
    KEY_KB_MENU         = 348,      // Key: KB menu
    // Keypad keys
    KEY_KP_0            = 320,      // Key: Keypad 0
    KEY_KP_1            = 321,      // Key: Keypad 1
    KEY_KP_2            = 322,      // Key: Keypad 2
    KEY_KP_3            = 323,      // Key: Keypad 3
    KEY_KP_4            = 324,      // Key: Keypad 4
    KEY_KP_5            = 325,      // Key: Keypad 5
    KEY_KP_6            = 326,      // Key: Keypad 6
    KEY_KP_7            = 327,      // Key: Keypad 7
    KEY_KP_8            = 328,      // Key: Keypad 8
    KEY_KP_9            = 329,      // Key: Keypad 9
    KEY_KP_DECIMAL      = 330,      // Key: Keypad .
    KEY_KP_DIVIDE       = 331,      // Key: Keypad /
    KEY_KP_MULTIPLY     = 332,      // Key: Keypad *
    KEY_KP_SUBTRACT     = 333,      // Key: Keypad -
    KEY_KP_ADD          = 334,      // Key: Keypad +
    KEY_KP_ENTER        = 335,      // Key: Keypad Enter
    KEY_KP_EQUAL        = 336,      // Key: Keypad =
    // Android key buttons
    KEY_BACK            = 4,        // Key: Android back button
    KEY_MENU            = 82,       // Key: Android menu button
    KEY_VOLUME_UP       = 24,       // Key: Android volume up button
    KEY_VOLUME_DOWN     = 25,       // Key: Android volume down button
}

// Mouse buttons
enum MouseButton {
    MOUSE_BUTTON_LEFT,              // Mouse button left
    MOUSE_BUTTON_RIGHT,             // Mouse button right
    MOUSE_BUTTON_MIDDLE,            // Mouse button middle (pressed wheel)
    MOUSE_BUTTON_SIDE,              // Mouse button side (advanced mouse device)
    MOUSE_BUTTON_EXTRA,             // Mouse button extra (advanced mouse device)
    MOUSE_BUTTON_FORWARD,           // Mouse button forward (advanced mouse device)
    MOUSE_BUTTON_BACK,              // Mouse button back (advanced mouse device)

    MOUSE_LEFT_BUTTON = 0,
    MOUSE_RIGHT_BUTTON,
    MOUSE_MIDDLE_BUTTON,
}

// Mouse cursor
enum MouseCursor {
    MOUSE_CURSOR_DEFAULT,           // Default pointer shape
    MOUSE_CURSOR_ARROW,             // Arrow shape
    MOUSE_CURSOR_IBEAM,             // Text writing cursor shape
    MOUSE_CURSOR_CROSSHAIR,         // Cross shape
    MOUSE_CURSOR_POINTING_HAND,     // Pointing hand cursor
    MOUSE_CURSOR_RESIZE_EW,         // Horizontal resize/move arrow shape
    MOUSE_CURSOR_RESIZE_NS,         // Vertical resize/move arrow shape
    MOUSE_CURSOR_RESIZE_NWSE,       // Top-left to bottom-right diagonal resize/move arrow shape
    MOUSE_CURSOR_RESIZE_NESW,       // The top-right to bottom-left diagonal resize/move arrow shape
    MOUSE_CURSOR_RESIZE_ALL,        // The omnidirectional resize/move cursor shape
    MOUSE_CURSOR_NOT_ALLOWED        // The operation-not-allowed shape
}

// Gamepad buttons
enum GamepadButton {
    GAMEPAD_BUTTON_UNKNOWN,             // Unknown button, just for error checking
    GAMEPAD_BUTTON_LEFT_FACE_UP,        // Gamepad left DPAD up button
    GAMEPAD_BUTTON_LEFT_FACE_RIGHT,     // Gamepad left DPAD right button
    GAMEPAD_BUTTON_LEFT_FACE_DOWN,      // Gamepad left DPAD down button
    GAMEPAD_BUTTON_LEFT_FACE_LEFT,      // Gamepad left DPAD left button
    GAMEPAD_BUTTON_RIGHT_FACE_UP,       // Gamepad right button up (i.e. PS3: Triangle, Xbox: Y)
    GAMEPAD_BUTTON_RIGHT_FACE_RIGHT,    // Gamepad right button right (i.e. PS3: Square, Xbox: X)
    GAMEPAD_BUTTON_RIGHT_FACE_DOWN,     // Gamepad right button down (i.e. PS3: Cross, Xbox: A)
    GAMEPAD_BUTTON_RIGHT_FACE_LEFT,     // Gamepad right button left (i.e. PS3: Circle, Xbox: B)
    GAMEPAD_BUTTON_LEFT_TRIGGER_1,      // Gamepad top/back trigger left (first), it could be a trailing button
    GAMEPAD_BUTTON_LEFT_TRIGGER_2,      // Gamepad top/back trigger left (second), it could be a trailing button
    GAMEPAD_BUTTON_RIGHT_TRIGGER_1,     // Gamepad top/back trigger right (one), it could be a trailing button
    GAMEPAD_BUTTON_RIGHT_TRIGGER_2,     // Gamepad top/back trigger right (second), it could be a trailing button
    GAMEPAD_BUTTON_MIDDLE_LEFT,         // Gamepad center buttons, left one (i.e. PS3: Select)
    GAMEPAD_BUTTON_MIDDLE,              // Gamepad center buttons, middle one (i.e. PS3: PS, Xbox: XBOX)
    GAMEPAD_BUTTON_MIDDLE_RIGHT,        // Gamepad center buttons, right one (i.e. PS3: Start)
    GAMEPAD_BUTTON_LEFT_THUMB,          // Gamepad joystick pressed button left
    GAMEPAD_BUTTON_RIGHT_THUMB,         // Gamepad joystick pressed button right
}

// Gamepad axis
enum GamepadAxis {
    GAMEPAD_AXIS_LEFT_X,            // Gamepad left stick X axis
    GAMEPAD_AXIS_LEFT_Y,            // Gamepad left stick Y axis
    GAMEPAD_AXIS_RIGHT_X,           // Gamepad right stick X axis
    GAMEPAD_AXIS_RIGHT_Y,           // Gamepad right stick Y axis
    GAMEPAD_AXIS_LEFT_TRIGGER,      // Gamepad back trigger left, pressure level: [1..-1]
    GAMEPAD_AXIS_RIGHT_TRIGGER,     // Gamepad back trigger right, pressure level: [1..-1]
}

// Material map index
enum MaterialMapIndex {
    MATERIAL_MAP_ALBEDO,            // Albedo material (same as: MATERIAL_MAP_DIFFUSE)
    MATERIAL_MAP_METALNESS,         // Metalness material (same as: MATERIAL_MAP_SPECULAR)
    MATERIAL_MAP_NORMAL,            // Normal material
    MATERIAL_MAP_ROUGHNESS,         // Roughness material
    MATERIAL_MAP_OCCLUSION,         // Ambient occlusion material
    MATERIAL_MAP_EMISSION,          // Emission material
    MATERIAL_MAP_HEIGHT,            // Heightmap material
    MATERIAL_MAP_CUBEMAP,           // Cubemap material (NOTE: Uses GL_TEXTURE_CUBE_MAP)
    MATERIAL_MAP_IRRADIANCE,        // Irradiance material (NOTE: Uses GL_TEXTURE_CUBE_MAP)
    MATERIAL_MAP_PREFILTER,         // Prefilter material (NOTE: Uses GL_TEXTURE_CUBE_MAP)
    MATERIAL_MAP_BRDF,              // Brdf material

    MATERIAL_MAP_DIFFUSE = 0,
    MATERIAL_MAP_SPECULAR,
}

// Shader location index
enum ShaderLocationIndex {
    SHADER_LOC_VERTEX_POSITION,       // Shader location: vertex attribute: position
    SHADER_LOC_VERTEX_TEXCOORD01,     // Shader location: vertex attribute: texcoord01
    SHADER_LOC_VERTEX_TEXCOORD02,     // Shader location: vertex attribute: texcoord02
    SHADER_LOC_VERTEX_NORMAL,         // Shader location: vertex attribute: normal
    SHADER_LOC_VERTEX_TANGENT,        // Shader location: vertex attribute: tangent
    SHADER_LOC_VERTEX_COLOR,          // Shader location: vertex attribute: color
    SHADER_LOC_MATRIX_MVP,            // Shader location: matrix uniform: model-view-projection
    SHADER_LOC_MATRIX_VIEW,           // Shader location: matrix uniform: view (camera transform)
    SHADER_LOC_MATRIX_PROJECTION,     // Shader location: matrix uniform: projection
    SHADER_LOC_MATRIX_MODEL,          // Shader location: matrix uniform: model (transform)
    SHADER_LOC_MATRIX_NORMAL,         // Shader location: matrix uniform: normal
    SHADER_LOC_VECTOR_VIEW,           // Shader location: vector uniform: view
    SHADER_LOC_COLOR_DIFFUSE,         // Shader location: vector uniform: diffuse color
    SHADER_LOC_COLOR_SPECULAR,        // Shader location: vector uniform: specular color
    SHADER_LOC_COLOR_AMBIENT,         // Shader location: vector uniform: ambient color
    SHADER_LOC_MAP_ALBEDO,            // Shader location: sampler2d texture: albedo (same as: SHADER_LOC_MAP_DIFFUSE)
    SHADER_LOC_MAP_METALNESS,         // Shader location: sampler2d texture: metalness (same as: SHADER_LOC_MAP_SPECULAR)
    SHADER_LOC_MAP_NORMAL,            // Shader location: sampler2d texture: normal
    SHADER_LOC_MAP_ROUGHNESS,         // Shader location: sampler2d texture: roughness
    SHADER_LOC_MAP_OCCLUSION,         // Shader location: sampler2d texture: occlusion
    SHADER_LOC_MAP_EMISSION,          // Shader location: sampler2d texture: emission
    SHADER_LOC_MAP_HEIGHT,            // Shader location: sampler2d texture: height
    SHADER_LOC_MAP_CUBEMAP,           // Shader location: samplerCube texture: cubemap
    SHADER_LOC_MAP_IRRADIANCE,        // Shader location: samplerCube texture: irradiance
    SHADER_LOC_MAP_PREFILTER,         // Shader location: samplerCube texture: prefilter
    SHADER_LOC_MAP_BRDF,              // Shader location: sampler2d texture: brdf

    SHADER_LOC_MAP_DIFFUSE = 15,
    SHADER_LOC_MAP_SPECULAR
}

// Shader uniform data type
enum ShaderUniformDataType {
    SHADER_UNIFORM_FLOAT,        // Shader uniform type: float
    SHADER_UNIFORM_VEC2,         // Shader uniform type: vec2 (2 float)
    SHADER_UNIFORM_VEC3,         // Shader uniform type: vec3 (3 float)
    SHADER_UNIFORM_VEC4,         // Shader uniform type: vec4 (4 float)
    SHADER_UNIFORM_INT,          // Shader uniform type: int
    SHADER_UNIFORM_IVEC2,        // Shader uniform type: ivec2 (2 int)
    SHADER_UNIFORM_IVEC3,        // Shader uniform type: ivec3 (3 int)
    SHADER_UNIFORM_IVEC4,        // Shader uniform type: ivec4 (4 int)
    SHADER_UNIFORM_SAMPLER2D,    // Shader uniform type: sampler2d
}

// Shader attribute data types
enum ShaderAttributeDataType {
    SHADER_ATTRIB_FLOAT,    // Shader attribute type: float
    SHADER_ATTRIB_VEC2,     // Shader attribute type: vec2 (2 float)
    SHADER_ATTRIB_VEC3,     // Shader attribute type: vec3 (3 float)
    SHADER_ATTRIB_VEC4,     // Shader attribute type: vec4 (4 float)
}

// Pixel formats
// NOTE: Support depends on OpenGL version and platform
enum PixelFormat {
    PIXELFORMAT_UNCOMPRESSED_GRAYSCALE ,     // 8 bit per pixel (no alpha)
    PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA,     // 8*2 bpp (2 channels)
    PIXELFORMAT_UNCOMPRESSED_R5G6B5,         // 16 bpp
    PIXELFORMAT_UNCOMPRESSED_R8G8B8,         // 24 bpp
    PIXELFORMAT_UNCOMPRESSED_R5G5B5A1,       // 16 bpp (1 bit alpha)
    PIXELFORMAT_UNCOMPRESSED_R4G4B4A4,       // 16 bpp (4 bit alpha)
    PIXELFORMAT_UNCOMPRESSED_R8G8B8A8,       // 32 bpp
    PIXELFORMAT_UNCOMPRESSED_R32,            // 32 bpp (1 channel - float)
    PIXELFORMAT_UNCOMPRESSED_R32G32B32,      // 32*3 bpp (3 channels - float)
    PIXELFORMAT_UNCOMPRESSED_R32G32B32A32,   // 32*4 bpp (4 channels - float)
    PIXELFORMAT_UNCOMPRESSED_R16,            // 16 bpp (1 channel - half float)
    PIXELFORMAT_UNCOMPRESSED_R16G16B16,      // 16*3 bpp (3 channels - half float)
    PIXELFORMAT_UNCOMPRESSED_R16G16B16A16,   // 16*4 bpp (4 channels - half float)
    PIXELFORMAT_COMPRESSED_DXT1_RGB,         // 4 bpp (no alpha)
    PIXELFORMAT_COMPRESSED_DXT1_RGBA,        // 4 bpp (1 bit alpha)
    PIXELFORMAT_COMPRESSED_DXT3_RGBA,        // 8 bpp
    PIXELFORMAT_COMPRESSED_DXT5_RGBA,        // 8 bpp
    PIXELFORMAT_COMPRESSED_ETC1_RGB,         // 4 bpp
    PIXELFORMAT_COMPRESSED_ETC2_RGB,         // 4 bpp
    PIXELFORMAT_COMPRESSED_ETC2_EAC_RGBA,    // 8 bpp
    PIXELFORMAT_COMPRESSED_PVRT_RGB,         // 4 bpp
    PIXELFORMAT_COMPRESSED_PVRT_RGBA,        // 4 bpp
    PIXELFORMAT_COMPRESSED_ASTC_4x4_RGBA,    // 8 bpp
    PIXELFORMAT_COMPRESSED_ASTC_8x8_RGBA,    // 2 bpp
}

// Texture parameters: filter mode
// NOTE 1: Filtering considers mipmaps if available in the texture
// NOTE 2: Filter is accordingly set for minification and magnification
enum TextureFilter {
    TEXTURE_FILTER_POINT,              // No filter, just pixel approximation
    TEXTURE_FILTER_BILINEAR,           // Linear filtering
    TEXTURE_FILTER_TRILINEAR,          // Trilinear filtering (linear with mipmaps)
    TEXTURE_FILTER_ANISOTROPIC_4X,     // Anisotropic filtering 4x
    TEXTURE_FILTER_ANISOTROPIC_8X,     // Anisotropic filtering 8x
    TEXTURE_FILTER_ANISOTROPIC_16X,    // Anisotropic filtering 16x
}

// Texture parameters: wrap mode
enum TextureWrap {
    TEXTURE_WRAP_REPEAT,           // Repeats texture in tiled mode
    TEXTURE_WRAP_CLAMP,            // Clamps texture to edge pixel in tiled mode
    TEXTURE_WRAP_MIRROR_REPEAT,    // Mirrors and repeats the texture in tiled mode
    TEXTURE_WRAP_MIRROR_CLAMP,     // Mirrors and clamps to border the texture in tiled mode
}

// Cubemap layouts
enum CubemapLayout {
    CUBEMAP_LAYOUT_AUTO_DETECT,            // Automatically detect layout type
    CUBEMAP_LAYOUT_LINE_VERTICAL,          // Layout is defined by a vertical line with faces
    CUBEMAP_LAYOUT_LINE_HORIZONTAL,        // Layout is defined by a horizontal line with faces
    CUBEMAP_LAYOUT_CROSS_THREE_BY_FOUR,    // Layout is defined by a 3x4 cross with cubemap faces
    CUBEMAP_LAYOUT_CROSS_FOUR_BY_THREE,    // Layout is defined by a 4x3 cross with cubemap faces
    CUBEMAP_LAYOUT_PANORAMA,               // Layout is defined by a panorama image (equirrectangular map)
}

// Font type, defines generation method
enum FontType {
    FONT_DEFAULT,    // Default font generation, anti-aliased
    FONT_BITMAP,     // Bitmap font generation, no anti-aliasing
    FONT_SDF,        // SDF font generation, requires external shader
}

// Color blending modes (pre-defined)
enum BlendMode {
    BLEND_ALPHA,                // Blend textures considering alpha (default)
    BLEND_ADDITIVE,             // Blend textures adding colors
    BLEND_MULTIPLIED,           // Blend textures multiplying colors
    BLEND_ADD_COLORS,           // Blend textures adding colors (alternative)
    BLEND_SUBTRACT_COLORS,      // Blend textures subtracting colors (alternative)
    BLEND_ALPHA_PREMULTIPLY,    // Blend premultiplied textures considering alpha
    BLEND_CUSTOM,               // Blend textures using custom src/dst factors (use rlSetBlendFactors())
    BLEND_CUSTOM_SEPARATE,      // Blend textures using custom rgb/alpha separate src/dst factors (use rlSetBlendFactorsSeparate())
}

// Gesture
// NOTE: Provided as bit-wise flags to enable only desired gestures
enum Gesture {
    GESTURE_NONE        = 0b0000000000,       // No gesture
    GESTURE_TAP         = 0b0000000001,      // Tap gesture
    GESTURE_DOUBLETAP   = 0b0000000010,      // Double tap gesture
    GESTURE_HOLD        = 0b0000000100,      // Hold gesture
    GESTURE_DRAG        = 0b0000001000,      // Drag gesture
    GESTURE_SWIPE_RIGHT = 0b0000010000,      // Swipe right gesture
    GESTURE_SWIPE_LEFT  = 0b0000100000,      // Swipe left gesture
    GESTURE_SWIPE_UP    = 0b0001000000,      // Swipe up gesture
    GESTURE_SWIPE_DOWN  = 0b0010000000,      // Swipe down gesture
    GESTURE_PINCH_IN    = 0b0100000000,      // Pinch in gesture
    GESTURE_PINCH_OUT   = 0b1000000000      // Pinch out gesture
}

// Camera system modes
enum CameraMode {
    CAMERA_CUSTOM,           // Custom camera
    CAMERA_FREE,             // Free camera
    CAMERA_ORBITAL,          // Orbital camera
    CAMERA_FIRST_PERSON,     // First person camera
    CAMERA_THIRD_PERSON,     // Third person camera
}

// Camera projection
enum CameraProjection {
    CAMERA_PERSPECTIVE,          // Perspective projection
    CAMERA_ORTHOGRAPHIC,         // Orthographic projection
}

// N-patch layout
enum NPatchLayout {
    NPATCH_NINE_PATCH,                // Npatch layout: 3x3 tiles
    NPATCH_THREE_PATCH_VERTICAL,      // Npatch layout: 1x3 tiles
    NPATCH_THREE_PATCH_HORIZONTAL,    // Npatch layout: 3x1 tiles
}

// Callbacks to hook some internal functions
// WARNING: These callbacks are intended for advance users
//
// NOTE from Rosie: I'm not sure what to do with these as Elle doesn't have typedefs
//
// typedef void (*TraceLogCallback)(int logLevel, const char *text, va_list args);  // Logging: Redirect trace log messages
// typedef unsigned char *(*LoadFileDataCallback)(const char *fileName, int *dataSize);    // FileIO: Load binary data
// typedef bool (*SaveFileDataCallback)(const char *fileName, void *data, int dataSize);   // FileIO: Save binary data
// typedef char *(*LoadFileTextCallback)(const char *fileName);            // FileIO: Load text data
// typedef bool (*SaveFileTextCallback)(const char *fileName, char *text); // FileIO: Save text data

//------------------------------------------------------------------------------------
// Global Variables Definition
//------------------------------------------------------------------------------------
// It's lonely here...

//------------------------------------------------------------------------------------
// Window and Graphics Device Functions (Module: core)
//------------------------------------------------------------------------------------

// Elle's raylib namespace for functions so that it doesnt pollute the global namespace
// NOTE: Elle uses snake case for functions, so aliases coming from Raylib should also
// follow this snake case convention for the sake of consistency.
namespace rl;

fn rlGetTextureIdDefault() -> u32;

!external fn rl::get_default_texture() {
    return Texture {
        id = rlGetTextureIdDefault(),
        width = 1,
        height = 1,
        mipmaps = 1,
        format = PixelFormat::PIXELFORMAT_UNCOMPRESSED_R8G8B8A8,
    };
}

// Window-related functions
fn InitWindow(i32 width, i32 height, string title)       @alias(rl::init_window);                                   // Initialize window and OpenGL context
fn CloseWindow()                                         @alias(rl::close_window);                                  // Close window and unload OpenGL context
fn WindowShouldClose()                                   @alias(rl::window_should_close)         -> bool;           // Check if application should close (KEY_ESCAPE pressed or windows close icon clicked)
fn IsWindowReady()                                       @alias(rl::is_window_ready)             -> bool;           // Check if window has been initialized successfully
fn IsWindowFullscreen()                                  @alias(rl::is_window_fullscreen)        -> bool;           // Check if window is currently fullscreen
fn IsWindowHidden()                                      @alias(rl::is_window_hidden)            -> bool;           // Check if window is currently hidden (only PLATFORM_DESKTOP)
fn IsWindowMinimized()                                   @alias(rl::is_window_minimized)         -> bool;           // Check if window is currently minimized (only PLATFORM_DESKTOP)
fn IsWindowMaximized()                                   @alias(rl::is_window_maximized)         -> bool;           // Check if window is currently maximized (only PLATFORM_DESKTOP)
fn IsWindowFocused()                                     @alias(rl::is_window_focused)           -> bool;           // Check if window is currently focused (only PLATFORM_DESKTOP)
fn IsWindowResized()                                     @alias(rl::is_window_resized)           -> bool;           // Check if window has been resized last frame
fn IsWindowState(u32 flag)                               @alias(rl::is_window_state)             -> bool;           // Check if one specific window flag is enabled
fn SetWindowState(u32 flags)                             @alias(rl::set_window_state);                              // Set window configuration state using flags (only PLATFORM_DESKTOP)
fn ClearWindowState(u32 flags)                           @alias(rl::clear_window_state);                            // Clear window configuration state flags
fn ToggleFullscreen()                                    @alias(rl::toggle_fullscreen);                             // Toggle window state: fullscreen/windowed (only PLATFORM_DESKTOP)
fn ToggleBorderlessWindowed()                            @alias(rl::toggle_borderless_windowed);                    // Toggle window state: borderless windowed (only PLATFORM_DESKTOP)
fn MaximizeWindow()                                      @alias(rl::maximize_window);                               // Set window state: maximized, if resizable (only PLATFORM_DESKTOP)
fn MinimizeWindow()                                      @alias(rl::minimize_window);                               // Set window state: minimized, if resizable (only PLATFORM_DESKTOP)
fn RestoreWindow()                                       @alias(rl::restore_window);                                // Set window state: not minimized/maximized (only PLATFORM_DESKTOP)
fn SetWindowIcon(Image image)                            @alias(rl::set_window_icon);                               // Set icon for window (single image, RGBA 32bit, only PLATFORM_DESKTOP)
fn SetWindowIcons(Image *images, i32 count)              @alias(rl::set_window_icons);                              // Set icon for window (multiple images, RGBA 32bit, only PLATFORM_DESKTOP)
fn SetWindowTitle(string title)                          @alias(rl::set_window_title);                              // Set title for window (only PLATFORM_DESKTOP and PLATFORM_WEB)
fn SetWindowPosition(i32 x, i32 y)                       @alias(rl::set_window_position);                           // Set window position on screen (only PLATFORM_DESKTOP)
fn SetWindowMonitor(i32 monitor)                         @alias(rl::set_window_monitor);                            // Set monitor for the current window
fn SetWindowMinSize(i32 width, i32 height)               @alias(rl::set_window_min_size);                           // Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE)
fn SetWindowMaxSize(i32 width, i32 height)               @alias(rl::set_window_max_size);                           // Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE)
fn SetWindowSize(i32 width, i32 height)                  @alias(rl::set_window_size);                               // Set window dimensions
fn SetWindowOpacity(f32 opacity)                         @alias(rl::set_window_opacity);                            // Set window opacity [0.0f..1.0f] (only PLATFORM_DESKTOP)
fn SetWindowFocused()                                    @alias(rl::set_window_focused);                            // Set window focused (only PLATFORM_DESKTOP)
fn GetWindowHandle()                                     @alias(rl::get_window_handle)           -> void *;         // Get native window handle
fn GetScreenWidth()                                      @alias(rl::get_screen_width)            -> i32;            // Get current screen width
fn GetScreenHeight()                                     @alias(rl::get_screen_height)           -> i32;            // Get current screen height
fn GetRenderWidth()                                      @alias(rl::get_render_width)            -> i32;            // Get current render width (it considers HiDPI)
fn GetRenderHeight()                                     @alias(rl::get_render_height)           -> i32;            // Get current render height (it considers HiDPI)
fn GetMonitorCount()                                     @alias(rl::get_monitor_count)           -> i32;            // Get number of connected monitors
fn GetCurrentMonitor()                                   @alias(rl::get_current_monitor)         -> i32;            // Get current connected monitor
fn GetMonitorPosition(i32 monitor)                       @alias(rl::get_monitor_position)        -> Vector2;        // Get specified monitor position
fn GetMonitorWidth(i32 monitor)                          @alias(rl::get_monitor_width)           -> i32;            // Get specified monitor width (current video mode used by monitor)
fn GetMonitorHeight(i32 monitor)                         @alias(rl::get_monitor_height)          -> i32;            // Get specified monitor height (current video mode used by monitor)
fn GetMonitorPhysicalWidth(i32 monitor)                  @alias(rl::get_monitor_physical_width)  -> i32;            // Get specified monitor physical width in millimetres
fn GetMonitorPhysicalHeight(i32 monitor)                 @alias(rl::get_monitor_physical_height) -> i32;            // Get specified monitor physical height in millimetres
fn GetMonitorRefreshRate(i32 monitor)                    @alias(rl::get_monitor_refresh_rate)    -> i32;            // Get specified monitor refresh rate
fn GetWindowPosition()                                   @alias(rl::get_window_position)         -> Vector2;        // Get window position XY on monitor
fn GetWindowScaleDPI()                                   @alias(rl::get_window_scale_dpi)        -> Vector2;        // Get window scale DPI factor
fn GetMonitorName(i32 monitor)                           @alias(rl::get_monitor_name)            -> string;         // Get the human-readable, UTF-8 encoded name of the specified monitor
fn SetClipboardText(string text)                         @alias(rl::set_clipboard_text);                            // Set clipboard text content
fn GetClipboardText()                                    @alias(rl::get_clipboard_text)          -> string;         // Get clipboard text content
fn EnableEventWaiting()                                  @alias(rl::enable_event_waiting);                          // Enable waiting for events on EndDrawing(), no automatic event polling
fn DisableEventWaiting()                                 @alias(rl::disable_event_waiting);                         // Disable waiting for events on EndDrawing(), automatic events polling

// Cursor-related functions
fn ShowCursor()                                          @alias(rl::show_cursor);                                   // Shows cursor
fn HideCursor()                                          @alias(rl::hide_cursor);                                   // Hides cursor
fn IsCursorHidden()                                      @alias(rl::is_cursor_hidden)            -> bool;           // Check if cursor is not visible
fn EnableCursor()                                        @alias(rl::enable_cursor);                                 // Enables cursor (unlock cursor)
fn DisableCursor()                                       @alias(rl::disable_cursor);                                // Disables cursor (lock cursor)
fn IsCursorOnScreen()                                    @alias(rl::is_cursor_on_screen)         -> bool;           // Check if cursor is on the screen

// Drawing-related functions
fn ClearBackground(Color color)                          @alias(rl::clear_background);                              // Set background color (framebuffer clear color)
fn BeginDrawing()                                        @alias(rl::begin_drawing);                                 // Setup canvas (framebuffer) to start drawing
fn EndDrawing()                                          @alias(rl::end_drawing);                                   // End canvas drawing and swap buffers (double buffering)
fn BeginMode2D(Camera2D camera)                          @alias(rl::begin_mode_2d);                                 // Begin 2D mode with custom camera (2D)
fn EndMode2D()                                           @alias(rl::end_mode_2d);                                   // Ends 2D mode with custom camera
fn BeginMode3D(Camera3D camera)                          @alias(rl::begin_mode_3d);                                 // Begin 3D mode with custom camera (3D)
fn EndMode3D()                                           @alias(rl::end_mode_3d);                                   // Ends 3D mode and returns to default 2D orthographic mode
fn BeginTextureMode(RenderTexture2D target)              @alias(rl::begin_texture_mode);                            // Begin drawing to render texture
fn EndTextureMode()                                      @alias(rl::end_texture_mode);                              // Ends drawing to render texture
fn BeginShaderMode(Shader shader)                        @alias(rl::begin_shader_mode);                             // Begin custom shader drawing
fn EndShaderMode()                                       @alias(rl::end_shader_mode);                               // End custom shader drawing (use default shader)
fn BeginBlendMode(i32 mode)                              @alias(rl::begin_blend_mode);                              // Begin blending mode (alpha, additive, multiplied, subtract, custom)
fn EndBlendMode()                                        @alias(rl::end_blend_mode);                                // End blending mode (reset to default: alpha blending)
fn BeginScissorMode(i32 x, i32 y, i32 width, i32 height) @alias(rl::begin_scissor_mode);                            // Begin scissor mode (define screen area for following drawing)
fn EndScissorMode()                                      @alias(rl::end_scissor_mode);                              // End scissor mode
fn BeginVrStereoMode(VrStereoConfig config)              @alias(rl::begin_vr_stereo_mode);                          // Begin stereo rendering (requires VR simulator)
fn EndVrStereoMode()                                     @alias(rl::end_vr_stereo_mode);                            // End stereo rendering (requires VR simulator)

// VR stereo config functions for VR simulator
fn LoadVrStereoConfig(VrDeviceInfo device)               @alias(rl::load_vr_stereo_config)       -> VrStereoConfig; // Load VR stereo config for VR simulator device parameters
fn UnloadVrStereoConfig(VrStereoConfig config)           @alias(rl::unlod_vr_stereo_config);                        // Unload VR stereo config

// Shader management functions
// NOTE: Shader functionality is not available on OpenGL 1.1
fn LoadShader(string vsFileName, string fsFileName)                                      @alias(rl::load_shader)                -> Shader;  // Load shader from files and bind default locations
fn LoadShaderFromMemory(string vsCode, string fsCode)                                    @alias(rl::load_shader_from_memory)    -> Shader;  // Load shader from code strings and bind default locations
fn IsShaderReady(Shader shader)                                                          @alias(rl::is_shader_ready) -> bool;               // Check if a shader is ready
fn GetShaderLocation(Shader shader, string uniformName)                                  @alias(rl::get_shader_location)        -> i32;     // Get shader uniform location
fn GetShaderLocationAttrib(Shader shader, string attribName)                             @alias(rl::get_shader_location_attrib) -> i32;     // Get shader attribute location
fn SetShaderValue(Shader shader, i32 locIndex, void *value, i32 uniformType)             @alias(rl::set_shader_value);                      // Set shader uniform value
fn SetShaderValueV(Shader shader, i32 locIndex, void *value, i32 uniformType, i32 count) @alias(rl::set_shader_value_v);                    // Set shader uniform value vector
fn SetShaderValueMatrix(Shader shader, i32 locIndex, Matrix mat)                         @alias(rl::set_shader_value_matrix);               // Set shader uniform value (matrix 4x4)
fn SetShaderValueTexture(Shader shader, i32 locIndex, Texture texture)                   @alias(rl::set_shader_value_texture);              // Set shader uniform value for texture (sampler2d)
fn UnloadShader(Shader shader)                                                           @alias(rl::unload_shader);                         // Unload shader from GPU memory (VRAM)

// Screen-space-related functions
fn GetMouseRay(Vector2 mousePosition, Camera camera)                      @alias(rl::get_mouse_ray)             -> Ray;          // Get a ray trace from mouse position
fn GetCameraMatrix(Camera camera)                                         @alias(rl::get_camera_matrix)         -> Matrix;       // Get camera transform matrix (view matrix)
fn GetCameraMatrix2D(Camera2D camera)                                     @alias(rl::get_camera_matrix_2d)      -> Matrix;       // Get camera 2d transform matrix
fn GetWorldToScreen(Vector3 pos, Camera camera)                           @alias(rl::get_world_to_screen)       -> Vector2;      // Get the screen space position for a 3d world space position
fn GetScreenToWorld2D(Vector2 pos, Camera2D camera)                       @alias(rl::get_screen_to_world_2d)    -> Vector2;      // Get the world space position for a 2d camera screen space position
fn GetWorldToScreenEx(Vector3 pos, Camera camera, i32 width, i32 height)  @alias(rl::get_world_to_screen_ex)    -> Vector2;      // Get size position for a 3d world space position
fn GetWorldToScreen2D(Vector2 pos, Camera2D camera)                       @alias(rl::get_world_to_screen_2d)    -> Vector2;      // Get the screen space position for a 2d camera world space position

// Timing-related functions
fn SetTargetFPS(i32 fps)                                                  @alias(rl::set_target_fps);                            // Set target FPS (maximum)
fn GetFrameTime()                                                         @alias(rl::get_frame_time)            -> f32;          // Get time in seconds for last frame drawn (delta time)
fn GetTime()                                                              @alias(rl::get_time)                  -> f64;          // Get elapsed time in seconds since InitWindow()
fn GetFPS()                                                               @alias(rl::get_fps)                   -> i32;          // Get current FPS

// Custom frame control functions
// NOTE: Those functions are intended for advance users that want full control over the frame processing
// By default EndDrawing() does this job: draws everything + SwapScreenBuffer() + manage frame timing + PollInputEvents()
// To avoid that behaviour and control frame processes manually, enable in config.h: SUPPORT_CUSTOM_FRAME_CONTROL
fn SwapScreenBuffer()                                                     @alias(rl::swap_screen_buffer);                        // Swap back buffer with front buffer (screen drawing)
fn PollInputEvents()                                                      @alias(rl::poll_input_events);                         // Register all input events
fn WaitTime(f64 seconds)                                                  @alias(rl::wait_time);                                 // Wait for some time (halt program execution)

// Random values generation functions
fn SetRandomSeed(u32 seed)                                                @alias(rl::set_random_seed);                           // Set the seed for the random number generator
fn GetRandomValue(i32 min, i32 max)                                       @alias(rl::get_random_value)          -> i32;          // Get a random value between min and max (both included)
fn LoadRandomSequence(u32 count, u32 min, u32 max)                        @alias(rl::load_random_sequence)      -> i32 *;        // Load random values sequence, no values repeated
fn UnloadRandomSequence(i32 *sequence)                                    @alias(rl::unload_random_sequence);                    // Unload random values sequence

// Misc. functions
fn TakeScreenshot(string fileName)                                        @alias(rl::take_screenshot);                           // Takes a screenshot of current screen (filename extension defines format)
fn SetConfigFlags(u32 flags)                                              @alias(rl::set_config_flags);                          // Setup init configuration flags (view FLAGS)
fn OpenURL(string url)                                                    @alias(rl::open_url);                                  // Open URL with default system browser (if available)

// NOTE: Following functions implemented in module [utils]
//------------------------------------------------------------------
fn TraceLog(i32 logLevel, string text, ...)                               @alias(rl::trace_log);                                 // Show trace log messages (LOG_DEBUG, LOG_INFO, LOG_WARNING, LOG_ERROR...)
fn SetTraceLogLevel(i32 logLevel)                                         @alias(rl::set_trace_log_level);                       // Set the current threshold (minimum) log level
fn MemAlloc(u32 size)                                                     @alias(rl::mem_alloc)                 -> void *;       // Internal memory allocator
fn MemRealloc(void *ptr, u32 size)                                        @alias(rl::mem_realloc)               -> void *;       // Internal memory reallocator
fn MemFree(void *ptr)                                                     @alias(rl::mem_free);                                  // Internal memory free

// Set custom callbacks
// WARNING: Callbacks setup is intended for advance users
fn SetTraceLogCallback(fn(i32, string, void *) callback)                  @alias(rl::set_trace_log_callback);                    // Set custom trace log
fn SetLoadFileDataCallback(fn(string, i32 *) -> u8 *callback)             @alias(rl::set_load_file_data_callback);               // Set custom file binary data loader
fn SetSaveFileDataCallback(fn(string, void *, i32) -> bool callback)      @alias(rl::set_save_file_data_callback);               // Set custom file binary data saver
fn SetLoadFileTextCallback(fn(string) -> string callback)                 @alias(rl::set_load_file_text_callback);               // Set custom file text data loader
fn SetSaveFileTextCallback(fn(string, string) -> bool callback)           @alias(rl::set_save_file_text_callback);               // Set custom file text data saver

// Files management functions
fn LoadFileData(string fileName, u32 *dataSize)                           @alias(rl::load_file_data)            -> u8 *;         // Load file data as byte array (read)
fn UnloadFileData(u8 *data)                                               @alias(rl::unload_file_data);                          // Unload file data allocated by LoadFileData()
fn SaveFileData(string fileName, void *data, i32 dataSize)                @alias(rl::save_file_data)            -> bool;         // Save data to file from byte array (write), returns true on success
fn ExportDataAsCode(u8 *data, i32 dataSize, string fileName)              @alias(rl::export_data_as_code)       -> bool;         // Export data to code (.h), returns true on success
fn LoadFileText(string fileName)                                          @alias(rl::load_file_text)            -> string;       // Load text data from file (read), returns a '\0' terminated string
fn UnloadFileText(string text)                                            @alias(rl::unload_file_text);                          // Unload file text data allocated by LoadFileText()
fn SaveFileText(string fileName, string text)                             @alias(rl::save_file_text)            -> bool;         // Save text data to file (write), string must be '\0' terminated, returns true on success
//------------------------------------------------------------------

// File system functions
fn FileExists(string fileName)                                            @alias(rl::file_exists)               -> bool;         // Check if file exists
fn DirectoryExists(string dirPath)                                        @alias(rl::directory_exists)          -> bool;         // Check if a directory path exists
fn IsFileExtension(string fileName, string ext)                           @alias(rl::is_file_extension)         -> bool;         // Check file extension (including point: .png, .wav)
fn GetFileLength(string fileName)                                         @alias(rl::get_file_length)           -> i32;          // Get file length in bytes (NOTE: GetFileSize() conflicts with windows.h)
fn GetFileExtension(string fileName)                                      @alias(rl::get_file_extension)        -> string;       // Get pointer to extension for a filename string (includes dot: '.png')
fn GetFileName(string filePath)                                            @alias(rl::get_file_name)             -> string;       // Get pointer to filename for a path string
fn GetFileNameWithoutExt(string filePath)                                 @alias(rl::get_file_name_withut_ext)  -> string;       // Get filename string without extension (uses static string)
fn GetDirectoryPath(string filePath)                                      @alias(rl::get_directory_path)        -> string;       // Get full path for a given fileName with path (uses static string)
fn GetPrevDirectoryPath(string dirPath)                                   @alias(rl::get_prev_directory_path)   -> string;       // Get previous directory path for a given path (uses static string)
fn GetWorkingDirectory()                                                  @alias(rl::get_working_directory)     -> string;       // Get current working directory (uses static string)
fn GetApplicationDirectory()                                              @alias(rl::get_application_directory) -> string;       // Get the directory of the running application (uses static string)
fn ChangeDirectory(string dir)                                            @alias(rl::change_directory)          -> bool;         // Change working directory, return true on success
fn IsPathFile(string path)                                                @alias(rl::is_path_file)              -> bool;         // Check if a given path is a file or a directory
fn LoadDirectoryFiles(string dirPath)                                     @alias(rl::load_directory_files)      -> FilePathList; // Load directory filepaths
fn LoadDirectoryFilesEx(string basePath, string filter, bool scanSubdirs) @alias(rl::load_directory_files_ex)   -> FilePathList; // Load directory filepaths with extension filtering and recursive directory scan
fn UnloadDirectoryFiles(FilePathList files)                               @alias(rl::unload_directory_files);                    // Unload filepaths
fn IsFileDropped()                                                        @alias(rl::is_file_dropped)           -> bool;         // Check if a file has been dropped into window
fn LoadDroppedFiles()                                                     @alias(rl::load_dropped_files)        -> FilePathList; // Load dropped filepaths
fn UnloadDroppedFiles(FilePathList files)                                 @alias(rl::unload_dropped_files);                      // Unload dropped filepaths
fn GetFileModTime(string fileName)                                        @alias(rl::get_file_mod_time)         -> i64;          // Get file modification time (last write time)

// Compression/Encoding functionality
fn CompressData(u8 *data, i32 dataSize, i32 *compDataSize)                @alias(rl::compress_data)             -> u8 *;         // Compress data (DEFLATE algorithm), memory must be MemFree()
fn DecompressData(u8 *compData, i32 compDataSize, i32 *dataSize)          @alias(rl::decompress_data)           -> u8 *;         // Decompress data (DEFLATE algorithm), memory must be MemFree()
fn EncodeDataBase64(u8 *data, i32 dataSize, i32 *outputSize)              @alias(rl::encode_data_base64)        -> string;       // Encode data to Base64 string, memory must be MemFree()
fn DecodeDataBase64(u8 *data, i32 *outputSize)                            @alias(rl::decode_data_base64)        -> u8 *;         // Decode Base64 string data, memory must be MemFree()

// Automation events functionality
fn LoadAutomationEventList(string fileName)                               @alias(rl::load_automation_event_list) -> AutomationEventList; // Load automation events list from file, NULL for empty list, capacity = MAX_AUTOMATION_EVENTS
fn UnloadAutomationEventList(AutomationEventList *list)                   @alias(rl::unload_automation_event_list);                      // Unload automation events list from file
fn ExportAutomationEventList(AutomationEventList list, string fileName)   @alias(rl::export_automation_event_list) -> bool;              // Export automation events list as text file
fn SetAutomationEventList(AutomationEventList *list)                      @alias(rl::set_automation_event_list);                         // Set automation event list to record to
fn SetAutomationEventBaseFrame(i32 frame)                                 @alias(rl::set_automation_event_base_frame);                   // Set automation event internal base frame to start recording
fn StartAutomationEventRecording()                                        @alias(rl::start_automation_event_recording);                  // Start recording automation events (AutomationEventList must be set)
fn StopAutomationEventRecording()                                         @alias(rl::stop_automation_event_recording);                   // Stop recording automation events
fn PlayAutomationEvent(AutomationEvent event)                             @alias(rl::play_automation_event);                             // Play a recorded automation event

//------------------------------------------------------------------------------------
// Input Handling Functions (Module: core)
//------------------------------------------------------------------------------------

// Input-related functions: keyboard
fn IsKeyPressed(i32 key)                            @alias(rl::is_key_pressed)             -> bool;    // Check if a key has been pressed once
fn IsKeyPressedRepeat(i32 key)                      @alias(rl::is_key_pressed_repeat)      -> bool;    // Check if a key has been pressed again (Only PLATFORM_DESKTOP)
fn IsKeyDown(i32 key)                               @alias(rl::is_key_down)                -> bool;    // Check if a key is being pressed
fn IsKeyReleased(i32 key)                           @alias(rl::is_key_released)            -> bool;    // Check if a key has been released once
fn IsKeyUp(i32 key)                                 @alias(rl::is_key_up)                  -> bool;    // Check if a key is NOT being pressed
fn GetKeyPressed()                                  @alias(rl::get_key_pressed)            -> i32;     // Get key pressed (keycode), call it multiple times for keys queued, returns 0 when the queue is empty
fn GetCharPressed()                                 @alias(rl::get_char_pressed)           -> i32;     // Get char pressed (unicode), call it multiple times for chars queued, returns 0 when the queue is empty
fn SetExitKey(i32 key)                              @alias(rl::set_exit_key);                          // Set a custom key to exit program (default is ESC)

// Input-related functions: gamepads
fn IsGamepadAvailable(i32 gamepad)                  @alias(rl::is_gamepad_available)       -> bool;    // Check if a gamepad is available
fn GetGamepadName(i32 gamepad)                      @alias(rl::get_gamepad_name)           -> string;  // Get gamepad internal name id
fn IsGamepadButtonPressed(i32 gamepad, i32 button)  @alias(rl::is_gamepad_button_pressed)  -> bool;    // Check if a gamepad button has been pressed once
fn IsGamepadButtonDown(i32 gamepad, i32 button)     @alias(rl::is_gamepad_button_down)     -> bool;    // Check if a gamepad button is being pressed
fn IsGamepadButtonReleased(i32 gamepad, i32 button) @alias(rl::is_gamepad_button_released) -> bool;    // Check if a gamepad button has been released once
fn IsGamepadButtonUp(i32 gamepad, i32 button)       @alias(rl::is_gamepad_button_up)       -> bool;    // Check if a gamepad button is NOT being pressed
fn GetGamepadButtonPressed()                        @alias(rl::get_gamepad_button_pressed) -> i32;     // Get the last gamepad button pressed
fn GetGamepadAxisCount(i32 gamepad)                 @alias(rl::get_gamepad_axis_count)     -> i32;     // Get gamepad axis count for a gamepad
fn GetGamepadAxisMovement(i32 gamepad, i32 axis)    @alias(rl::get_gamepad_axis_movement)  -> f32;     // Get axis movement value for a gamepad axis
fn SetGamepadMappings(string mappings)              @alias(rl::set_gamepad_mappings)       -> i32;     // Set internal gamepad mappings (SDL_GameControllerDB)

// Input-related functions: mouse
fn IsMouseButtonPressed(i32 button)                 @alias(rl::is_mouse_button_pressed)    -> bool;    // Check if a mouse button has been pressed once
fn IsMouseButtonDown(i32 button)                    @alias(rl::is_mouse_button_down)       -> bool;    // Check if a mouse button is being pressed
fn IsMouseButtonReleased(i32 button)                @alias(rl::is_mouse_button_released)   -> bool;    // Check if a mouse button has been released once
fn IsMouseButtonUp(i32 button)                      @alias(rl::is_mouse_button_up)         -> bool;    // Check if a mouse button is NOT being pressed
fn GetMouseX()                                      @alias(rl::get_mouse_x)                -> i32;     // Get mouse position X
fn GetMouseY()                                      @alias(rl::get_mouse_y)                -> i32;     // Get mouse position Y
fn GetMousePosition()                               @alias(rl::get_mouse_position)         -> Vector2; // Get mouse position XY
fn GetMouseDelta()                                  @alias(rl::get_mouse_delta)            -> Vector2; // Get mouse delta between frames
fn SetMousePosition(i32 x, i32 y)                   @alias(rl::set_mouse_position);                    // Set mouse position XY
fn SetMouseOffset(i32 offsetX, i32 offsetY)         @alias(rl::set_mouse_offset);                      // Set mouse offset
fn SetMouseScale(f32 scaleX, f32 scaleY)            @alias(rl::set_mouse_scale);                       // Set mouse scaling
fn GetMouseWheelMove()                              @alias(rl::get_mouse_wheel_move)       -> f32;     // Get mouse wheel movement for X or Y, whichever is larger
fn GetMouseWheelMoveV()                             @alias(rl::get_mouse_wheel_move_v)     -> Vector2; // Get mouse wheel movement for both X and Y
fn SetMouseCursor(i32 cursor)                       @alias(rl::set_mouse_cursor);                      // Set mouse cursor

// Input-related functions: touch
