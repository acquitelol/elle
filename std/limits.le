global pub, external;

fn i64::max() -> i64;
fn i64::min() -> i64;
fn i32::max() -> i32;
fn i32::min() -> i32;
fn i16::max() -> i16;
fn i16::min() -> i16;
fn i8::max() -> i8;
fn i8::min() -> i8;
fn u64::max() -> u64;
fn u64::min() -> u64;
fn u32::max() -> u32;
fn u32::min() -> u32;
fn u16::max() -> u16;
fn u16::min() -> u16;
fn u8::max() -> u8;
fn u8::min() -> u8;

fn f64::max() -> f64;
fn f64::min() -> f64;
fn f32::max() -> f32;
fn f32::min() -> f32;

const i64::MAX = i64::max();
const i64::MIN = i64::min();
const i32::MAX = i32::max();
const i32::MIN = i32::min();
const i16::MAX = i16::max();
const i16::MIN = i16::min();
const i8::MAX = i8::max();
const i8::MIN = i8::min();

const u64::MAX = u64::max();
const u64::MIN = u64::min();
const u32::MAX = u32::max();
const u32::MIN = u32::min();
const u16::MAX = u16::max();
const u16::MIN = u16::min();
const u8::MAX = u8::max();
const u8::MIN = u8::min();

const f64::MAX = f64::max();
const f64::MIN = f64::min();
const f32::MAX = f32::max();
const f32::MIN = f32::min();
