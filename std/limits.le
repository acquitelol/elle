global pub, external;

fn i64::max() -> i64;
fn i64::min() -> i64;
fn i32::max() -> i32;
fn i32::min() -> i32;
fn i16::max() -> i16;
fn i16::min() -> i16;
fn i8::max() -> i8;
fn i8::min() -> i8;
fn u64::max() -> u64;
fn u64::min() -> u64;
fn u32::max() -> u32;
fn u32::min() -> u32;
fn u16::max() -> u16;
fn u16::min() -> u16;
fn u8::max() -> u8;
fn u8::min() -> u8;

fn f64::max() -> f64;
fn f64::min() -> f64;
fn f32::max() -> f32;
fn f32::min() -> f32;

let i64::MAX = i64::max();
let i64::MIN = i64::min();
let i32::MAX = i32::max();
let i32::MIN = i32::min();
let i16::MAX = i16::max();
let i16::MIN = i16::min();
let i8::MAX = i8::max();
let i8::MIN = i8::min();

let u64::MAX = u64::max();
let u64::MIN = u64::min();
let u32::MAX = u32::max();
let u32::MIN = u32::min();
let u16::MAX = u16::max();
let u16::MIN = u16::min();
let u8::MAX = u8::max();
let u8::MIN = u8::min();

let f64::MAX = f64::max();
let f64::MIN = f64::min();
let f32::MAX = f32::max();
let f32::MIN = f32::min();
