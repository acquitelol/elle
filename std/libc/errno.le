fn Errno::__fmt__(Errno self, i32 nesting) {
    /// Binops cast out to the enum repr type :)
    return "{} ({})".format(strerror(self + 0), self + 0);
}

fn Errno::from(i32 errno) {
    return #cast(Errno, errno);
}
