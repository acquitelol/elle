global pub, external;

fn memchr(string str, char character, i64 n) -> i64;
fn memcmp(string str1, string str2, i64 n) -> i32;
fn memcpy(void *dest, void *src, i64 n) -> i64;
fn memmove(void *dest, void *src, i64 n) -> i64;
fn memset(void *str, char character, i64 n) -> i64;

fn strcat(string dest, string src) -> string;
fn strncat(string dest, string src, i64 n) -> string;
fn strchr(string str, char character) -> string;
fn strcmp(string str1, string str2) -> i32;
fn strncmp(string str1, string str2, i64 n) -> i32;
fn strcoll(string str1, string str2) -> i32;
fn strcpy(string dest, string src) -> string;
fn strncpy(string dest, string src, i64 n) -> string;
fn strspn(string str1, string str2) -> i64;
fn strcspn(string str1, string str2) -> i64;
fn strerror(i32 errnum) -> string;
fn strlen(string str) -> i64;
fn strlen(string self) @alias(string::len) -> u64;
fn strlen(string self) @alias(string::__len__) -> u64;
fn strpbrk(string str1, string str2) -> string;
fn strrchr(string str, char character) -> string;
fn strstr(string haystack, string needle) -> string;
fn strtok(string str, string delim) -> string;
fn strxfrm(string dest, string src, i64 n) -> i64;
