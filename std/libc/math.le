global pub, external;
namespace math;

fn acos(f64 x) @alias(math::acos) -> f64;
fn acosf(f32 x) @alias(math::acosf) -> f32;
fn asin(f64 x) @alias(math::asin) -> f64;
fn asinf(f32 x) @alias(math::asinf) -> f32;
fn atan(f64 slope) @alias(math::atan) -> f64;
fn atanf(f32 slope) @alias(math::atanf) -> f32;
fn atan2(f64 y, f64 x) @alias(math::atan2) -> f64;
fn atan2f(f32 y, f32 x) @alias(math::atan2f) -> f32;
fn cos(f64 x) @alias(math::cos) -> f64;
fn cosf(f32 x) @alias(math::cosf) -> f32;
fn cosh(f64 x) @alias(math::cosh) -> f64;
fn coshf(f32 x) @alias(math::coshf) -> f32;
fn sin(f64 x) @alias(math::sin) -> f64;
fn sinf(f32 x) @alias(math::sinf) -> f32;
fn sinh(f64 x) @alias(math::sinh) -> f64;
fn sinhf(f32 x) @alias(math::sinhf) -> f32;
fn tan(f64 x) @alias(math::tan) -> f64;
fn tanf(f32 x) @alias(math::tanf) -> f32;
fn tanh(f64 x) @alias(math::tanh) -> f64;
fn tanhf(f32 x) @alias(math::tanhf) -> f32;
fn exp(f64 x) @alias(math::exp) -> f64;
fn expf(f32 x) @alias(math::expf) -> f32;
fn frexp(f64 x, i32 *exponent) @alias(math::frexp) -> f64;
fn frexpf(f32 x, i32 *exponent) @alias(math::frexpf) -> f32;
fn ldexp(f64 x, i32 exponent) @alias(math::ldexp) -> f64;
fn ldexpf(f32 x, i32 exponent) @alias(math::ldexpf) -> f32;
fn log(f64 x) @alias(math::log) -> f64;
fn logf(f32 x) @alias(math::logf) -> f32;
fn log10(f64 x) @alias(math::log10) -> f64;
fn log10f(f32 x) @alias(math::log10f) -> f32;
fn modf(f64 x, f64 *integer) @alias(math::modf) -> f64;
fn modff(f32 x, f32 *integer) @alias(math::modff) -> f32;
//fn pow(f64 x, f64 y) @alias(math::pow) -> f64;
fn powf(f32 x, f32 y) @alias(math::powf) -> f32;
fn sqrt(f64 x) @alias(math::sqrt) -> f64;
fn sqrtf(f32 x) @alias(math::sqrtf) -> f32;
fn ceil(f64 x) @alias(math::ceil) -> f64;
fn ceilf(f32 x) @alias(math::ceilf) -> f32;
fn fabs(f64 x) @alias(math::fabs) -> f64;
fn fabsf(f32 x) @alias(math::fabsf) -> f32;
fn floor(f64 x) @alias(math::floor) -> f64;
fn floorf(f32 x) @alias(math::floorf) -> f32;
fn fmod(f64 x, f64 y) @alias(math::fmod) -> f64;
fn fmodf(f32 x, f32 y) @alias(math::fmodf) -> f32;
fn fmin(f64 x, f64 y) @alias(math::fmin) -> f64;
fn fminf(f32 x, f32 y) @alias(math::fminf) -> f64;
fn fmax(f64 x, f64 y) @alias(math::fmax) -> f64;
fn fmaxf(f32 x, f32 y) @alias(math::fmaxf) -> f32;
fn round(f64 x) @alias(math::round) -> f64;
fn roundf(f32 x) @alias(math::roundf) -> f32;
fn labs(i64 x) @alias(math::labs) -> i64;