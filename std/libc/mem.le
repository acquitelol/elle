namespace mem;
global pub, external;

fn malloc(i64 size) @alias(mem::malloc) -> void *;
fn realloc(void *ptr, i64 size) @alias(mem::realloc) -> void *;
fn calloc(i64 count, i64 size) @alias(mem::calloc) -> void *;
fn free(void *ptr) @alias(mem::free);
fn memcpy(void *dest, void *src, i64 n) @alias(mem::memcpy) -> i64;
fn memmove(void *dest, void *src, i64 n) @alias(mem::memmove) -> i64;
fn memset(void *str, char character, i64 n) @alias(mem::memset) -> i64;
