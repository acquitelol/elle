use std/runtime/libc/io;
global pub;

external let stdin: FILE *;
external let stdout: FILE *;
external let stderr: FILE *;

fn __internal_get_errno() @cfg(target = "macos") {
    return __error();
}

fn __internal_get_errno() @cfg(target = "linux") {
    return __errno_location();
}

let errno = *__internal_get_errno();

fn os_get_last_error() -> string {
    return strerror(errno);
}
