use std/collections/array;
use std/libc/mem;
use std/libc/io;
global pub;

struct BigInt {
    i32[] digits, // Starts with least significant digit
    bool is_negative
}

fn BigInt::empty(bool is_negative) {
    bigint := #alloc(BigInt);

    bigint.is_negative = is_negative;
    bigint.digits = [];

    return bigint;
}

fn BigInt::new(string value) -> BigInt * {
    bigint := BigInt::empty(false);

    if value.is_empty() {
        bigint.digits.push(0);
        return bigint;
    }

    start_index := 0;
    if value[0] == '-' {
        bigint.is_negative = true;
        start_index = 1;
    }

    for i := #cast(i64, value.len() - 1); i >= start_index; i -= 1 {
        bigint.digits.push(value[i] - '0');
    }

    return bigint;
}

fn BigInt::to_string(BigInt *self) -> string {
    result := self.is_negative ? "-" : "";

    for i := self.digits.len() - 1; i >= 0; i -= 1 {
        result.push(self.digits[i] + '0');
    }

    return result;
}

external fn BigInt::to_string(BigInt *self) @alias(BigInt::__fmt__) -> string;

fn BigInt::to<T>(BigInt *self) -> T {
    result: T = 0;
    multiplier: T = 1;

    for i: u64 = 0; i < self.digits.len(); i += 1 {
        result += self.digits[i] * multiplier;
        multiplier *= 10;
    }

    return self.is_negative ? -result : result;
}

// Forward declare
external fn BigInt::sub(BigInt *self, BigInt *other) -> BigInt *;

fn BigInt::add(BigInt *self, BigInt *other) -> BigInt * {
    if self.is_negative != other.is_negative {
        if self.is_negative {
            self.is_negative = false;
            a := other.sub(self);
            self.is_negative = true;
            return a;
        } else {
            other.is_negative = false;
            b := self.sub(other);
            other.is_negative = true;
            return b;
        }
    }

    result := BigInt::empty(self.is_negative);
    carry := 0;
    max_len := self.digits.len() > other.digits.len()
        ? self.digits.len()
        : other.digits.len();

    for i := 0; (i < max_len) || (carry != 0); i += 1 {
        a := i < self.digits.len() ? self.digits[i] : 0;
        b := i < other.digits.len() ? other.digits[i] : 0;
        sum := a + b + carry;

        result.digits.push(sum % 10);
        carry = sum / 10;
    }

    return result;
}

fn BigInt::compare(BigInt *self, BigInt *other) -> i32 {
    if self.is_negative != other.is_negative {
        return self.is_negative ? -1 : 1;
    }

    if self.digits.len() != other.digits.len() {
        return self.digits.len() < other.digits.len() == self.is_negative ? 1 : -1;
    }

    for i := #cast(i64, self.digits.len() - 1); i >= 0; i -= 1 {
        if self.digits[i] != other.digits[i] {
            return self.digits[i] < other.digits[i] == self.is_negative ? 1 : -1;
        }
    }

    return 0;
}

fn BigInt::sub(BigInt *self, BigInt *other) -> BigInt * {
    if self.is_negative != other.is_negative {
        other.is_negative = !other.is_negative;
        a := self.add(other);
        other.is_negative = !other.is_negative;
        return a;
    }

    if self.is_negative {
        other.is_negative = false;
        self.is_negative = false;
        b := other.sub(self);
        self.is_negative = true;
        other.is_negative = true;
        return b;
    }

    if self.compare(other) < 0 {
        c := other.sub(self);
        c.is_negative = true;
        return c;
    }

    result := BigInt::empty(false);
    borrow := 0;

    for i := 0; i < self.digits.len(); i += 1 {
        a := self.digits[i];
        b := i < other.digits.len() ? other.digits[i] : 0;
        diff := a - b - borrow;

        if diff < 0 {
            diff += 10;
            borrow = 1;
        } else {
            borrow = 0;
        }

        result.digits.push(diff);
    }

    while result.digits.len() > 1 && res := result.digits.last()! == 0 {
        result.digits.pop();
    }

    return result;
}

fn BigInt::equals(BigInt *self, BigInt *other) {
    return self.compare(other) == 0;
}

external fn BigInt::equals(BigInt *self, BigInt *other) @alias(BigInt::__equals__) -> bool;

fn BigInt::mul(BigInt *self, BigInt *other) -> BigInt * {
    result := BigInt::empty(false);
    result.digits = Array::with_capacity(self.digits.len() + other.digits.len());

    for i := 0; i < result.digits.capacity; i += 1 {
        result.digits.push(0);
    }

    result.is_negative = self.is_negative != other.is_negative;

    for i := 0; i < self.digits.len(); i += 1 {
        carry := 0;

        for j: u64 = 0; j < other.digits.len() || carry != 0; j += 1 {
            b := j < other.digits.len() ? other.digits[j] : 0;
            prod := result.digits[i + j] + self.digits[i] * b + carry;
            result.digits[i + j] = prod % 10;
            carry = prod / 10;
        }
    }

    while result.digits.len() > 1 && res := result.digits.last()! == 0 {
        result.digits.pop();
    }

    return result;
}
