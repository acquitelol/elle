global pub, external;

// used to force stack allocated pointers to be pushed to the stack
// and not be optimized into registers so that the GC can detect
// them as a root when scanning the stack for valid roots
fn __internal_gc_noop(void *x);

namespace GCAllocator; // entirely opaque

fn GCAllocator::new() -> GCAllocator *;
fn GCAllocator::mark(GCAllocator *self);
fn GCAllocator::sweep(GCAllocator *self);
fn GCAllocator::collect(GCAllocator *self);
fn GCAllocator::alloc(GCAllocator *self, i64 size) -> void *;
fn GCAllocator::realloc(GCAllocator *self, void *ptr, i64 new_size) -> void *;
fn GCAllocator::free_self(GCAllocator *self);
fn GCAllocator::free(GCAllocator *self);
fn GCAllocator::set_threshold(GCAllocator *self, u64 threshold);
fn GCAllocator::set_growth_factor(GCAllocator *self, u64 growth_factor);
