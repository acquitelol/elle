use std/runtime/allocators/__internal__;
global pub;

external fn ArbitraryAllocator::new();
external fn ArbitraryAllocator::noop();
external fn ArbitraryAllocator::set_allocator(ArbitraryAllocator *self, void *inner, void *alloc, void *realloc, void *free_self);
external fn ArbitraryAllocator::alloc(ArbitraryAllocator *self, i32 size);
external fn ArbitraryAllocator::realloc(ArbitraryAllocator *self, void *ptr, i32 new_size);
external fn ArbitraryAllocator::free(ArbitraryAllocator *self, void *ptr);
external fn ArbitraryAllocator::free_self(ArbitraryAllocator *self);
