use std/runtime/allocators/__internal__;
global pub, external;

fn ArbitraryAllocator::new() -> ArbitraryAllocator *;
fn ArbitraryAllocator::noop();
fn ArbitraryAllocator::set_allocator(ArbitraryAllocator *self, void *inner, void *alloc, void *realloc, void *free_self);
fn ArbitraryAllocator::alloc(ArbitraryAllocator *self, i64 size) -> void *;
fn ArbitraryAllocator::realloc(ArbitraryAllocator *self, void *ptr, i64 new_size) -> void *;
fn ArbitraryAllocator::free(ArbitraryAllocator *self, void *ptr);
fn ArbitraryAllocator::free_self(ArbitraryAllocator *self);
