global pub, external;
namespace ArenaAllocator;

fn ArenaAllocator::new() -> ArenaAllocator *;
fn ArenaAllocator::alloc(ArenaAllocator *self, i64 size) -> void *;
fn ArenaAllocator::realloc(ArenaAllocator *self, void *ptr, i64 new_size) -> void *;
fn ArenaAllocator::free(ArenaAllocator *self, void *ptr);
fn ArenaAllocator::free_self(ArenaAllocator *self);
