global pub, external;

const i64 CLOCKS_PER_SEC = 1_000_000;

struct time_info {
    i32 seconds,  // Seconds [0, 60]
    i32 minutes,  // Minutes [0, 59]
    i32 hours,    // Hour [0, 23]
    i32 days,     // Day of the month [1, 31]
    i32 months,   // Month of the year [0, 11]
    i32 years,    // Years since 1900
    i32 weekdays, // Day of week [0,6] (Sunday =0)
    i32 yeardays, // Day of year [0,365].
    i32 dst       // Daylight Savings flag.
}

fn asctime(time_info *timeptr) -> string;
fn asctime_r(time_info *restrict, string restrict) -> string;
fn clock() -> i64;
fn ctime(i64 *timer) -> string;
fn ctime_r(i64 *timer, string a) -> string;
fn difftime(f64 time1, f64 time2) -> f64;
fn getdate(string date) -> time_info *;
fn gmtime(i64 *timer) -> time_info *;
fn gmtime_r(i64 *restrict, time_info *restrict) -> time_info *;
fn localtime(i64 *timer) -> time_info *;
fn localtime_r(i64 *restrict, time_info *restrict) -> time_info *;
fn mktime(time_info *timeptr) -> i64;
fn strftime(string str, i64 maxsize, string format, time_info *timeptr) -> i64;
fn time(i64 *timer) -> i64;
fn wcsftime(string str, i64 count, string format, time_info *timer) -> i64;
