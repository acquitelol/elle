use std/libc/socket;
use std/libc/errno;
use std/libc/io;
use std/result;

use std/net/tcp/connection;
global pub;

struct TcpClient {
    i32 fd
}

fn TcpClient::connect(string host, u16 port) -> Result<TcpConnection, Errno> {
    fd := socket(AddressFamily::INET, SocketType::STREAM, 0);

    if fd < 0 {
        return Result::Err(#cast(Errno, *io::errno));
    }

    addr := sockaddr_in {
        sin_family = AddressFamily::INET,
        sin_port = htons(port),
        sin_addr = in_addr { s_addr = inet_addr(host) }
    };

    if connect(fd, #cast(sockaddr *, &addr), #size(addr)) < 0 {
        TcpConnection::close(TcpConnection { fd });
        return Result::Err(#cast(Errno, *io::errno));
    }

    return Result::Ok(TcpConnection {
        fd = fd
    });
}

fn TcpClient::close(TcpClient self) -> Result<Unit, Errno> {
    res := close(self.fd);

    if res < 0 {
        return Result::Err(#cast(Errno, *io::errno));
    }

    return Result::Ok(_);
}
