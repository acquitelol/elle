use std/libc/mem;
global pub;

struct Node<T> {
    void *next;
    T data;
};

struct LinkedList<T> {
    Node<T> *head;
};

fn LinkedList::__fmt__<T>(LinkedList<T> self, i32 nesting) {
    let res = "";

    while self.head {
        res <>= self.head.data.__fmt__(0);
        self.head = self.head.next;

        if self.head {
            res <>= " -> ";
        }
    }

    return res;
}

fn LinkedList::new<T>() -> LinkedList<T> {
    return LinkedList { head = nil };
}

fn LinkedList::add<T>(LinkedList<T> *self, T data) {
    Node<T> *new = mem::malloc(#size(Node<T>));

    if !new {
        return;
    }

    new.data = data;
    new.next = self.head;
    self.head = new;
}

fn LinkedList::free<T>(LinkedList<T> *self) {
    while self.head {
        Node<T> *next = self.head.next;
        mem::free(self.head);
        self.head = next;
    }
}
