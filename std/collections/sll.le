use std/libc/mem;
global pub;

struct Node<T> {
    void *next;
    T data;
};

struct LinkedList<T> {
    Node<T> *head;
};

fn LinkedList::__fmt__<T>(LinkedList<T> self, i32 nesting) {
    res := "";

    while self.head {
        res <>= self.head.data.__fmt__(0);
        self.head = self.head.next;

        if self.head {
            res <>= " -> ";
        }
    }

    return res;
}

fn LinkedList::new<T>() -> LinkedList<T> * {
    return #alloc(LinkedList<T>);
}

fn LinkedList::add<T>(LinkedList<T> *self, T data) {
    new := #alloc(Node<T>);
    new.data = data;
    new.next = self.head;
    self.head = new;
}

fn LinkedList::free<T>(LinkedList<T> *self) {
    while self.head {
        next := self.head.next;
        mem::free(self.head);
        self.head = next;
    }
}
