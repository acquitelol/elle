use std/libc/mem;
use std/libc/io;
use std/core;
use std/math;
use std/io;
global pub;

struct Array<T> @nofmt {
    i32 size;
    i32 capacity;
    T *elements;
};

local fn __internal_array_bounds_check(string file, i32 line, i32 col, i64 i, i64 length) {
    if i < 0 || i > length - 1 {
        io::cprintf(
            "[%s:%d:%d] ERROR: Index %ld is out of bounds for array length %ld\n"
                .color("red")
                .reset(),
            file, line, col, i, length
        );

        abort();
    }
}

fn Array::__fmt__<T>(Array<T> self, i32 nesting) -> string {
    let temp = self;
    return temp.to_string();
}

fn Array::__load__<T>(ElleMeta meta, T[] self, i64 i) {
    __internal_array_bounds_check(meta.file, meta.line, meta.column, i, self.len());
    return self.elements[i];
}

fn Array::__store__<T>(ElleMeta meta, T[] self, i64 i, T value) {
    __internal_array_bounds_check(meta.file, meta.line, meta.column, i, self.len());
    self.elements[i] = value;
}

fn Array::__len__<T>(T[] self) -> i32 {
    return self.size;
}

fn Array::__equals__<T, U>(T[] self, U[] other) -> bool {
    // If the pointers are the same (nil == nil)
    if (void *)self == (void *)other {
        return true;
    }

    // If one is nil
    if ((void *)self == nil) || ((void *)other == nil)
        || self.len() != other.len() // If lengths don't match
    {
        return false;
    }

    if !self.is_empty() && !other.is_empty() {
        if self[0] != other[0] {
            return false; // If the types don't match
        }
    }

    for let i = 0; i < self.len(); i += 1 {
        if self[i] != other[i] {
            return false; // Deep equality
        }
    }

    return true;
}

fn Array::len<T>(T[] self) -> i32 {
    return self.size;
}

fn Array::is_empty<T>(T[] self) -> bool {
    return self.size == 0;
}

fn Array::with_capacity<T>(i32 initialCapacity) -> T[] {
    T[] array = malloc(#size(Array<T>));
    *array = malloc(#size(Array<T>));

    array.elements = malloc(initialCapacity * #size(T));
    array.size = 0;
    array.capacity = initialCapacity;

    return array;
}

fn Array::new<T>(ElleMeta meta, ...) -> T[] {
    T[] array = Array::with_capacity(2);

    if meta.arity > 0 {
        variadic args[meta.arity];

        for i32 i = 0; i < meta.arity; i += 1 {
            array.push(args.yield(T));
        }
    }

    return array;
}

fn Array::resize<T>(T[] self, i32 newCapacity) {
    self.elements = realloc(self.elements, newCapacity * #size(T));
    self.capacity = newCapacity;
}

fn Array::push<T>(T[] self, T element) {
    while self.size >= self.capacity {
        self.resize((self.capacity || 1) * 2);
    }

    self.elements[self.size] = element;
    self.size += 1;
}

// from is inclusive, to is exclusive
//
// example:
// Array::range(0, 4) -> [0, 1, 2, 3]
// Array::range(0, 0) -> []
// Array::range(2, 5) -> [2, 3, 4]
fn Array::range(i32 from, i32 to, bool included) -> i32[] {
    i32[] array = Array::with_capacity(to);

    for i32 i = from; i < to + included; i += 1 {
        array.push(i);
    }

    return array;
}

fn Array::pop<T>(T[] self) -> T {
    if self.is_empty() {
        return (T)nil;
    }

    T last = self.elements[(i32)self.size - 1];
    self.size -= 1;
    self.resize(self.size);

    return last;
}

fn Array::clear<T>(T[] self) {
    self.resize(1);
    self.size = 0;
}

fn Array::sort<T>(T[] self) {
    if self.is_empty() || self.len() <= 1 {
        return;
    }

    __internal_qsort(self.elements, 0, self.len() - 1);
}

local fn __internal_qsort<T>(T *array, i32 low, i32 high) {
    if low >= high {
        return;
    }

    T pivot = array[high];
    i32 i = low;

    for i32 j = low; j < high; j += 1 {
        if array[j] < pivot {
            T temp = array[i];
            array[i] = array[j];
            array[j] = temp;
            i += 1;
        }
    }

    T temp = array[i];
    array[i] = array[high];
    array[high] = temp;

    __internal_qsort(array, low, i - 1);
    __internal_qsort(array, i + 1, high);
}

fn Array::cartesian_product<T>(T[] self, i32 n) {
    T[][] results = [];
    T[] current = [];
    defer current.free();

    if n == 0 {
        T[] combination = [];
        results.push((T)combination);
        return results;
    }

    __internal_cartesian_product_generate(self, current, n, results);
    return results;
}

local fn __internal_cartesian_product_generate<T>(T[] self, T[] current, i32 n, T[][] results) {
    if current.len() == n {
        T[] combination = current.clone();
        results.push((T)combination);
        return;
    }

    for i32 i = 0; i < self.len(); i += 1 {
        current.push(self[i]);
        __internal_cartesian_product_generate(self, current, n, results);
        current.pop();
    }
}

fn Array::clone<T>(T[] self) -> T[] {
    T[] clone = Array::with_capacity(self.len());

    for i32 i = 0; i < self.len(); i += 1 {
        clone.push(self[i]);
    }

    return clone;
}

// Creates a new sized array from a null terminated string
fn Array::from_string(string str) -> char[] {
    i32 length = str.len();
    char[] array = Array::with_capacity(length);

    for i32 i = 0; i < length; i += 1 {
        array.push(str[i]);
    }

    return array;
}

// Turn an array into a string in format [1, 2, "xyz", 'y']
fn Array::to_string<T>(ElleMeta meta, T[] self) -> string {
    string res = "[";

    for i32 i = 0; i < self.len(); i += 1 {
        res.extend(self[i].__fmt__(0));

        if i < self.len() - 1 {
            res.extend(", ");
        }
    }

    res.push(']');
    return res;
}

// Join an array's elements by a separator
fn Array::join<T>(T[] self, string separator) {
    let res = "";

    for item in self {
        res.extend(string::as_string(item));

        if #i(item) < self.len() - 1 {
            res.extend(separator);
        }
    }

    return res;
}

external fn Array::join<T>(T[] self, string separator) @alias("Array::implode") -> string;

fn Array::contains<T>(T[] self, T element) {
    for item in self {
        if item == element {
            return true;
        }
    }

    return false;
}

// Take all the elements of another Array<T> and push them into this Array<T>
fn Array::extend<T>(T[] self, T[] other) {
    for item in other {
        self.push(item);
    }
}

fn Array::remove<T>(T[] self, i32 index) -> T {
    if index < 0 || index >= self.size {
        return (T)nil;
    }

    T removedElement = self[index];

    for let i = index; i < self.size - 1; i += 1 {
        self[i] = self[i + 1];
    }

    self.size -= 1;

    if self.size < self.capacity / 4 {
        self.resize(self.capacity / 2);
    }

    return removedElement;
}

fn Array::insert<T>(T[] self, i32 index, T element) {
    if index < 0 || index > self.size {
        io::cprintf(
            "Index %ld is out of bounds (must be between 0 and %ld inclusive)\n"
                .color("red")
                .reset(),
            index, self.size
        );
        abort();
    }

    if self.size >= self.capacity {
        self.resize((self.capacity || 1) * 2);
    }

    for i32 i = self.size; i > index; i -= 1 {
        self.elements[i] = self.elements[i - 1];
    }

    self.elements[index] = element;
    self.size += 1;
}

fn Array::map<T, U>(U[] self, fn *mapping) -> T[] {
    let new_self = Array::with_capacity(self.len());

    for let i = 0; i < self.len(); i += 1 {
        new_self.push(mapping(self[i], i, new_self));
    }

    return new_self;
}

fn Array::truncate(i64[] self) {
    return self.map<i32>(i64::truncate);
}

fn Array::promote(i32[] self) {
    return self.map<i64>(i32::promote);
}

fn Array::includes<T>(T[] self, T element) {
    for i32 i = 0; i < self.len(); i += 1 {
        if self[i] == element {
            return true;
        }
    }

    return false;
}

fn Array::index<T>(T[] self, T element) {
    for i32 i = 0; i < self.len(); i += 1 {
        if self[i] == element {
            return i;
        }
    }

    return -1;
}

fn Array::sum<T>(T[] self) {
    T sum = 0;

    for i32 i = 0; i < self.len(); i += 1 {
        sum += self.elements[i];
    }

    return sum;
}

fn Array::product<T>(T[] self) {
    T sum = 0;

    for i32 i = 0; i < self.len(); i += 1 {
        sum *= self.elements[i];
    }

    return sum;
}

fn Array::first<T>(T[] self) -> T {
    if self.len() < 1 {
        return (T)nil;
    }

    return self[0];
}

fn Array::last<T>(T[] self) -> T {
    if self.len() < 1 {
        return (T)nil;
    }

    return (T)(self[self.len() - 1]);
}

fn Array::max<T>(T[] self) -> T {
    if self.len() == 0 {
        return (T)nil;
    }

    T max = self[0];

    for i32 i = 1; i < self.len(); i += 1 {
        if self[i] > max {
            max = self[i];
        }
    }

    return max;
}

fn Array::min<T>(T[] self) -> T {
    if self.len() == 0 {
        return (T)nil;
    }

    T min = self[0];

    for i32 i = 1; i < self.len(); i += 1 {
        if self[i] < min {
            min = self[i];
        }
    }

    return min;
}

fn Array::slice<T>(T[] self, i32 _start, i32 _end) -> T[] {
    let start = _start;
    let end = _end;

    if end == -1 {
        end = self.len();
    }

    if start < 0 {
        start = self.len() + start;
    }

    if end < 0 {
        end = self.len() + end;
    }

    if start < 0 {
        start = 0;
    }

    if start >= self.len() {
        start = self.len();
    }

    if end >= self.len() {
        end = self.len();
    }

    if end < start {
        end = start;
    }

    let length = end - start;
    let temp = Array::with_capacity(length);

    temp.elements = self.elements + (start * #size(T));
    temp.size = length;

    return temp;
}

fn Array::free<T>(T[] self) {
    free(self.elements);
    free((void *)(*self));
    free(self);
}
