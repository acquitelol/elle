use std/libc/mem;
use std/libc/io;
use std/core;
global pub;

struct Array<T> @nofmt {
    i32 size;
    i32 capacity;
    T *elements;
};

fn Array::__fmt__<T>(Array<T> self, i32 nesting) -> string {
    Array<T> temp = self;
    return temp.to_string();
}

local fn __internal_array_bounds_check(string file, i32 line, i32 col, i64 i, i64 min_i, i64 max_i) {
    if i < min_i || i > max_i {
        io::cprintf(
            "[%s:%d:%d] Index %ld is out of bounds (must be between %ld and %ld)\n"
                .color("red")
                .reset(),
            file, line, col, i, min_i, max_i
        );

        abort();
    }
}

fn Array::__load__<T>(Array<T> *self, i64 i) {
    __internal_array_bounds_check("", 0, 0, i, 0, self.len() - 1);
    return self.elements[i];
}

fn Array::__store__<T>(Array<T> *self, i64 i, T value) {
    __internal_array_bounds_check("", 0, 0, i, 0, self.len() - 1);
    self.elements[i] = value;
}

