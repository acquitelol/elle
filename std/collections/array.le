fn Array::len<T>(Array<T> *self) -> i32 {
    return self.size;
}

fn Array::is_empty<T>(Array<T> *self) -> bool {
    return self.size == 0;
}

fn Array::with_capacity<T>(i32 initialCapacity) -> Array<T> * {
    Array<T> *array = malloc(#size(Array<T>));
    *array = malloc(#size(Array<T>));

    array.elements = malloc(initialCapacity * #size(T));
    array.size = 0;
    array.capacity = initialCapacity;

    return array;
}

fn Array::new<T>(ElleMeta meta, ...) -> Array<T> * {
    Array<T> *array = Array::with_capacity(2);

    if meta.arity > 0 {
        variadic args[meta.arity];

        for i32 i = 0; i < meta.arity; i += 1 {
            array.push(args.yield(T));
        }
    }

    return array;
}

fn Array::resize<T>(Array<T> *self, i32 newCapacity) {
    self.elements = realloc(self.elements, newCapacity * #size(T));
    self.capacity = newCapacity;
}

fn Array::push<T>(Array<T> *self, T element) {
    while self.size >= self.capacity {
        self.resize((self.capacity || 1) * 2);
    }

    self.elements[self.size] = element;
    self.size += 1;
}

// from is inclusive, to is exclusive
//
// example:
// Array::range(0, 4) -> [0, 1, 2, 3]
// Array::range(0, 0) -> []
// Array::range(2, 5) -> [2, 3, 4]
fn Array::range(i32 from, i32 to) -> Array<i32> * {
    Array<i32> *array = Array::with_capacity(to);

    for i32 i = from; i < to; i += 1 {
        array.push(i);
    }

    return array;
}

fn Array::pop<T>(Array<T> *self) -> T {
    if self.is_empty() {
        return (T)nil;
    }

    T last = self.elements[(i32)self.size - 1];
    self.size -= 1;
    self.resize(self.size);

    return last;
}

fn Array::clear<T>(Array<T> *self) {
    self.resize(1);
    self.size = 0;
}

fn Array::sort<T>(Array<T> *self) {
    if self.is_empty() || self.len() <= 1 {
        return;
    }

    __internal_qsort(self.elements, 0, self.len() - 1);
}

local fn __internal_qsort<T>(T *array, i32 low, i32 high) {
    if low >= high {
        return;
    }

    T pivot = array[high];
    i32 i = low;

    for i32 j = low; j < high; j += 1 {
        if array[j] < pivot {
            T temp = array[i];
            array[i] = array[j];
            array[j] = temp;
            i += 1;
        }
    }

    T temp = array[i];
    array[i] = array[high];
    array[high] = temp;

    __internal_qsort(array, low, i - 1);
    __internal_qsort(array, i + 1, high);
}

fn Array::cartesian_product<T>(Array<T> *self, i32 n) {
    Array<void *> *results = Array::new<void *>();
    Array<T> *current = Array::new();
    defer current.free();

    if n == 0 {
        Array<T> *combination = Array::new();
        results.push((T)combination);
        return results;
    }

    __internal_cartesian_product_generate(self, current, n, results);
    return results;
}

local fn __internal_cartesian_product_generate<T>(Array<T> *self, Array<T> *current, i32 n, Array<void *> *results) {
    if current.len() == n {
        Array<T> *combination = current.clone();
        results.push((T)combination);
        return;
    }

    for i32 i = 0; i < self.len(); i += 1 {
        current.push(self[i]);
        __internal_cartesian_product_generate(self, current, n, results);
        current.pop();
    }
}

fn Array::clone<T>(Array<T> *self) -> Array<T> * {
    Array<T> *clone = Array::with_capacity(self.len());

    for i32 i = 0; i < self.len(); i += 1 {
        clone.push(self[i]);
    }

    return clone;
}

// Creates a new sized array from a null terminated string
fn Array::from_string(string str) -> Array<char> * {
    i32 length = str.len();
    Array<char> *array = Array::with_capacity(length);

    for i32 i = 0; i < length; i += 1 {
        array.push(str[i]);
    }

    return array;
}

// Turn an array into a string in format [1, 2, "xyz", 'y']
fn Array::to_string<T>(ElleMeta meta, Array<T> *self) -> string {
    string res = "[";

    for i32 i = 0; i < self.len(); i += 1 {
        res.extend(self[i].__fmt__(0));

        if i < self.len() - 1 {
            res.extend(", ");
        }
    }

    res.push(']');
    return res;
}

// Join an array's elements by a separator
fn Array::join<T>(Array<T> *self, string separator) {
    string res = "";

    for i32 i = 0; i < self.len(); i += 1 {
        res.extend(string::as_string(self[i]));

        if i < self.len() - 1 {
            res.extend(separator);
        }
    }

    return res;
}

fn Array::contains<T>(Array<T> *self, T element) {
    for i32 i = 0; i < self.len(); i += 1 {
        if self[i] == element {
            return true;
        }
    }

    return false;
}

// Alias for Array::join<T>()
fn Array::implode<T>(Array<T> *self, string separator) {
    return self.join(separator);
}

// Take all the elements of another Array<T> and push them into this Array<T>
fn Array::extend<T>(Array<T> *self, Array<T> *other) {
    for i32 i = 0; i < other.len(); i += 1 {
        self.push(other[i]);
    }
}

fn Array::remove<T>(Array<T> *self, i32 index) -> T {
    if index < 0 || index >= self.size {
        return (T)nil;
    }

    T removedElement = self[index];

    for i32 i = index; i < self.size - 1; i += 1 {
        self[i] = self[i + 1];
    }

    self.size -= 1;

    if self.size < self.capacity / 4 {
        self.resize(self.capacity / 2);
    }

    return removedElement;
}

fn Array::insert<T>(Array<T> *self, i32 index, T element) {
    if index < 0 || index > self.size {
        io::cprintf(
            "Index %ld is out of bounds (must be between 0 and %ld inclusive)\n"
                .color("red")
                .reset(),
            index, self.size
        );
        abort();
    }

    if self.size >= self.capacity {
        self.resize((self.capacity || 1) * 2);
    }

    for i32 i = self.size; i > index; i -= 1 {
        self.elements[i] = self.elements[i - 1];
    }

    self.elements[index] = element;
    self.size += 1;
}

fn Array::map<T>(Array<T> *self, fn *mapping) {
    Array<T> *new_self = Array::with_capacity(self.len());

    for i32 i = 0; i < self.len(); i += 1 {
        new_self.push(mapping(self[i], i));
    }

    return new_self;
}

fn Array::includes<T>(Array<T> *self, T element) {
    for i32 i = 0; i < self.len(); i += 1 {
        if self[i] == element {
            return true;
        }
    }

    return false;
}

fn Array::index<T>(Array<T> *self, T element) {
    for i32 i = 0; i < self.len(); i += 1 {
        if self[i] == element {
            return i;
        }
    }

    return -1;
}

fn Array::sum<T>(Array<T> *self) {
    T sum = 0;

    for i32 i = 0; i < self.len(); i += 1 {
        sum += self.elements[i];
    }

    return sum;
}

fn Array::product<T>(Array<T> *self) {
    T sum = 0;

    for i32 i = 0; i < self.len(); i += 1 {
        sum *= self.elements[i];
    }

    return sum;
}

fn Array::first<T>(Array<T> *self) -> T {
    if self.len() < 1 {
        return (T)nil;
    }

    return self[0];
}

fn Array::last<T>(Array<T> *self) -> T {
    if self.len() < 1 {
        return (T)nil;
    }

    return (T)(self[self.len() - 1]);
}

fn Array::max<T>(Array<T> *self) -> T {
    if self.len() == 0 {
        return (T)nil;
    }

    T max = self[0];

    for i32 i = 1; i < self.len(); i += 1 {
        if self[i] > max {
            max = self[i];
        }
    }

    return max;
}

fn Array::min<T>(Array<T> *self) -> T {
    if self.len() == 0 {
        return (T)nil;
    }

    T min = self[0];

    for i32 i = 1; i < self.len(); i += 1 {
        if self[i] < max {
            min = self[i];
        }
    }

    return min;
}

fn Array::free<T>(Array<T> *self) {
    free(self.elements);
    free((void *)(*self));
    free(self);
}
