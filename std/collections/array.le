use std/runtime/collections/array;
use std/iter/iterator;
use std/vectors;
use std/math;
global pub;

/// Max length of the array string before its elements wrap onto new lines
let Array::MAX_INLINE_LENGTH = 40;

fn Array::truncate(i64[] self) {
    return self.map(i64::truncate);
}

fn Array::promote(i32[] self) {
    return self.map(i32::promote);
}

// Creates a new sized array from a null terminated string
fn Array::from_string(string str) -> char[] {
    i32 length = str.len();
    char[] array = Array::with_capacity(length);

    for i32 i = 0; i < length; i += 1 {
        array.push(str[i]);
    }

    return array;
}

fn Array::slice_to<T>(u8[] self) -> T {
    return *#cast(T *, self.elements);
}

fn Array::read<T>(u8[] self, i32 *offset) -> T {
    return self.slice(*(offset || &0), *(offset || &0) += #size(T)).slice_to<T>();
}

fn Array::to_repr<T, U>(U[] self) -> T[] {
    self.size *= #cast(f32, #size(U)) / #size(T);
    self.capacity *= #cast(f32, #size(U)) / #size(T);
    return #cast(T[], self);
}

fn Array::to_bytes<T>(T[] self) {
    return self.to_repr<u8>();
}

fn Array::bytes(u64 capacity) {
    return Array::with_capacity<u8>(capacity).filled();
}

fn Array::slice_from_raw_parts<T>(u64 size, T *elements) {
    self := #alloc(Array<T>);
    self.size = size;
    self.capacity = size;
    self.elements = elements;
    return self;
}

// Array access is bound checked at runtime
fn Array::to_vec2<T>(T[] self) {
    return Vector2::new(#cast(T, self[0]), #cast(T, self[1]));
}

fn Array::to_vec3<T>(T[] self) {
    return Vector3::new(#cast(T, self[0]), #cast(T, self[1]), #cast(T, self[2]));
}

struct ArrayEnv<T> {
    T[] base,
    u64 start,
    u64 end,
    u64 len
}

fn Array::__iter__<T>(T[] self) -> Iterator<T, DoubleEnded> {
    ArrayEnv<T> env = ArrayEnv {
        base = self,
        start = 0,
        end = self.len(),
        len = self.len()
    };

    return Iterator {
        env = Box::new(env).to_ptr(),
        next = fn(ArrayEnv<T> *env) {
            if env.len != env.base.len() {
                env.end += env.base.len() - env.len;
                env.len = env.base.len();
            }

            if (from := env.start) < env.end {
                env.start += 1;
                return Some(env.base[from]);
            } else {
                return None<T>();
            }
        },
        next_back = fn(ArrayEnv<T> *env) {
            if env.len != env.base.len() {
                env.end += env.base.len() - env.len;
                env.len = env.base.len();
            }

            if env.start < env.end {
                env.end -= 1;
                return Some(env.base[env.end]);
            } else {
                return None<T>();
            }
        }
    };
}

external fn Array::__iter__<T>(T[] self) @alias(Array::iter) -> Iterator<T, DoubleEnded>;

fn Array::iter_ref<T>(T[] self) -> Iterator<T *, DoubleEnded> {
    ArrayEnv<T> env = ArrayEnv {
        base = self,
        start = 0,
        end = self.len(),
        len = self.len()
    };

    return Iterator {
        env = Box::new(env).to_ptr(),
        next = fn(ArrayEnv<T> *env) {
            if env.len != env.base.len() {
                env.end += env.base.len() - env.len;
                env.len = env.base.len();
            }

            if (from := env.start) < env.end {
                env.start += 1;
                return Some(&env.base[from]);
            } else {
                return None<T *>();
            }
        },
        next_back = fn(ArrayEnv<T> *env) {
            if env.len != env.base.len() {
                env.end += env.base.len() - env.len;
                env.len = env.base.len();
            }

            if env.start < env.end {
                env.end -= 1;
                return Some(&env.base[env.end]);
            } else {
                return None<T *>();
            }
        }
    };
}

fn Array::chunks<T>(T[] self, u64 size) {
    return self.iter().chunks(size);
}

fn Array::windows<T>(T[] self, u64 size) {
    return self.iter().windows(size);
}

// Functions emitted as a result of string::split monomorphization for the VLA
external fn `Array.with_capacity.0.2.15.1`(u64 capacity) -> string[];
external fn `Array.push.0.2.15.1`(string[] self, string element);
external fn `Array.resize.0.2.15.1`(string[] self, i32 new_capacity);

// Functions emitted as a result of io::read_file_binary for the VLA
external fn `Array.with_capacity.0.4.1`(u64 capacity) -> u8[];
external fn `Array.resize.0.4.1`(u8[] self, u64 new_capacity);
external fn `Array.filled.0.4.1`(u8[] self) -> u8[];

// Functions emitted as a result of io::read_file_binary for the VLA
external fn `Array.with_capacity.0.15.1`(u64 capacity) -> char[];
external fn `Array.resize.0.15.1`(char[] self, u64 new_capacity);
external fn `Array.filled.0.15.1`(char[] self) -> char[];
