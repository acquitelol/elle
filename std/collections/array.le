use std/runtime/collections/array;
use std/math;
global pub;

fn Array::truncate(i64[] self) {
    return self.map<i32>(i64::truncate);
}

fn Array::promote(i32[] self) {
    return self.map<i64>(i32::promote);
}

// Creates a new sized array from a null terminated string
fn Array::from_string(string str) -> char[] {
    i32 length = str.len();
    char[] array = Array::with_capacity(length);

    for i32 i = 0; i < length; i += 1 {
        array.push(str[i]);
    }

    return array;
}


// from is inclusive, to is exclusive
//
// example:
// Array::range(0, 4) -> [0, 1, 2, 3]
// Array::range(0, 0) -> []
// Array::range(2, 5) -> [2, 3, 4]
fn Array::range(i32 from, i32 to, bool included) -> i32[] {
    i32[] array = Array::with_capacity(to);

    for i32 i = from; i < to + included; i += 1 {
        array.push(i);
    }

    return array;
}

// Functions emitted as a result of string::split monomorphization for the VLA
// must be here so that the compiler doesn't re-monomorphize and cause duplicate symbols
external fn `Array.with_capacity.0.2.15.1`(i32 capacity) -> string[];
external fn `Array.push.0.2.15.1`(string[] self, string element);
external fn `Array.resize.0.2.15.1`(string[] self, i32 new_capacity);
