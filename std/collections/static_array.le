use std/hashes;
namespace __arr__;
global pub;

fn __arr__::len<T, N>(T[N] self) {
    return #len(self);
}

fn __arr__::is_empty<T, N>(T[N] self) {
    return self.len() == 0;
}

fn __arr__::__equals__<T, N>(T[N] self, T[N] other) {
    for i in 0..self.len() {
        if self[i] != other[i] {
            return false;
        }
    }

    return true;
}

fn __arr__::__fmt__<T, N>(T[N] self, u64 nesting) {
    res := "[";

    for u64 i = 0; i < self.len(); i += 1 {
        res <>= self[i].__fmt__(nesting);

        if i != self.len() - 1 {
            res <>= ", ";
        }
    }

    res <>= "]";
    return res;
}

fn __arr__::__iter__<T, N>(T[N] self) {
    return Array::slice_from_raw_parts(self.len(), #cast(T *, self)).iter();
}

external fn __arr__::__iter__<T, N>(T[N] self) @alias(__arr__::iter) -> Iterator<T, DoubleEnded>;

fn __arr__::transpose<T, A, B>(T[A][B] xs) -> T[B][A] {
    T[B][A] res;

    for i in 0..xs.len() {
        for j in 0..xs[0].len() {
            res[j][i] = xs[i][j];
        }
    }

    return res;
}


fn __arr__::mul<T, A, B, C>(T[A][B] a, T[B][C] b) {
    T[A][C] res;

    for i in 0..a.len() {
        for j in 0..b[0].len() {
            sum := 0;

            for k in 0..a[0].len() {
                sum += a[i][k] * b[k][j];
            }

            res[i][j] = sum;
        }
    }

    return res;
}

fn __arr__::__tuple__<T>(T[2] self) {
    return $(self[0], self[1]);
}

fn __arr__::__triple__<T>(T[3] self) {
    return $$(self[0], self[1], self[2]);
}

fn __arr__::__hash__<T, N>(T[N] self, u64 cap) {
    u64 total = 0;

    for u64 i = 0; i < self.len(); i += 1 {
        a := self[i];
        b := self[(i + 1) % self.len()];

        total += a.__hash__(cap) * 31 + b.__hash__(cap);
    }

    return hash::mod(total, cap);
}
