use std/collections/array;
use std/iter/iterator;
use std/limits;
use std/hashes;
use std/math;

global pub;

struct HashSetBucket<T> {
    T value,
    bool full,
    bool deleted
}

fn HashSetBucket::new<T>() {
    let bucket = #alloc(HashSetBucket<T>);
    bucket.full = false;
    bucket.deleted = false;
    return bucket;
}

struct HashSet<T> {
    HashSetBucket<T> *[] table,
    u64 size,
    u64 capacity
}

fn HashSet::__fmt__<T>(HashSet<T> self, i32 nesting) {
    let values = self.values();
    let res = "{";

    for u64 i = 0; i < values.len(); i += 1 {
        res <>= values[i].__fmt__(0);

        if i < values.len() - 1 {
            res <>= ", ";
        }
    }

    res.push('}');
    return res;
}

fn HashSet::with_capacity<T>(u64 initial_capacity) -> HashSet<T> * {
    let set = #alloc(HashSet<T>);

    let capacity = math::next_power_of_2(initial_capacity);
    set.table = Array::with_capacity(capacity);
    set.capacity = capacity;
    set.size = 0;

    for u64 i = 0; i < capacity; i += 1 {
        set.table.push(HashSetBucket::new<T>());
    }

    return set;
}

fn HashSet::with_entries<T>(ElleMeta meta, T first, ...args) -> HashSet<T> * {
    let set = HashSet::with_capacity<T>(4);
    set.add(first);

    for i32 i = 0; i < meta.arity - 1; i += 1 {
        set.add(args.yield(T));
    }

    return set;
}

fn HashSet::new<T>() -> HashSet<T> * {
    return HashSet::with_capacity(4);
}

fn HashSet::add<T>(HashSet<T> *self, T value) -> bool {
    if self.contains(value) {
        return false;
    }

    if self.size >= self.capacity / 2 {
        self.resize(self.capacity * 2);
    }

    u64 idx = value.__hash__(self.capacity);
    let start_idx = idx;

    while true {
        if !self.table[idx].full || self.table[idx].deleted {
            self.table[idx].value = value;
            self.table[idx].full = true;
            self.table[idx].deleted = false;
            self.size += 1;
            return true;
        }

        idx = (idx + 1) % self.capacity;

        if idx == start_idx {
            return false;
        }
    }
}

fn HashSet::remove<T>(HashSet<T> *self, T value) -> bool {
    u64 idx = value.__hash__(self.capacity);
    let start_idx = idx;

    while true {
        if !self.table[idx].full && !self.table[idx].deleted {
            return false;
        }

        if self.table[idx].full && self.table[idx].value == value {
            self.table[idx].full = false;
            self.table[idx].deleted = true;
            self.size -= 1;
            return true;
        }

        idx = (idx + 1) % self.capacity;

        if idx == start_idx {
            return false;
        }
    }
}

fn HashSet::contains<T>(HashSet<T> *self, T value) -> bool {
    u64 idx = value.__hash__(self.capacity);
    let start_idx = idx;

    while true {
        if !self.table[idx].full && !self.table[idx].deleted {
            return false;
        }

        if self.table[idx].full && self.table[idx].value == value {
            return true;
        }

        idx = (idx + 1) % self.capacity;

        if idx == start_idx {
            return false;
        }
    }
}

fn HashSet::size<T>(HashSet<T> *self) -> u64 {
    return self.size;
}

fn HashSet::is_empty<T>(HashSet<T> *self) -> bool {
    return self.size == 0;
}

fn HashSet::resize<T>(HashSet<T> *self, u64 new_capacity) {
    old_table := self.table;

    self.table = Array::with_capacity(new_capacity);
    self.capacity = new_capacity;
    self.size = 0;

    for u64 i = 0; i < self.capacity; i += 1 {
        self.table.push(HashSetBucket::new<T>());
    }

    for u64 i = 0; i < old_table.len(); i += 1 {
        if old_table[i].full {
            $assert(self.add(old_table[i].value));
        }
    }
}

fn HashSet::clear<T>(HashSet<T> *self) {
    self.size = 0;

    for u64 i = 0; i < self.capacity; i += 1 {
        self.table[i].full = false;
        self.table[i].deleted = false;
    }
}

fn HashSet::clone<T>(HashSet<T> *self) -> HashSet<T> * {
    new_set := HashSet::with_capacity(self.capacity);

    for u64 i = 0; i < self.capacity; i += 1 {
        if self.table[i].full {
            $assert(new_set.add(self.table[i].value));
        }
    }

    return new_set;
}

fn HashSet::from<T>(T[] array) -> HashSet<T> * {
    let set = HashSet::new();

    for i := 0; i < array.len(); i += 1 {
        set.add(array[i]);
    }

    return set;
}

struct HashSetEnv<T> {
    HashSet<T> *base,
    u64 i
}

fn HashSet::__iter__<T>(HashSet<T> *self) -> Iterator<T, SingleEnded> {
    HashSetEnv<T> env = HashSetEnv { base = self, i = 0 };

    return Iterator {
        env = Box::new(env).to_ptr(),
        next = fn(HashSetEnv<T> *env) {
            while env.i < env.base.table.len() {
                if env.base.table[env.i].full {
                    value := env.base.table[env.i].value;
                    env.i += 1;
                    return Option::Some(value);
                }
                env.i += 1;
            }
            return Option::None<T>();
        },
        next_back = nil
    };
}

external fn HashSet::__iter__<T>(HashSet<T> *self) @alias(HashSet::iter) -> Iterator<T, SingleEnded>;
external fn HashSet::__iter__<T>(HashSet<T> *self) @alias(HashSet::values) -> Iterator<T, SingleEnded>;
