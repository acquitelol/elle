use std/collections/array;
use std/hashes;
use std/math;

global pub;

const void *NEVER_USED = i32::min();
const void *TOMBSTONE = i32::min() + 1;

struct HashSet<T> {
    T[] table;
    i32 size;
    i32 capacity;
};

fn HashSet::__fmt__<T>(HashSet<T> self, i32 nesting) {
    HashSet<T> temp = self;
    let values = temp.values();
    let res = "{";

    for i32 i = 0; i < values.len(); i += 1 {
        res <>= values[i].__fmt__(0);

        if i < values.len() - 1 {
            res <>= ", ";
        }
    }

    res.push('}');
    return res;
}

fn HashSet::with_capacity<T>(i32 initial_capacity) -> HashSet<T> * {
    let set = #alloc(HashSet<T>);

    let capacity = math::next_power_of_2(initial_capacity);
    set.table = Array::with_capacity(capacity);
    set.capacity = capacity;
    set.size = 0;

    for i32 i = 0; i < capacity; i += 1 {
        set.table.push((T)NEVER_USED);
    }

    return set;
}

fn HashSet::new<T>(ElleMeta meta, ...args) -> HashSet<T> * {
    let set = HashSet::with_capacity(4);

    for i32 i = 0; i < meta.arity; i += 1 {
        set.add(args.yield(T));
    }

    return set;
}

fn HashSet::add<T>(HashSet<T> *self, T value) -> bool {
    if self.contains(value) {
        return false;
    }

    if self.size >= self.capacity / 2 {
        self.resize(self.capacity * 2);
    }

    i32 idx = value.__hash__(self.capacity);
    let start_idx = idx;

    while true {
        if ((void *)self.table[idx] == NEVER_USED) || ((void *)self.table[idx] == TOMBSTONE) {
            self.table[idx] = value;
            self.size += 1;
            return true;
        }

        idx = (idx + 1) & (self.capacity - 1);

        if idx == start_idx {
            return false;
        }
    }
}

fn HashSet::remove<T>(HashSet<T> *self, T value) -> bool {
    i32 idx = value.__hash__(self.capacity);
    let start_idx = idx;

    while true {
        if (void *)self.table[idx] == NEVER_USED {
            return false;
        }

        if ((void *)self.table[idx] != TOMBSTONE) && self.table[idx] == value {
            self.table[idx] = (T)TOMBSTONE;
            self.size -= 1;
            return true;
        }

        idx = (idx + 1) & (self.capacity - 1);

        if idx == start_idx {
            return false;
        }
    }
}

fn HashSet::contains<T>(HashSet<T> *self, T value) -> bool {
    i32 idx = value.__hash__(self.capacity);
    let start_idx = idx;

    while true {
        if (void *)self.table[idx] == NEVER_USED {
            return false;
        }

        if ((void *)self.table[idx] != TOMBSTONE) && self.table[idx] == value {
            return true;
        }

        idx = (idx + 1) & (self.capacity - 1);

        if idx == start_idx {
            return false;
        }
    }
}

fn HashSet::size<T>(HashSet<T> *self) -> i32 {
    return self.size;
}

fn HashSet::is_empty<T>(HashSet<T> *self) -> bool {
    return self.size == 0;
}

fn HashSet::resize<T>(HashSet<T> *self, i32 new_capacity) {
    T[] old_table = self.table;

    self.table = Array::with_capacity(new_capacity);
    self.capacity = new_capacity;
    self.size = 0;

    for i32 i = 0; i < new_capacity; i += 1 {
        self.table.push((T)NEVER_USED);
    }

    for item in old_table {
        if ((void *)item != NEVER_USED) && ((void *)item != TOMBSTONE) {
            self.add(item);
        }
    }
}

fn HashSet::values<T>(HashSet<T> *self) -> T[] {
    let result = Array::with_capacity(self.size);

    for i32 i = 0; i < self.capacity; i += 1 {
        if ((void *)self.table[i] != NEVER_USED) && ((void *)self.table[i] != TOMBSTONE) {
            result.push(self.table[i]);
        }
    }

    return result;
}

fn HashSet::is_full<T>(T element) {
    return ((void *)element != NEVER_USED) && ((void *)element != TOMBSTONE);
}

fn HashSet::clear<T>(HashSet<T> *self) {
    self.size = 0;

    for i32 i = 0; i < self.capacity; i += 1 {
        self.table[i] = (T)NEVER_USED;
    }
}

fn HashSet::clone<T>(HashSet<T> *self) -> HashSet<T> * {
    HashSet<T> *new_set = HashSet::with_capacity(self.capacity);

    for i32 i = 0; i < self.capacity; i += 1 {
        if ((void *)self.table[i] != NEVER_USED) && ((void *)self.table[i] != TOMBSTONE) {
            new_set.add(self.table[i]);
        }
    }

    return new_set;
}

fn HashSet::from<T>(T[] array) -> HashSet<T> * {
    let set = HashSet::new();

    for v in array {
        set.add(v);
    }

    return set;
}
