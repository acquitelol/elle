use std/collections/hashmap;
use std/collections/array;
use std/iter/iterator;
use std/limits;
use std/hashes;
use std/math;

global pub;

struct HashSet<T> {
    HashMap<T, bool> *map
}

fn HashSet::__fmt__<T>(HashSet<T> self) {
    return "{{ {} }".format(self.map.keys().intersperse(", ").collect());
}

fn HashSet::new<T>() -> HashSet<T> * {
    self := #alloc(HashSet<T>);
    self.map = HashMap::new();
    return self;
}

fn HashSet::with_capacity<T>(u64 capacity) -> HashSet<T> * {
    self := #alloc(HashSet<T>);
    self.map = HashMap::with_capacity(capacity);
    return self;
}

fn HashSet::with_entries<T>(ElleMeta meta, T first, ...args) -> HashSet<T> * {
    self := HashSet::with_capacity<T>(4);
    self.add(first);

    for i32 i = 0; i < meta.arity - 1; i += 1 {
        self.add(args.yield(T));
    }

    return self;
}

fn HashSet::add<T>(HashSet<T> *self, T value) -> bool {
    if self.map.contains_key(value) {
        return false;
    }

    self.map[value] = true;
    return true;
}

fn HashSet::remove<T>(HashSet<T> *self, T value) -> bool {
    return self.map.remove(value).is_some();
}

fn HashSet::contains<T>(HashSet<T> *self, T value) -> bool {
    return self.map.contains_key(value);
}

fn HashSet::size<T>(HashSet<T> *self) -> u64 {
    return self.map.size();
}

fn HashSet::is_empty<T>(HashSet<T> *self) -> bool {
    return self.map.size() == 0;
}

fn HashSet::clear<T>(HashSet<T> *self) {
    self.map.clear();
}

fn HashSet::__iter__<T>(HashSet<T> *self) {
    return self.map.keys();
}

external fn HashSet::__iter__<T>(HashSet<T> *self) @alias(HashSet::iter) -> Iterator<T, SingleEnded>;
external fn HashSet::__iter__<T>(HashSet<T> *self) @alias(HashSet::values) -> Iterator<T, SingleEnded>;

fn HashSet::clone<T>(HashSet<T> *self) -> HashSet<T> * {
    new_set := HashSet::with_capacity<T>(self.size());

    for value in self {
        new_set.add(value);
    }

    return new_set;
}

fn HashSet::difference<T>(HashSet<T> *self, HashSet<T> *other) -> HashSet<T> * {
    new_set := HashSet::with_capacity<T>(self.size());

    for value in self {
        if !other.contains(value) {
            $assert(new_set.add(value));
        }
    }

    return new_set;
}

fn HashSet::from<T>(T[] array) -> HashSet<T> * {
    let set = HashSet::new<T>();

    for u64 i = 0; i < array.len(); i += 1 {
        set.add(array[i]);
    }

    return set;
}