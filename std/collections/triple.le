use std/core;
use std/hashes;
global pub;

struct Triple<T, U, V> {
    T x;
    U y;
    V z;
};

fn Triple::__fmt__<T, U, V>(Triple<T, U, V> self, i32 nesting) {
    return string::format(
        "({}, {}, {})",
        self.x.__fmt__(nesting),
        self.y.__fmt__(nesting),
        self.z.__fmt__(nesting)
    );
}

fn Triple::__equals__<T, U, V>(Triple<T, U, V> *self, Triple<T, U, V> *other) {
    return (self.x == other.x) && (self.y == other.y) && (self.z == other.z);
}

fn Triple::__hash__<T, U, V>(Triple<T, U, V> self, i32 capacity) {
    i64 hash_x = self.x.__hash__(capacity);
    i64 hash_y = self.y.__hash__(capacity);
    i64 hash_z = self.z.__hash__(capacity);
    i64 combined = (hash_x * 31 + hash_y) * 31 + hash_z;
    return __internal_hash_mod(combined, capacity);
}

fn Triple::new<T, U, V>(T x, U y, V z) {
    Triple<T, U, V> *triple = #env.allocator.alloc(#size(Triple<T, U, V>));

    triple.x = x;
    triple.y = y;
    triple.z = z;

    return triple;
}

external fn Triple::new<T, U, V>(T x, U y, V z) @alias("$$") -> Triple<T, U, V> *;
