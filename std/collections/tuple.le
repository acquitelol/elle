global pub;

struct Tuple<T, U> {
    T x;
    U y;
};

local fn __internal_out_of_bounds_check(i64 i, i64 min_i, i64 max_i) {
    if i < min_i || i > max_i {
        io::cprintf(
            "Index %ld is out of bounds (must be between %ld and %ld)\n"
                .color("red")
                .reset(),
            i, min_i, max_i
        );

        abort();
    }
}

fn Tuple::__load__<T, U>(Tuple<T, U> *self, i32 i) {
    __internal_out_of_bounds_check(i, 0, 1);

    if i == 0 { return self.x; }
    if i == 1 { return self.y; }
}

fn Tuple::__store__<T, U>(Tuple<T, U> *self, i32 i, void *value) {
    __internal_out_of_bounds_check(i, 0, 1);

    if i == 0 { self.x = (T)value; }
    if i == 1 { self.y = (U)value; }
}

fn Tuple::new<T, U>(T x, U y) {
    Tuple<T, U> *tuple = malloc(#size(Tuple<T, U>));
    *tuple = malloc(#size(Tuple<T, U>));

    tuple.x = x;
    tuple.y = y;

    return tuple;
}

struct Triple<T, U, V> {
    T x;
    U y;
    V z;
};

fn Triple::new<T, U, V>(T x, U y, V z) {
    Triple<T, U, V> *triple = malloc(#size(Triple<T, U, V>));
    *triple = malloc(#size(Triple<T, U, V>));

    triple.x = x;
    triple.y = y;
    triple.z = z;

    return triple;
}

fn Triple::__load__<T, U, V>(Tuple<T, U, V> *self, i32 i) {
    __internal_out_of_bounds_check(i, 0, 2);

    if i == 0 { return self.x; }
    if i == 1 { return self.y; }
    if i == 2 { return self.z; }
}

fn Triple::__store__<T, U, V>(Tuple<T, U, V> *self, i32 i, void *value) {
    __internal_out_of_bounds_check(i, 0, 2);

    if i == 0 { self.x = (T)value; }
    if i == 1 { self.y = (U)value; }
    if i == 2 { self.z = (V)value; }
}
