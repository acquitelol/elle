use std/box;
use std/option;
use std/runtime/collections/array;
use std/type_info;
global pub;

namespace SingleEnded;
namespace DoubleEnded;

struct Iterator<T, AnyEnded> @nofmt {
    // type erasure to prevent super nested chains
    // of iterators having really long generics
    void *env,
    fn(void *) -> Option<T> next,
    // !! nil if iterator is not DoubleEnded !!
    // unfortunately no good way to enforce this
    // than to use an Option<T> but that has its
    // own downsides and isnt always ideal
    fn(void *) -> Option<T> next_back
}

fn Iterator::__fmt__<T, AnyEnded>(Iterator<T, AnyEnded> self, i32 nesting) {
    return "<Iterator({}) at {}>".format(
        TypeInfo::type_of<T>(),
        string::as_string(#cast(void *, self))
    );
}

fn Iterator::next<T, AnyEnded>(Iterator<T, AnyEnded> self) {
    cb := self.next;
    return cb(self.env);
}

fn Iterator::next_back<T>(Iterator<T, DoubleEnded> self) {
    cb := self.next_back;
    return cb(self.env);
}

fn Iterator::empty<T, AnyEnded>() -> Iterator<T, AnyEnded> {
    return Iterator {
        env = nil,
        next = fn() None(),
        next_back = fn() None()
    };
}

fn Iterator::count<T, AnyEnded>(Iterator<T, AnyEnded> self) -> u64 {
    u64 n = 0;

    while self.next().is_some() {
        n += 1;
    }

    return n;
}

fn Iterator::fold<T, U, AnyEnded>(Iterator<T, AnyEnded> self, U initial, fn(U, T) -> U cb) {
    while _, val := self.next() {
        initial = cb(initial, val);
    }

    return initial;
}

fn Iterator::reduce<T, AnyEnded>(Iterator<T, AnyEnded> self, fn(T, T) -> T cb) -> Option<T> {
    exists, first := self.next();

    if !exists {
        return None();
    }

    return Some(self.fold(first, cb));
}

fn Iterator::sum<T, AnyEnded>(Iterator<T, AnyEnded> self) {
    return self.fold(0, fn(acc, cur) acc + cur);
}

fn Iterator::product<T, AnyEnded>(Iterator<T, AnyEnded> self) {
    return self.fold(1, fn(acc, cur) acc * cur);
}

fn Iterator::max<T, AnyEnded>(Iterator<T, AnyEnded> self) -> Option<T> {
    res := None<T>();

    while _, val := self.next() {
        is_some, cur := res;
        if !is_some || val > cur { res = Some(val); }
    }

    return res;
}

fn Iterator::min<T, AnyEnded>(Iterator<T, AnyEnded> self) -> Option<T> {
    res := None<T>();

    while _, val := self.next() {
        is_some, cur := res;
        if !is_some || val < cur { res = Some(val); }
    }

    return res;
}

fn Iterator::nth<T, AnyEnded>(Iterator<T, AnyEnded> self, u64 n) {
    for i := 0; i < n; i += 1 {
        if self.next().is_none() {
            return None<T>();
        }
    }

    return self.next();
}

fn Iterator::last<T, AnyEnded>(Iterator<T, AnyEnded> self) {
    result := None<T>();

    while _, val := self.next() {
        result = Some(val);
    }

    return result;
}

fn Iterator::collect<T, AnyEnded>(Iterator<T, AnyEnded> self) {
    res := [T;];

    while _, val := self.next() {
        res.push(val);
    }

    return res;
}

fn Iterator::single<T>(Iterator<T, DoubleEnded> self) -> Iterator<T, SingleEnded> {
    return Iterator {
        env = self.env,
        next = self.next,
        next_back = nil
    };
}

fn Iterator::find_with<T, U, AnyEnded>(Iterator<T, AnyEnded> self, fn(T, U) -> bool predicate, U arg) {
    while _, val := self.next() {
        if predicate(val, arg) {
            return Some(val);
        }
    }

    return None<T>();
}

fn Iterator::find<T, AnyEnded>(Iterator<T, AnyEnded> self, fn(T) -> bool predicate) {
    return self.find_with(fn(val, predicate) predicate(val), predicate);
}

fn Iterator::any_with<T, U, AnyEnded>(Iterator<T, AnyEnded> self, fn(T, U) -> bool predicate, U arg) {
    while _, val := self.next() {
        if predicate(val, arg) {
            return true;
        }
    }

    return false;
}

fn Iterator::any<T, AnyEnded>(Iterator<T, AnyEnded> self, fn(T) -> bool predicate) {
    return self.any_with(fn(val, predicate) predicate(val), predicate);
}

fn Iterator::all_with<T, U, AnyEnded>(Iterator<T, AnyEnded> self, fn(T, U) -> bool predicate, U arg) {
    while _, val := self.next() {
        if !predicate(val, arg) {
            return false;
        }
    }

    return true;
}

fn Iterator::all<T, AnyEnded>(Iterator<T, AnyEnded> self, fn(T) -> bool predicate) {
    return self.all_with(fn(val, predicate) predicate(val), predicate);
}

fn Iterator::position_with<T, U, AnyEnded>(Iterator<T, AnyEnded> self, fn(T, U) -> bool predicate, U arg) {
    u64 i = 0;

    while _, val := self.next() {
        if predicate(val, arg) {
            return Some(i);
        }

        i += 1;
    }

    return None<u64>();
}

fn Iterator::position<T, AnyEnded>(Iterator<T, AnyEnded> self, fn(T) -> bool predicate) {
    return self.position_with(fn(val, predicate) predicate(val), predicate);
}

fn Iterator::for_each_with<T, Arg, Any, AnyEnded>(Iterator<T, AnyEnded> self, fn(T, Arg) -> Any cb, Arg value) {
    for x in self {
        cb(x, value);
    }
}

fn Iterator::for_each<T, Any, AnyEnded>(Iterator<T, AnyEnded> self, fn(T) -> Any cb) {
    return self.for_each_with(fn(x, cb) cb(x), cb);
}

fn Iterator::flat_map<T, U, AnyEnded>(Iterator<T, AnyEnded> self, fn(T) -> U cb) {
    return self
        .map(cb)
        .map(fn(x) x.__iter__())
        .reduce(fn(acc, it) acc.chain(it))
        .unwrap_or_else(fn() Iterator::empty());
}

fn Iterator::__iter__<T, AnyEnded>(Iterator<T, AnyEnded> self) {
    return self;
}
