use std/iter/core;
global pub;

struct Range<T> {
    T from,
    T to,
    bool inclusive
}

fn Iterator::range<T>(T from, T to, bool inclusive) -> Iterator<T, DoubleEnded> {
    Range<T> range = Range {
        from = from,
        to = to,
        inclusive = inclusive
    };

    return Iterator {
        env = Box::new(range).to_ptr(),
        next = fn(Range<T> *env) {
            if env.from < env.to + env.inclusive {
                let current = env.from;
                env.from += 1;
                return Some(current);
            } else {
                return None<T>();
            }
        },
        next_back = fn(Range<T> *env) {
            if env.from < env.to + env.inclusive {
                env.to -= 1;
                return Some(#cast(T, env.to + env.inclusive));
            } else {
                return None<T>();
            }
        }
    };
}
