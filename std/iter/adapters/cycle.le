use std/iter/core;
global pub;

struct Cycle<T, AnyEnded> {
    Iterator<T, AnyEnded> current,
    fn() -> Iterator<T, AnyEnded> gen
}

fn Iterator::cycle<T, AnyEnded>(
    Iterator<T, AnyEnded> self,
    fn() -> Iterator<T, AnyEnded> gen
) -> Iterator<T, SingleEnded> {
    env: Cycle<T, AnyEnded> = Cycle { current = self, gen };

    return Iterator {
        env = Box::new(env).to_ptr(),
        next = fn(Cycle<T, AnyEnded> *env) {
            if _, val := env.current.next() {
                return Some(val);
            }

            cb := env.gen;
            iter := cb();

            if _, val := iter.next() {
                env.current = iter;
                return Some(val);
            }

            return None<T>();
        },
        next_back = nil
    };
}
