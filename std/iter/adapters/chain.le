use std/iter/core;
global pub;

struct Chain<T, AnyEnded> {
    Iterator<T, AnyEnded> a,
    Iterator<T, AnyEnded> b,
    bool exhausted,
}

fn Iterator::chain<T, AnyEnded>(
    Iterator<T, AnyEnded> a,
    Iterator<T, AnyEnded> b
) -> Iterator<T, AnyEnded> {
    Chain<T, AnyEnded> chain = Chain {
        a = a,
        b = b,
        exhausted = false
    };

    return Iterator {
        env = Box::new(chain).to_ptr(),
        next = fn(Chain<T, AnyEnded> *env) {
            if !env.exhausted {
                val := env.a.next();

                if val.is_some() {
                    return val;
                }

                env.exhausted = true;
            }

            return env.b.next();
        },
        next_back = a.next_back && b.next_back ? fn(Chain<T, AnyEnded> *env) {
            a := *#cast(Iterator<T, DoubleEnded> *, &env.a);
            b := *#cast(Iterator<T, DoubleEnded> *, &env.b);
            val := b.next_back();

            if val.is_some() {
                return val;
            }

            return a.next_back();
        } : nil
    };
}
