use std/iter/core;
global pub;

struct Enumerate<T, AnyEnded> {
    Iterator<T, AnyEnded> base,
    u64 count,
}

fn Iterator::enumerate<T, AnyEnded>(
    Iterator<T, AnyEnded> self
) -> Iterator<(u64, T), SingleEnded> {
    env: Enumerate<T, AnyEnded> = Enumerate { base = self, count = 0 };

    return Iterator {
        env = Box::new(env).to_ptr(),
        next = fn(Enumerate<T, AnyEnded> *env) {
            val := env.base.next();

            if val.is_none() {
                return None<(u64, T)>();
            }

            result := $(env.count, val.unwrap());
            env.count += 1;
            return Some(result);
        },
        next_back = nil,
    };
}
