use std/iter/core;
global pub;

struct Map<T, U, Env, TEnded> {
    Iterator<T, Env, TEnded> base,
    fn(T) -> U cb
}

fn Iterator::map<T, U, Env, TEnded>(
    Iterator<T, Env, TEnded> self,
    fn(T) -> U cb
) -> Iterator<U, Map<T, U, Env, TEnded>, TEnded> {
    Map<T, U, Env, TEnded> map = Map {
        base = self,
        cb = cb
    };

    return Iterator {
        env = Box::new(map),
        next = fn(env) env.base.next().map(env.cb),
        next_back = self.next_back ? fn(env) {
            base := *#cast(Iterator<T, Env, DoubleEnded> *, &env.base);
            return base.next_back().map(env.cb);
        } : nil
    };
}
