use std/iter/core;
global pub;

struct Filter<T, AnyEnded> {
    Iterator<T, AnyEnded> base,
    fn(T) -> bool predicate
}

fn Iterator::filter<T, AnyEnded>
    (Iterator<T, AnyEnded> self,
    fn(T) -> bool predicate
) -> Iterator<T, AnyEnded> {
    Filter<T, AnyEnded> filter = Filter {
        base = self,
        predicate = predicate,
    };

    return Iterator {
        env = Box::new(filter).to_ptr(),
        next = fn(Filter<T, AnyEnded> *env) {
            for ;; {
                val := env.base.next();

                if val.is_none() {
                    return None<T>();
                }

                cb := env.predicate;
                if cb(val.unwrap()) {
                    return val;
                }
            }
        },
        next_back = self.next_back ? fn(Filter<T, AnyEnded> *env) {
            for ;; {
                base := *#cast(Iterator<T, DoubleEnded> *, &env.base);
                val := base.next_back();

                if val.is_none() {
                    return None<T>();
                }

                cb := env.predicate;
                if cb(val.unwrap()) {
                    return val;
                }
            }
        } : nil
    };
}
