use std/iter/core;
global pub;

struct Zip<T, U, AnyEnded> {
    Iterator<T, AnyEnded> a,
    Iterator<U, AnyEnded> b,
}

fn Iterator::zip_internal<T, U, AnyEnded>(
    Iterator<T, AnyEnded> a,
    Iterator<U, AnyEnded> b
) -> Iterator<(T, U), AnyEnded> {
    env: Zip<T, U, AnyEnded> = Zip { a, b };

    return Iterator {
        env = Box::new(env).to_ptr(),
        next = fn(Zip<T, U, AnyEnded> *env) {
            a, b := $(env.a.next(), env.b.next());

            if a.is_none() || b.is_none() {
                return None<(T, U)>();
            }

            return Option::Some($(a!, b!));
        },
        next_back = a.next_back && b.next_back ? fn(Zip<T, U, AnyEnded> *env) {
            a := *#cast(Iterator<T, DoubleEnded> *, &env.a);
            b := *#cast(Iterator<U, DoubleEnded> *, &env.b);
            a, b := $(a.next_back(), b.next_back());

            if a.is_none() || b.is_none() {
                return None<(T, U)>();
            }

            return Option::Some($(a!, b!));
        } : nil
    };
}

fn Iterator::zip<T, U, AnyEnded>(Iterator<T, AnyEnded> self, U other) {
    return self.zip_internal(other.__iter__());
}