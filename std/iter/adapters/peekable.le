use std/iter/iterator;
global pub;

struct Peekable<T, AnyEnded> {
    Iterator<T, AnyEnded> base,
    Box<Option<T>> peeked
}

fn Iterator::peekable<T, AnyEnded>(Iterator<T, AnyEnded> self) -> Iterator<T, AnyEnded> {
    Peekable<T, AnyEnded> peek = Peekable {
        base = self,
        peeked = Box::new(None<T>())
    };

    return Iterator {
        env = Box::new(peek).to_ptr(),
        next = fn(Peekable<T, AnyEnded> *env) {
            if (*env.peeked).is_some() {
                val := *env.peeked;
                *env.peeked = None<T>();
                return val;
            }

            return env.base.next();
        },
        next_back = nil
    };
}

fn Iterator::peek<T, AnyEnded>(Iterator<T, AnyEnded> self) -> Option<T> {
    env := #cast(Peekable<T, AnyEnded> *, self.env);

    if (*env.peeked).is_none() {
        *env.peeked = env.base.next();
    }

    return *env.peeked;
}
