use std/iter/core;
global pub;

struct Once<T> {
    T value,
    bool consumed
}

fn Iterator::once<T>(T value) -> Iterator<T, SingleEnded> {
    Once<T> once = Once {
        value = value,
        consumed = false
    };

    return Iterator {
        env = Box::new(once).to_ptr(),
        next = fn(Once<T> *env) {
            if env.consumed {
                return None<T>();
            } else {
                env.consumed = !env.consumed;
                return Some(env.value);
            }
        },
        next_back = nil
    };
}
