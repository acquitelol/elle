use std/iter/core;
global pub;

struct Chunks<T, AnyEnded> {
    Iterator<T, AnyEnded> base,
    u64 n
}

fn Iterator::chunks<T, AnyEnded>(
    Iterator<T, AnyEnded> self,
    u64 n
) -> Iterator<T[], AnyEnded> {
    env: Chunks<T, AnyEnded> = Chunks { base = self, n };

    return Iterator {
        env = Box::new(env).to_ptr(),
        next = fn(Chunks<T, AnyEnded> *env) {
            res := env.base.take(env.n).collect();
            return res.is_empty() ? None<T[]>() : Some(res);
        },
        next_back = self.next_back ? fn(Chunks<T, AnyEnded> *env) {
            res := env.base.take(env.n).collect();
            return res.is_empty() ? None<T[]>() : Some(res);
        } : nil
    };
}
