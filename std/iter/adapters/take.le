use std/iter/core;
global pub;

struct Take<T, AnyEnded> {
    Iterator<T, AnyEnded> base,
    u64 n
}

fn Iterator::take<T, AnyEnded>(Iterator<T, AnyEnded> self, u64 n) -> Iterator<T, AnyEnded> {
    Take<T, AnyEnded> take = Take {
        base = self,
        n = n
    };

    return Iterator {
        env = Box::new(take).to_ptr(),
        next = fn(Take<T, AnyEnded> *env) {
            if env.n == 0 {
                return None<T>();
            }

            val := env.base.next();

            if val.is_some() {
                env.n -= 1;
            }

            return val;
        },
        next_back = self.next_back ? fn(Take<T, AnyEnded> *env) {
            if env.n == 0 {
                return None<T>();
            }

            base := *#cast(Iterator<T, DoubleEnded> *, &env.base);
            val := base.next_back();

            if val.is_some() {
                env.n -= 1;
            }

            return val;
        } : nil
    };
}
