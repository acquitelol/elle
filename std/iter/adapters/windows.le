use std/iter/core;
global pub;

struct Windows<T, AnyEnded> {
    Iterator<T, AnyEnded> base,
    u64 n,
    T[] buf
}

fn Iterator::windows<T, AnyEnded>(
    Iterator<T, AnyEnded> self,
    u64 n
) -> Iterator<T[], SingleEnded> {
    Windows<T, AnyEnded> windows = Windows {
        base = self,
        n = n,
        buf = []T
    };

    return Iterator {
        env = Box::new(windows).to_ptr(),
        next = fn(Windows<T, AnyEnded> *env) {
            while env.buf.len() < env.n {
                if _, item := env.base.next() {
                    env.buf.push(item);
                } else {
                    return None<T[]>();
                }
            }

            out := env.buf.clone();

            if _, item := env.base.next() {
                env.buf.remove(0);
                env.buf.push(item);
            } else {
                env.buf.clear();
            }

            return Some(out);
        },
        next_back = nil // windows cant be DoubleEnded without full buffering
    };
}
