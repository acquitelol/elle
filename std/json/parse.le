global pub;

fn Array::parse_json_at(char[] self, i32 *i) -> Option<JsonValue> {
    skip_whitespace := fn(char[] self, i32 *i) 
        while *i < self.len() && self[*i].is_whitespace() { *i += 1; };
    skip_whitespace(self, i);
    if *i >= self.len() { return None(); }

    if self[*i].is_digit() || self[*i] == '-' {
        start := *i;
        if self[*i] == '-' { *i += 1; }
        while *i < self.len() && (self[*i].is_digit() || self[*i] == '.') { *i += 1; }
        value := f64::parse(self.slice(start, *i).join(""));
        return Some(JsonValue::Number(value));
    }

    if self[*i].is_alphabetic() {
        start := *i;
        while *i < self.len() && self[*i].is_alphabetic() { *i += 1; }
        value := self.slice(start, *i).join("");
        out := false;

        if value == "null" {
            return Some(JsonValue::Null());
        } else if bool::try_parse(value, &out) {
            return Some(JsonValue::Bool(out));
        }

        return None();
    }

    if self[*i] == '"' {
        *i += 1;
        buf := []char;
    
        while *i < self.len() {
            if self[*i] == '"' {
                *i += 1;
                return Some(JsonValue::String(buf.join("")));
            }
    
            if self[*i] == '\\' {
                *i += 1;
                if *i >= self.len() { return None(); }
                
                buf.push(self[*i]);
                *i += 1;
                continue;
            }
    
            buf.push(self[*i]);
            *i += 1;
        }
    
        return None();
    }

    if self[*i] == '[' {
        *i += 1;
        values := []JsonValue;

        while *i < self.len() {
            skip_whitespace(self, i);
            if *i < self.len() && self[*i] == ']' { *i += 1; break; }

            if _, value := self.parse_json_at(i) {
                values.push(value);
            } else {
                return None();
            }

            skip_whitespace(self, i);
            if *i < self.len() && self[*i] == ',' { *i += 1; continue; }
            if *i < self.len() && self[*i] == ']' { *i += 1; break; }
            return None();
        }

        return Some(JsonValue::Array(values));
    }

    if self[*i] == '{' {
        *i += 1;
        entries := HashMap::new<string, JsonValue>();

        for ;; {
            skip_whitespace(self, i);
            if *i < self.len() && self[*i] == '}' { *i += 1; break; }
            key := self.parse_json_at(i);
            
            if key.is_none_or(fn(value) value.tag != JsonValueKind::String) { 
                return None(); 
            }
            
            key := key.unwrap().as_string();
            skip_whitespace(self, i);

            if *i >= self.len() || self[*i] != ':' { return None(); }
            *i += 1;
            skip_whitespace(self, i);

            if _, value := self.parse_json_at(i) {
                entries[key] = value;
            } else {
                return None();
            }

            skip_whitespace(self, i);
            if *i < self.len() && self[*i] == ',' { *i += 1; continue; }
            if *i < self.len() && self[*i] == '}' { *i += 1; break; }
            return None();
        }

        return Some(JsonValue::Object(entries));
    }

    return None();
}

fn string::parse_json(string self) {
    i := 0;
    
    return Array::from_string(self).parse_json_at(&i)
        .ok_or("Syntax error near '{}' at position {}"
            .format(i < self.len() ? self[i] : '?', i));
}