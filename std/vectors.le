use std/math;
use std/collections/tuple;
use std/collections/triple;

global pub, external;

struct Vector2 {
    f32 x,
    f32 y
}

struct Vector3 {
    f32 x,
    f32 y,
    f32 z
}

fn Vector2::zero() -> Vector2;
fn Vector2::clone(Vector2 self) -> Vector2;
fn Vector2::clone(Vector2 self) @alias(Vector2::__tuple__) -> (f32, f32);
fn Vector2::new(f32 x, f32 y) -> Vector2;
fn Vector2::from(f32 scalar) -> Vector2;
fn Vector2::dot(Vector2 self, Vector2 v2) -> f32;
fn Vector2::cross(Vector2 self, Vector2 v2) -> f32;
fn Vector2::length_sq(Vector2 self) -> f32;
fn Vector2::length(Vector2 self) -> f32;
fn Vector2::add(Vector2 self, Vector2 v2) -> Vector2;
fn Vector2::sub(Vector2 self, Vector2 v2) -> Vector2;
fn Vector2::scale(Vector2 self, f32 scalar) -> Vector2;
fn Vector2::normalize(Vector2 self) -> Vector2;
fn Vector2::rotate(Vector2 self, f32 angle) -> Vector2;
fn Vector2::angle(Vector2 self, Vector2 v2) -> f32;
fn Vector2::new(f32 x, f32 y) @alias(Vector2::xy) -> Vector2;
fn Vector2::__equals__(Vector2 self, Vector2 v2) -> bool;
fn Vector2::get(Vector2 self, u64 i) -> f32;
fn Vector2::set(Vector2 *self, u64 i, f32 value);

fn Vector3::zero() -> Vector3;
fn Vector3::clone(Vector3 self) -> Vector3;
fn Vector3::clone(Vector3 self) @alias(Vector3::__triple__) -> (f32, f32, f32);
!external fn Vector3::__tuple__(Vector3 self) { return $(self.x, self.y); }

fn Vector3::new(f32 x, f32 y, f32 z) -> Vector3;
fn Vector3::from(f32 scalar) -> Vector3;
fn Vector3::dot(Vector3 self, Vector3 v2) -> f32;
fn Vector3::cross(Vector3 self, Vector3 v2) -> Vector3;
fn Vector3::length_sq(Vector3 self) -> f32;
fn Vector3::length(Vector3 self) -> f32;
fn Vector3::add(Vector3 self, Vector3 v2) -> Vector3;
fn Vector3::sub(Vector3 self, Vector3 v2) -> Vector3;
fn Vector3::scale(Vector3 self, f32 scalar) -> Vector3;
fn Vector3::normalize(Vector3 self) -> Vector3;
fn Vector3::rotate(Vector3 self, Vector3 axis, f32 angle) -> Vector3;
fn Vector3::angle(Vector3 self, Vector3 v2) -> f32;
fn Vector3::new(f32 x, f32 y, f32 z) @alias(Vector3::xyz) -> Vector3;
fn Vector3::__equals__(Vector3 self, Vector3 v2) -> bool;
fn Vector3::get(Vector3 self, u64 i) -> f32;
fn Vector3::set(Vector3 *self, u64 i, f32 value);
