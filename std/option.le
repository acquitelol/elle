use std/runtime/libc/io;
global pub;

struct Option<T> @nofmt {
    T __value,
    bool __is_some
}

fn Option::__fmt__<T>(Option<T> self, i32 nesting) {
    if self.is_some() {
        return "Some({})".format(self.unwrap());
    }

    return "None";
}

fn Option::__equals__<T>(Option<T> self, Option<T> other) {
    if self.__is_some != other.__is_some {
        // Some(x) == None
        return false;
    }

    if self.__is_some {
        // Some(x) == Some(y)
        return self.__value == other.__value;
    }

    // None == None
    return true;
}

fn Option::Some<T>(T value) -> Option<T> {
    return Option {
        __value = value,
        __is_some = true
    };
}

fn Option::None<T>() -> Option<T> {
    self := #alloc(Option<T>);
    self.__is_some = false;
    return *self;
}

!external fn __internal_option_throw<T>(Option<T> self, string message, ElleMeta meta) {
    io::fprintf(stderr, "Function %s panicked at %s:%d:%d:\n%s",
        meta.caller, meta.file, meta.line, meta.column,
        message || "No further information was provided."
    );

    libc::abort();
}

// Returns the inner T if the option is some, otherwise aborts with a custom message
fn Option::expect<T>(ElleMeta meta, Option<T> self, string message) -> T {
    if !self.__is_some {
        __internal_option_throw(self, message, meta);
    }

    return self.__value;
}

// Returns the inner T if the option is some, otherwise aborts
fn Option::unwrap<T>(ElleMeta meta, Option<T> self) -> T {
    if !self.__is_some {
        __internal_option_throw(self, "Called `Option::unwrap()` on a `None` value", meta);
    }

    return self.__value;
}

// Returns the inner T if the option is some, otherwise returns the fallback
fn Option::unwrap_or<T>(Option<T> self, T fallback) -> T {
    if !self.__is_some {
        return fallback;
    }

    return self.__value;
}

// Returns true if the option has a value inside
fn Option::is_some<T>(Option<T> self) {
    return self.__is_some;
}

// Returns true if the option has no value inside
fn Option::is_none<T>(Option<T> self) {
    return !self.is_some();
}

fn Option::resolve<T>(Option<T> self, fn *if_some, fn *if_none) {
    if self.is_some() {
        return if_some(self.unwrap());
    }

    return if_none();
}

// Option -> Nilable pointer (allows for `while x := y()`)
fn Option::to_nilable<T>(Option<T> self) {
    if self.is_some() {
        res := #alloc(T);
        *res = self.unwrap();
        return res;
    }

    return nil;
}

fn Option::is_some_and<T>(Option<T> self, fn *cb) {
    if self.is_some() {
        return #cast(bool, cb(self.__value));
    }

    return false;
}

fn Option::is_none_or<T>(Option<T> self, fn *cb) {
    if self.is_some() {
        return #cast(bool, cb(self.__value));
    }

    return true;
}
