use std/runtime/collections/triple;
use std/runtime/collections/tuple;
use std/io;
global pub;

struct Result<T, E> @nofmt {
    bool __is_ok,
    @unused T __value,
    @unused E __error
}

fn Result::__fmt__<T, E>(Result<T, E> self, i32 nesting) {
    if self.is_ok() {
        return "Ok({})".format(self.unwrap());
    }

    return "Err({})".format(self.__error);
}

fn Result::__equals__<T, E>(Result<T, E> self, Result<T, E> other) {
    if self.__is_ok != other.__is_ok {
        // Ok(x) == Err(y)
        return false;
    }

    if self.__is_ok {
        // Ok(x) == Ok(y)
        return self.__value == other.__value;
    } else {
        // Err(x) == Err(y)
        return self.__error == other.__error;
    }
}

fn Result::__tuple__<T, E>(Result<T, E> self) {
    return $(self.__is_ok, self.__value);
}

fn Result::__triple__<T, E>(Result<T, E> self) {
    return $$(self.__is_ok, self.__value, self.__error);
}

fn Result::Ok<T, E>(T value) -> Result<T, E> {
    return Result {
        __is_ok = true,
        __value = value
    };
}

fn Result::Err<T, E>(E error) -> Result<T, E> {
    return Result {
        __is_ok = false,
        __error = error
    };
}

external fn Result::Ok<T, E>(T value) @alias(Ok) -> Result<T, E>;
external fn Result::Err<T, E>(E error) @alias(Err) -> Result<T, E>;

!external fn __internal_result_throw<T, E>(Result<T, E> self, string message, ElleMeta meta) {
    $eprintf("Function {} panicked at {}:{}:{}:\n{}{}{}",
        meta.caller, meta.file, meta.line, meta.column,
        message, message ? ": " : "", self.__error
    );

    libc::abort();
}

/// Returns the inner T if the result is ok, otherwise aborts with a custom message
fn Result::expect<T, E>(ElleMeta meta, Result<T, E> self, string message) -> T {
    if !self.__is_ok {
        __internal_result_throw(self, message, meta);
    }

    return self.__value;
}

/// Returns the inner T if the result is ok, otherwise aborts
fn Result::unwrap<T, E>(ElleMeta meta, Result<T, E> self) -> T {
    if !self.__is_ok {
        __internal_result_throw(self, "Called `Result::unwrap()` on a `Err()` value", meta);
    }

    return self.__value;
}

/// Returns the inner T if the result is ok, otherwise returns the fallback
fn Result::unwrap_or<T, E>(Result<T, E> self, T fallback) -> T {
    if !self.__is_ok {
        return fallback;
    }

    return self.__value;
}

/// Returns true if the result has a value inside
fn Result::is_ok<T, E>(Result<T, E> self) {
    return self.__is_ok;
}

/// Returns true if the result has no value inside
fn Result::is_err<T, E>(Result<T, E> self) {
    return !self.is_ok();
}

fn Result::resolve_with<T, E, U, Out>(
    Result<T, E> self,
    fn(T, U) -> Out if_ok,
    fn(E, U) -> Out if_err,
    U arg
) {
    if self.is_ok() {
        return if_ok(self.__value, arg);
    } else {
        return if_err(self.__error, arg);
    }
}

fn Result::resolve<T, E, Out>(
    Result<T, E> self,
    fn(T) -> Out if_ok,
    fn(E) -> Out if_err
) {
    if self.is_ok() {
        return if_ok(self.__value);
    } else {
        return if_err(self.__error);
    }
}

fn Result::is_ok_and<T, E>(Result<T, E> self, fn(T) -> bool cb) {
    if self.is_ok() {
        return cb(self.__value);
    } else {
        return false;
    }
}

fn Result::is_ok_or<T, E>(Result<T, E> self, fn(E) -> bool cb) {
    if self.is_ok() {
        return true;
    } else {
        return cb(self.__error);
    }
}

fn Result::is_err_and<T, E>(Result<T, E> self, fn(E) -> bool cb) {
    if self.is_ok() {
        return false;
    } else {
        return cb(self.__error);
    }
}

fn Result::is_err_or<T, E>(Result<T, E> self, fn(T) -> bool cb) {
    if self.is_ok() {
        return cb(self.__value);
    } else {
        return true;
    }
}

fn Result::map_with<T, E, U, Out>(Result<T, E> self, fn(T, U) -> Out cb, U arg) {
    if self.is_ok() {
        return Result::Ok<Out, E>(cb(self.__value, arg));
    } else {
        return Result::Err<Out, E>(self.__error);
    }
}

fn Result::map<T, E, Out>(Result<T, E> self, fn(T) -> Out cb) {
    return self.map_with(fn(val, cb) cb(val), cb);
}

fn Result::map_err_with<T, E, U, Out>(Result<T, E> self, fn(E, U) -> Out cb, U arg) {
    if !self.is_ok() {
        return Result::Err<T, Out>(cb(self.__error, arg));
    } else {
        return self;
    }
}

fn Result::map_err<T, E, Out>(Result<T, E> self, fn(E) -> Out cb) {
    return self.map_err_with(fn(err, cb) cb(err), cb);
}
