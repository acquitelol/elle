use std/runtime/collections/array;
use std/runtime/libc/io;
use std/iter/iterator;
use std/libc/string;
global pub, external;

fn string::is_empty(string self) -> bool;
fn string::equals(string self, string other) -> bool;
fn string::equals(string self, string other) @alias(string::__equals__) -> bool;
fn string::contains(ElleMeta meta, string self, ...args) -> bool;
fn string::find(ElleMeta meta, string self, ...args) -> i64;
fn string::count(string self, char needle) -> i32;
fn string::starts_with(string self, string prefix) -> bool;
fn string::ends_with(string self, string suffix) -> bool;
fn string::default(string self, string default) -> string;
fn string::to_upper(string self) -> string;
fn string::to_lower(string self) -> string;
fn string::split(string self, string delimiter) -> string[];
fn string::split(string self, string delimiter) @alias(string::explode) -> string[];
fn string::first(string self) -> char;
fn string::last(string self) -> char;

// Note: these are null terminated strings, which means this
// function returns a CLONE of the slice, NOT a string view
fn string::slice(string self, i32 start, i32 end) -> string;

// Concatenates all of the arguments into 1 final string
//
// examples:
//
// "a".concat("b") == "ab"
// string::concat("me", "ow") == "meow"
fn string::concat(ElleMeta meta, ...args) -> string;

// Concatenates all of the strings provided and then finally reassigns
// the original string to the new string
//
// examples:
//
// string a = "a";
// a.extend("b");
// a == "ab";
//
// string a = "me";
// string::extend(a, "ow");
// a == "meow"
fn string::extend(ElleMeta meta, string *self, ...args);
fn string::clone(string self) -> string;
fn string::color(string self, string color) -> string;
fn string::reset(string self) -> string;
fn string::capitalize(string self);
fn string::replace(string self, string needle, string replacement) -> string;
fn string::repeat(string self, i32 count) -> string;
fn string::insert(string *self, i32 index, char c);
fn string::pop(string *self) -> char;
fn string::push(string *self, char c);

// !! Do not use this unless you know what you're doing !!
// If you want to turn a value of arbitrary type to a string
// please use string::as_string or string::as_string_wrapped
fn __to_string(string ty, i64 args, bool wrap) -> string;

fn string::as_string(ElleMeta meta, ...args) -> string;
fn string::as_string_wrapped(ElleMeta meta, ...args) -> string;

// !! Do not use this unless you know what you're doing !!
// If you want to format arguments of arbitrary types
// into a new string, use string::format() instead
fn __internal_fmt(string fmt, ElleMeta meta, i64 args) -> string;

// Internal formatting function that does not automatically run
// parameters through their formatter (no @fmt attribute)
fn string::__internal_formatter_do_not_use_unless_you_know_what_youre_doing__(ElleMeta meta, string fmt, ...args) -> string;

// Safe formatter
fn string::format(ElleMeta meta, string fmt, ...args) @fmt -> string;

fn string::ascii_lower() -> string;
fn string::ascii_upper() -> string;
fn string::ascii_numerics() -> string;

struct StringEnv {
    string base,
    u64 start,
    u64 end
}

!external fn string::__iter__(string self) -> Iterator<char, DoubleEnded> {
    env := StringEnv { base = self, start = 0, end = self.len() };

    return Iterator {
        env = Box::new(env).to_ptr(),
        next = fn(StringEnv *env) {
            if (from := env.start) < env.end {
                env.start += 1;
                return Some(env.base[from]);
            } else {
                return None<char>();
            }
        },
        next_back = fn(StringEnv *env) {
            if env.start < env.end {
                env.end -= 1;
                return Some(env.base[env.end]);
            } else {
                return None<char>();
            }
        }
    };
}

external fn string::__iter__(string self) @alias(string::iter) -> Iterator<char, DoubleEnded>;
