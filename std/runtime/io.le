use std/runtime/string;
use std/core;
global pub;

const i64 __internal_EOF = -1;

!pub fn __print(i64 args, ElleMeta meta, bool wrap, bool full, bool newline) {
    for let i = 0; i < meta.arity; i += 1 {
        let ty = meta.types[i];
        let expr = meta.exprs[i];
        let res = __to_string("string", args, wrap && ty == "string");

        if full {
            io::cprintf(
                "[%s:%d:%d] %s %s = %s\n",
                meta.file, meta.line, meta.column, ty, expr, res
            );
        } else {
            io::cprintf("%s", res);
        }
    }

    if newline {
        io::putchar('\n');
    }
}

!pub fn __err(void *args, ElleMeta meta, bool newline) {
    let stderr = libc::fdopen(2, "w");
    let fmt = "\x1b[31m[ERROR]: %s\x1b[0m";
    let error = "";

    for let i = 0; i < meta.arity; i += 1 {
        string ty = meta.types[i];
        string expr = meta.exprs[i];
        string res = __to_string("string", args, false);

        error <>= res;
    }

    io::fprintf(stderr, fmt, error);

    if newline {
        io::fprintf(stderr, "\n");
    }
}

fn io::dbg(ElleMeta meta, ...args) @fmt {
    __print(args, meta, true, true, false);
}

fn io::print(ElleMeta meta, ...args) @fmt {
    __print(args, meta, false, false, false);
}

fn io::println(ElleMeta meta, ...args) @fmt {
    __print(args, meta, false, false, true);
}

fn io::eprint(ElleMeta meta, ...args) @fmt {
    __err(args, meta, false);
}

fn io::eprintln(ElleMeta meta, ...args) @fmt {
    __err(args, meta, true);
}

fn io::printf(ElleMeta meta, string fmt, ...args) @fmt {
    for let i = 0; i < meta.arity; i += 1 {
        meta.types[i] = "string";
    }

    io::println(__internal_fmt(fmt, meta, args));
}

fn io::eprintf(ElleMeta meta, string fmt, ...args) @fmt {
    for let i = 0; i < meta.arity; i += 1 {
        meta.types[i] = "string";
    }

    io::eprintln(__internal_fmt(fmt, meta, args));
}

fn io::panic(ElleMeta meta, string fmt, ...args) @fmt {
    for let i = 0; i < meta.arity; i += 1 {
        meta.types[i] = "string";
    }

    io::println(
        "Fatal error in function {}:\n[{}:{}:{}] "
            .format(meta.caller, meta.file, meta.line, meta.column)
            .color("red"),
        __internal_fmt(fmt, meta, args)
    );

    libc::abort();
}

fn io::die(ElleMeta meta) {
    io::eprintf(
        "[{}:{}:{}] Something has gone extremely wrong with no explanation.",
        meta.file, meta.line, meta.column
    );

    libc::abort();
}

fn io::todo(ElleMeta meta, string message) {
    let parsed = message ? ": {}".format(message) : "";

    io::eprintf(
        "[{}:{}:{}] {}: not yet implemented{}",
        meta.file, meta.line, meta.column, meta.caller, parsed
    );

    libc::abort();
}

fn io::unimplemented(ElleMeta meta) {
    io::eprintf(
        "[{}:{}:{}] {}: not yet implemented",
        meta.file, meta.line, meta.column, meta.caller
    );

    libc::abort();
}


fn io::assert(ElleMeta meta, bool condition, ...args) {
    if !condition {
        let parsed = meta.arity >= 2
            ? args.yield(string)
            : "No additional information was specified.";

        io::eprintf(
            "[{}:{}:{}] in function `{}`:\nAssertion `{}` failed.\n{}",
            meta.file, meta.line, meta.column, meta.caller, meta.exprs[0],
            parsed.color("italic").reset()
        );

        libc::abort();
    }
}

fn io::input(string message) -> string {
    let buf = #alloc(char, 4096);

    io::print(message);
    io::fgets(buf, 4096, __internal_stdin);

    // I would rather O(n) than O(2n)
    let length = buf.len();

    buf[buf.len() - 1] = '\0';
    let result = #alloc(char, buf.len() + 1);
    strcpy(result, buf);

    return result;
}

fn io::read_to_string(string path) -> string {
    file := io::fopen(path, "rb");
    defer io::fclose(file);
    io::assert(file, "Failed to open file {}".format(path));

    io::fseek(file, 0, 2);
    file_size := io::ftell(file);
    io::fseek(file, 0, 0);

    data := Array::with_capacity<char>(file_size + 1).filled();
    read_size := io::fread(data.elements, #size(char), file_size, file);

    data.resize(read_size);
    data.size = read_size;
    data.elements[read_size] = 0;

    return data.elements;
}

fn io::read_file_binary(string path) -> u8[] {
    file := io::fopen(path, "rb");
    defer io::fclose(file);
    io::assert(file, "Failed to open file {}".format(path));

    io::fseek(file, 0, 2);
    file_size := io::ftell(file);
    io::fseek(file, 0, 0);

    data := Array::with_capacity<u8>(file_size).filled();
    read_size := io::fread(data.elements, #size(u8), file_size, file);

    data.resize(read_size);
    data.size = read_size;

    return data;
}

fn io::write_to_file(string path, string content) -> bool {
    let file = io::fopen(path, "w");
    defer io::fclose(file);

    if !file {
        return false;
    }

    let size = io::fwrite(content, #size(char), content.len(), file);

    if size != content.len() {
        return false;
    }

    return true;
}
