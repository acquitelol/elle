namespace __clean_ptr__;
namespace __void_ptr__;
namespace __ptr__;
global pub;

!pub fn __internal_hash_mod<T, U>(T self, U other) {
    return #cast(u64, (self % other + other) % other);
}

fn string::__hash__(string self, u64 capacity) {
    u64 hash = 5381;

    for u64 i = 0; i < self.len(); i += 1 {
        char c = self[i];
        hash = (hash * 33 + c) % capacity;
    }

    return __internal_hash_mod(hash, capacity);
}

fn __void_ptr__::__hash__(void *self, u64 capacity) {
    return __internal_hash_mod(#cast(u64, self), capacity);
}

fn char::__hash__(char self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn bool::__hash__(bool self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn i8::__hash__(i8 self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn i16::__hash__(i16 self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn i32::__hash__(i32 self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn i64::__hash__(i64 self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn u8::__hash__(u8 self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn u16::__hash__(u16 self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn u32::__hash__(u32 self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn u64::__hash__(u64 self, u64 capacity) {
    return __internal_hash_mod(self, capacity);
}

fn f32::__hash__(f32 self, u64 capacity) {
    return __internal_hash_mod(*#cast(i32 *, &self), capacity);
}

fn f64::__hash__(f64 self, u64 capacity) {
    return __internal_hash_mod(*#cast(i64 *, &self), capacity);
}
