use std/libc/mem;
global pub;

// used to force stack allocated pointers to be pushed to the stack
// and not be optimized into registers so that the GC can detect
// them as a root when scanning the stack for valid roots
fn __internal_gc_noop(void *x) {}

struct __internal_ElleGC_Header @nofmt {
    bool marked,
    i32 size,
    void *data
}

struct __internal_ElleGC_HeaderNode @nofmt {
    __internal_ElleGC_Header *header,
    __internal_ElleGC_HeaderNode *next
}

struct GCAllocator @nofmt {
    u64 total_size,                    // total allocated memory
    u64 threshold,                     // threshold until collection
    u64 objects,                       // number of allocated objects
    __internal_ElleGC_HeaderNode *head // linked list to track allocations
}

const GCAllocator::MIN_THRESHOLD = 32 * 1024;
const GCAllocator::GROWTH_FACTOR = 2;

fn __internal_ElleGC_Header::new(i32 size) {
    __internal_ElleGC_Header *self = mem::malloc(#size(__internal_ElleGC_Header));

    self.marked = false;
    self.size = size;
    self.data = mem::malloc(size);

    return self;
}

fn GCAllocator::new() {
    GCAllocator *self = mem::malloc(#size(GCAllocator));

    self.total_size = 0;
    // start with a threshold bigger than minimum
    // allow the gc to bring it down to min if necessary
    self.threshold = GCAllocator::MIN_THRESHOLD * 4;
    self.objects = 0;
    self.head = nil;

    return self;
}

!pub fn GCAllocator::find(GCAllocator *self, void *ptr) {
    current := self.head;

    while current {
        data := current.header.data;

        if ptr >= data && ptr < data + current.header.size {
            return current.header;
        }

        current = current.next;
    }

    return nil;
}

!pub fn GCAllocator::__internal_mark_region(GCAllocator *self, void **start, void **end) {
    while start < end {
        ptr := *start;

        // pointers tend to be pretty large; this is not a vm
        if #cast(bool, ptr) && ptr > 0x1000000  {
            block := self.find(ptr);

            // only mark if not already marked because
            // recursively marking more is expensive
            if #cast(bool, block) && !block.marked {
                block.marked = true;

                self.__internal_mark_region(
                    block.data,
                    block.data + block.size
                );
            }
        }

        start += 1; // to mitigate potential misalignment
    }
}

fn GCAllocator::mark(GCAllocator *self) {
    let current = self.head;
    while current {
        current.header.marked = false;
        current = current.next;
    }

    // scan the stack for roots
    self.__internal_mark_region(#cast(void **, &0), #env.stack_top);
}

fn GCAllocator::sweep(GCAllocator *self) {
    __internal_ElleGC_HeaderNode *prev = nil;
    __internal_ElleGC_HeaderNode *node = self.head;

    while node {
        if !node.header.marked {
            if prev {
                prev.next = node.next;
            } else {
                self.head = node.next;
            }

            self.total_size -= node.header.size;
            self.objects -= 1;
            mem::free(node.header.data);
            mem::free(node.header);

            __internal_ElleGC_HeaderNode *next = node.next;
            mem::free(node);
            node = next;
        } else {
            prev = node;
            node = node.next;
        }
    }
}

fn GCAllocator::collect(GCAllocator *self) {
    before_size := self.total_size;

    // garbage collection is a simple mark & sweep algorithm
    // --
    // its currently just a naive stop-the-world approach
    // but this is relatively ok because the collection is
    // fast enough. i tried to make a version of this using
    // multi-threading but i found no way to keep it simple
    // (it would need to be a generational garbage collector
    // and that's out of the scope of what i'm willing to do
    // right now) maybe soon ill try to refactor this to alloc
    // and free in bulk to prevent many tiny mallocs which
    // surely are quite slow compared to a bump allocator
    // or arena allocator or something along those lines
    self.mark();
    self.sweep();

    after_size := self.total_size;
    freed_size := before_size - after_size;

    if before_size > 0 {
        ratio := freed_size * 100 / before_size;

        if ratio < 25 {
            self.threshold *= GCAllocator::GROWTH_FACTOR;
        } else if ratio > 75 {
            self.threshold /= GCAllocator::GROWTH_FACTOR;

            if self.threshold < GCAllocator::MIN_THRESHOLD {
                self.threshold = GCAllocator::MIN_THRESHOLD;
            }
        }
    }
}

fn GCAllocator::alloc(GCAllocator *self, i32 size) {
    if self.total_size + size > self.threshold {
        self.collect();
    }

    let header = __internal_ElleGC_Header::new(size);

    __internal_ElleGC_HeaderNode *node = mem::malloc(#size(__internal_ElleGC_HeaderNode));
    node.header = header;
    node.next = self.head;
    self.head = node;

    self.total_size += size;
    self.objects += 1;

    return header.data;
}

fn GCAllocator::realloc(GCAllocator *self, void *ptr, i32 new_size) {
    if !ptr {
        return self.alloc(new_size);
    }

    let current = self.head;
    __internal_ElleGC_HeaderNode *prev = nil;

    while current {
        if current.header.data == ptr {
            current.header.data = mem::realloc(current.header.data, new_size);
            self.total_size = self.total_size - current.header.size + new_size;
            current.header.size = new_size;
            return current.header.data;
        }

        prev = current;
        current = current.next;
    }

    return self.alloc(new_size);
}

fn GCAllocator::free_self(GCAllocator *self) {
    __internal_ElleGC_HeaderNode *node = self.head;

    while node {
        let next = node.next;

        mem::free(node.header.data);
        mem::free(node.header);
        mem::free(node);

        node = next;
    }

    mem::free(self);
}
