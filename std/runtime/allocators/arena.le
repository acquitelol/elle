use std/libc/mem;
global pub;

!pub fn __internal_alloc_align8(i64 n) {
    return (n + 7) & ~7;
}

struct __internal_Arena @nofmt {
    void *buffer,
    i64 size,
    i64 used,
    __internal_Arena *next
}

struct ArenaAllocator @nofmt {
    __internal_Arena *current, // singly linked list
    i64 chunk_size,
    i64 min_chunk_size
}

fn __internal_Arena::new(i64 size) {
    __internal_Arena *arena = mem::malloc(#size(__internal_Arena));

    arena.buffer = mem::malloc(size);
    arena.size = size;
    arena.used = 0;
    arena.next = nil;

    return arena;
}

fn ArenaAllocator::new() {
    ArenaAllocator *self = mem::malloc(#size(ArenaAllocator));

    self.chunk_size = 64 * 1024; // 64kb chunks
    self.min_chunk_size = 1024;  // 1kb minimum
    self.current = __internal_Arena::new(self.chunk_size);

    return self;
}

fn ArenaAllocator::alloc(ArenaAllocator *self, i64 _size) {
    let size = __internal_alloc_align8(_size);

    // if size is larger than chunk size
    // create dedicated arena
    if size > self.chunk_size {
        let arena = __internal_Arena::new(size + #size(i64));
        *#cast(i64 *, arena.buffer) = size;
        arena.next = self.current;
        self.current = arena;
        self.current.used = size;
        return self.current.buffer + #size(i64);
    }

    // if arena doesnt have enough space create a new one
    if __internal_alloc_align8(self.current.used) + size + #size(i64) > self.current.size {
        let arena = __internal_Arena::new(self.chunk_size);
        arena.next = self.current;
        self.current = arena;
    }

    // alloc from current arena
    let offset = __internal_alloc_align8(self.current.used);
    let ptr = #cast(void *, self.current.buffer) + offset;
    *#cast(i64 *, ptr) = size;
    self.current.used = offset + size + #size(i64);
    return ptr + #size(i64);
}

fn ArenaAllocator::realloc(ArenaAllocator *self, void *ptr, i64 _new_size) {
    new_size := __internal_alloc_align8(_new_size);

    // if nil is passed assume its an allocation instead of reallocation
    if !ptr {
        return self.alloc(new_size);
    }

    // copy memory from old buffer to new buffer
    old_size := *#cast(i64 *, ptr - #size(i64));
    copy_size := old_size < new_size ? old_size : new_size;
    new_ptr := self.alloc(new_size);
    mem::memcpy(new_ptr, ptr, copy_size);

    // do NOT free, managed by arena allocator
    return new_ptr;
}

fn ArenaAllocator::free_self(ArenaAllocator *self) {
    let current = self.current;

    while current {
        let next = current.next;
        mem::free(current.buffer);
        mem::free(current);
        current = next;
    }

    mem::free(self);
}
