use std/runtime/allocators/__internal__;
use std/libc/mem;
global pub;

fn ArbitraryAllocator::new() {
    ArbitraryAllocator *self = mem::malloc(#size(ArbitraryAllocator));
    return self;
}

// Fallback if an allocator is missing a method
fn ArbitraryAllocator::noop() {
    return nil;
}

fn ArbitraryAllocator::alloc(ArbitraryAllocator *self, i64 size) -> void * {
    temp := self.alloc;
    return temp(self.inner, size);
}

fn ArbitraryAllocator::realloc(ArbitraryAllocator *self, void *ptr, i64 new_size) -> void * {
    temp := self.realloc;
    return temp(self.inner, ptr, new_size);
}

fn ArbitraryAllocator::free(ArbitraryAllocator *self, void *ptr) {
    temp := self.free;
    temp(self.inner, ptr);
}

fn ArbitraryAllocator::free_self(ArbitraryAllocator *self) {
    temp := self.free_self;
    temp(self.inner);
    mem::free(#env.allocator);
}
