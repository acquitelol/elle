use std/runtime/collections/array;
use std/runtime/string;

global pub;

fn string::split(string self, string delimiter) -> string[] {
    let parts = Array::with_capacity(10);

    if delimiter.len() == 0 {
        return parts;
    }

    let start = 0;
    for let i = 0; i <= self.len() - delimiter.len(); i += 1 {
        let is_match = true;

        for let j = 0; j < delimiter.len(); j += 1 {
            if self[i + j] != delimiter[j] {
                is_match = false;
                break;
            }
        }

        if is_match {
            parts.push(self.slice(start, i));
            start = i + delimiter.len();
            i = start - 1;
        }
    }

    if start < self.len() {
        parts.push(self.slice(start, self.len()));
    }

    return parts;
}
