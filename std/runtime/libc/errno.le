global pub, external;

fn perror(string s);
fn strerror(i32 errno) -> string;
fn __error() -> i32 *;
fn __errno_location() -> i32 *;

!external fn __internal_get_errno() @cfg(target = "macos") {
    return __error();
}

!external fn __internal_get_errno() @cfg(target = "linux") {
    return __errno_location();
}

let io::errno = __internal_get_errno();

!external fn os_get_last_error() -> string {
    return strerror(*io::errno);
}