namespace libc;
namespace io;

global pub, external;
namespace FILE;

fn fdopen(i64 descriptor, string mode) @alias(libc::fdopen) -> FILE *;
fn printf(string formatter, ...) @alias(io::cprintf) -> i32;
fn fprintf(FILE *fd, string formatter, ...) @alias(io::fprintf) -> i32;
fn sprintf(string str, string formatter, ...) @alias(io::sprintf) -> i32;
fn snprintf(string str, i32 size, string formatter, ...) @alias(io::snprintf) -> i32;

fn fscanf(FILE *stream, string format, ...) @alias(io::fscanf) -> i32;
fn scanf(string format, ...) @alias(io::scanf) -> i32;
fn sscanf(string str, string format, ...) @alias(io::sscanf) -> i32;

fn fgetc(FILE *stream) @alias(io::fgetc) -> i32;
fn fgets(string str, i32 n, i64 stream) @alias(io::fgets) -> string;
fn fputc(char character, i64 stream) @alias(io::fputc) -> i32;
fn fputs(string str, i64 stream) @alias(io::fputs) -> i32;

fn fflush(FILE *stream) @alias(io::fflush) -> i32;

fn getc(FILE *stream) @alias(io::getc) -> i32;
fn getchar() @alias(io::getchar) -> i32;
fn gets(string str) @alias(io::gets) -> string;

fn putc(char character, i64 stream) @alias(io::putc) -> i32;
fn putchar(char character) @alias(io::putchar) -> i32;
fn puts(string str) @alias(io::puts) -> i32;

fn open(string pathname, i32 flags, ...) @alias(io::open) -> i32;
fn access(string pathname, i32 flags) @alias(io::access) -> i32;
fn close(i32 fd) @alias(io::close) -> i32;

fn fopen(string filename, string mode) @alias(io::fopen) -> i64;
fn fclose(FILE *stream) @alias(io::fclose) -> i32;
fn fread(void *ptr, i64 size, i64 nmemb, FILE *stream) @alias(io::fread) -> i64;
fn fwrite(void *ptr, i64 size, i64 nmemb, FILE *stream) @alias(io::fwrite) -> i64;
fn ftell(FILE *stream) @alias(io::ftell) -> i64;
fn fseek(FILE *stream, i64 offset, i32 whence) @alias(io::fseek) -> i32;
fn remove(string path) @alias(io::remove) -> i32;
