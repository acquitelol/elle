use std/runtime/collections/triple;
use std/runtime/collections/tuple;
use std/runtime/libc/io;
use std/libc/mem;
use std/option;
use std/core;
global pub;

struct Array<T> @nofmt {
    u64 size,
    u64 capacity,
    T *elements
}

!pub fn __internal_array_bounds_check(string file, i32 line, i32 col, u64 i, u64 length) {
    if i + 1 > length {
        io::cprintf(
            "[%s:%d:%d] ERROR: Index %lu is out of bounds for array length %lu\n",
            file, line, col, i, length
        );

        libc::abort();
    }
}

fn Array::__fmt__<T>(Array<T> self, i32 nesting) -> string {
    // the number of ", " in the array + everything else
    total_length := (self.len() - 1) * 2;
    inline_parts := []string;

    for u64 i = 0; i < self.len(); i += 1 {
        s := self[i].__fmt__(nesting);
        inline_parts.push(s);
        total_length += s.len();

        if total_length >= Array::MAX_INLINE_LENGTH {
            break; // we already cant inline it
        }
    }

    if total_length < Array::MAX_INLINE_LENGTH {
        return "[{}]".format(inline_parts.join(", "));
    }

    base_indent := " ".repeat(nesting * 4);
    child_indent := base_indent <> "    ";
    base_indent_arr := Array::from_string(base_indent);

    result := ['[', '\n'];
    result.extend(base_indent_arr);

    for u64 i = 0; i < self.len(); i += 1 {
        if i > 0 {
            result.push(',');
            result.push('\n');
            result.extend(base_indent_arr);
        }

        s := i < inline_parts.len()
            ? inline_parts[i]
            : self[i].__fmt__(nesting);

        indented := s
            .split("\n")
            .map_with(fn(line, x) "{}{}".format(x, line), child_indent)
            .join("\n");

        for u64 j = 0; j < indented.len(); j += 1 {
            result.push(indented[j]);
        }
    }

    result.push('\n');
    result.extend(base_indent_arr);
    result.push(']');
    result.push('\0');
    return result.elements;
}

fn Array::__load__<T>(ElleMeta meta, T[] self, u64 i) {
    __internal_array_bounds_check(meta.file, meta.line, meta.column, i, self.len());
    return self.elements[i];
}

fn Array::__load_ref__<T>(ElleMeta meta, T[] self, u64 i) -> T * {
    __internal_array_bounds_check(meta.file, meta.line, meta.column, i, self.len());
    return &self.elements[i];
}

fn Array::__store__<T>(ElleMeta meta, T[] self, u64 i, T value) {
    __internal_array_bounds_check(meta.file, meta.line, meta.column, i, self.len());
    self.elements[i] = value;
}

fn Array::get<T>(ElleMeta meta, T[] self, u64 i) -> Option<T> {
    if i + 1 > self.size {
        return None();
    }

    return Some(self.elements[i]);
}

fn Array::get_ref<T>(ElleMeta meta, T[] self, u64 i) -> Option<T *> {
    if i + 1 > self.size {
        return None();
    }

    return Some(&self.elements[i]);
}

fn Array::__len__<T>(T[] self) -> u64 {
    return self.size;
}

fn Array::len<T>(T[] self) -> u64 {
    return self.size;
}

fn Array::__equals__<T, U>(T[] self, U[] other) -> bool {
    // If the pointers are the same (nil == nil)
    if #cast(void *, self) == #cast(void *, other) {
        return true;
    }

    // If one is nil
    if #cast(void *, self) == nil || #cast(void *, other) == nil
        || self.len() != other.len() // If lengths don't match
    {
        return false;
    }

    if !self.is_empty() && !other.is_empty() {
        if self[0] != other[0] {
            return false; // If the types don't match
        }
    }

    for let i = 0; i < self.len(); i += 1 {
        if self[i] != other[i] {
            return false; // Deep equality
        }
    }

    return true;
}

fn Array::__tuple__<T>(T[] self) {
    return $(self[0], self[1]);
}

fn Array::__triple__<T>(T[] self) {
    return $$(self[0], self[1], self[2]);
}

fn Array::is_empty<T>(T[] self) -> bool {
    return self.size == 0;
}

fn Array::with_capacity<T>(u64 initialCapacity) -> T[] {
    T[] array = #alloc(Array<T>);

    array.elements = #alloc(T, initialCapacity);
    array.size = 0;
    array.capacity = initialCapacity;

    return array;
}

fn Array::new<T>(ElleMeta meta, ...args) -> T[] {
    T[] array = Array::with_capacity(2);

    for i32 i = 0; i < meta.arity; i += 1 {
        array.push(args.yield(T));
    }

    return array;
}

fn Array::resize<T>(T[] self, i32 newCapacity) {
    self.elements = #realloc(self.elements, T, newCapacity);
    self.capacity = newCapacity;
}

fn Array::push<T>(T[] self, T element) {
    while self.size >= self.capacity {
        self.resize((self.capacity || 1) * 2);
    }

    self.elements[self.size] = element;
    self.size += 1;
}

fn Array::pop<T>(T[] self) -> Option<T> {
    if self.is_empty() {
        return Option::None();
    }

    last := self.elements[self.size - 1];
    res := Option::Some(last);
    self.size -= 1;

    return res;
}

fn Array::clear<T>(T[] self) {
    self.size = 0;
}

// Sorts in-place and returns the sorted array
fn Array::sort<T>(T[] self) {
    if self.is_empty() || self.len() <= 1 {
        return self;
    }

    __internal_qsort(self.elements, 0, self.len() - 1);
    return self;
}

!pub fn __internal_qsort<T>(T *array, i64 low, i64 high) {
    if low >= high {
        return;
    }

    T pivot = array[high];
    i64 i = low;

    for i64 j = low; j < high; j += 1 {
        if array[j] < pivot {
            T temp = array[i];
            array[i] = array[j];
            array[j] = temp;
            i += 1;
        }
    }

    T temp = array[i];
    array[i] = array[high];
    array[high] = temp;

    __internal_qsort(array, low, i - 1);
    __internal_qsort(array, i + 1, high);
}

fn Array::cartesian_product<T>(T[] self, i32 n) {
    T[][] results = [];
    T[] current = [];

    if n == 0 {
        T[] combination = [];
        results.push(#cast(T, combination));
        return results;
    }

    __internal_cartesian_product_generate(self, current, n, results);
    return results;
}

!pub fn __internal_cartesian_product_generate<T>(T[] self, T[] current, i32 n, T[][] results) {
    if current.len() == n {
        T[] combination = current.clone();
        results.push(#cast(T, combination));
        return;
    }

    for u64 i = 0; i < self.len(); i += 1 {
        current.push(self[i]);
        __internal_cartesian_product_generate(self, current, n, results);
        current.pop();
    }
}

fn Array::clone<T>(T[] self) -> T[] {
    T[] clone = Array::with_capacity(self.len());

    for u64 i = 0; i < self.len(); i += 1 {
        clone.push(self[i]);
    }

    return clone;
}

// Turn an array into a string in format [1, 2, "xyz", 'y']
fn Array::to_string<T>(T[] self) -> string {
    return (*self).__fmt__(0);
}

// Join an array's elements by a separator
fn Array::join<T>(T[] self, string separator) {
    let res = "";

    for u64 i = 0; i < self.len(); i += 1 {
        res.extend("{}".format(self[i]));

        if i < self.len() - 1 {
            res.extend(separator);
        }
    }

    return res;
}

external fn Array::join<T>(T[] self, string separator) @alias(Array::implode) -> string;

fn Array::contains<T>(T[] self, T element) {
    for i := 0; i < self.len(); i += 1 {
        if self[i] == element {
            return true;
        }
    }

    return false;
}

// Take all the elements of another Array<T> and push them into this Array<T>
fn Array::extend<T>(T[] self, T[] other) {
    for i := 0; i < other.len(); i += 1 {
        self.push(other[i]);
    }
}

fn Array::remove<T>(T[] self, u64 index) -> Option<T> {
    if index >= self.size {
        return Option::None();
    }

    T removedElement = self[index];

    for let i = index; i < self.size - 1; i += 1 {
        self[i] = self[i + 1];
    }

    self.size -= 1;

    return Option::Some(removedElement);
}

fn Array::insert<T>(T[] self, u64 index, T element) {
    if index < 0 || index > self.size {
        io::cprintf(
            "Index %ld is out of bounds (must be between 0 and %ld inclusive)\n"
                .color("red")
                .reset(),
            index, self.size
        );

        libc::abort();
    }

    if self.size >= self.capacity {
        self.resize((self.capacity || 1) * 2);
    }

    for u64 i = self.size; i > index; i -= 1 {
        self.elements[i] = self.elements[i - 1];
    }

    self.elements[index] = element;
    self.size += 1;
}

fn Array::map_with<T, U, V>(T[] self, fn(T, V, u64, T[]) -> U mapping, V arg) -> U[] {
    let new_self = Array::with_capacity<U>(self.len());

    for u64 i = 0; i < self.len(); i += 1 {
        new_self.push(mapping(self[i], arg, i, self));
    }

    return new_self;
}

fn Array::map<T, U>(T[] self, fn(T, u64, T[]) -> U mapping) -> U[] {
    let new_self = Array::with_capacity<U>(self.len());

    for u64 i = 0; i < self.len(); i += 1 {
        new_self.push(mapping(self[i], i, self));
    }

    return new_self;
}

fn Array::filter_with<T, U>(T[] self, fn(T, U, u64, T[]) -> bool mapping, U arg) -> T[] {
    let new_self = Array::with_capacity<T>(self.len());

    for u64 i = 0; i < self.len(); i += 1 {
        if mapping(self[i], arg, i, self) {
            new_self.push(self[i]);
        }
    }

    return new_self;
}

fn Array::filter<T>(T[] self, fn(T, u64, T[]) -> bool mapping) -> T[] {
    return self.filter_with(fn(x, cb, i, self) cb(x, i, self), mapping);
}

fn Array::every<T>(T[] self, fn(T, u64, T[]) -> bool cb) {
    for u64 i = 0; i < self.len(); i += 1 {
        if !cb(self[i], i, self) {
            return false;
        }
    }

    return true;
}

fn Array::any<T>(T[] self, fn(T, u64, T[]) -> bool cb) {
    for u64 i = 0; i < self.len(); i += 1 {
        if cb(self[i], i, self) {
            return true;
        }
    }

    return false;
}

fn Array::find_with<T, U>(T[] self, fn(T, U, u64, T[]) -> bool cb, U arg) -> Option<T> {
    for u64 i = 0; i < self.len(); i += 1 {
        if cb(self[i], arg, i, self) {
            return Option::Some(self[i]);
        }
    }

    return Option::None();
}

fn Array::find<T>(T[] self, fn(T, u64, T[]) -> bool cb) -> Option<T> {
    for u64 i = 0; i < self.len(); i += 1 {
        if cb(self[i], i, self) {
            return Option::Some(self[i]);
        }
    }

    return Option::None();
}

fn Array::includes<T>(T[] self, T element) {
    for u64 i = 0; i < self.len(); i += 1 {
        if self[i] == element {
            return true;
        }
    }

    return false;
}

fn Array::index<T>(T[] self, T element) -> Option<u64> {
    for u64 i = 0; i < self.len(); i += 1 {
        if self[i] == element {
            return Option::Some(i);
        }
    }

    return Option::None();
}

fn Array::sum<T>(T[] self) {
    T sum = 0;

    for u64 i = 0; i < self.len(); i += 1 {
        sum += self.elements[i];
    }

    return sum;
}

fn Array::product<T>(T[] self) {
    T sum = 0;

    for u64 i = 0; i < self.len(); i += 1 {
        sum *= self.elements[i];
    }

    return sum;
}

fn Array::first<T>(T[] self) -> Option<T> {
    if self.len() < 1 {
        return Option::None();
    }

    return Option::Some(self[0]);
}

fn Array::last<T>(T[] self) -> Option<T> {
    if self.len() < 1 {
        return Option::None();
    }

    return Option::Some(self[self.len() - 1]);
}

fn Array::max<T>(T[] self) -> Option<T> {
    if self.len() == 0 {
        return Option::None();
    }

    T max = self[0];

    for u64 i = 1; i < self.len(); i += 1 {
        if self[i] > max {
            max = self[i];
        }
    }

    return Option::Some(max);
}

fn Array::min<T>(T[] self) -> Option<T> {
    if self.len() == 0 {
        return Option::None();
    }

    T min = self[0];

    for i32 i = 1; i < self.len(); i += 1 {
        if self[i] < min {
            min = self[i];
        }
    }

    return Option::Some(min);
}

fn Array::slice<T>(T[] self, i64 start, i64 end) -> T[] {
    if end == -1 {
        end = self.len();
    }

    if start < 0 {
        start = self.len() + start;
    }

    if end < 0 {
        end = self.len() + end;
    }

    if start < 0 {
        start = 0;
    }

    if start >= self.len() {
        start = self.len();
    }

    if end >= self.len() {
        end = self.len();
    }

    if end < start {
        end = start;
    }

    length := end - start;
    temp := Array::with_capacity<T>(length);

    temp.elements = self.elements + (start * #size(T));
    temp.size = length;

    return temp;
}

/// Fills the array `T[] self`'s full capacity with `T element`
fn Array::fill<T>(T[] self, T element) {
    self.size = self.capacity;

    for i := 0; i < self.capacity; i += 1 {
        self[i] = element;
    }

    return self;
}

/// Sets `self.size` to `self.capacity`, essentially filling `self` without setting any values
fn Array::filled<T>(T[] self) {
    self.size = self.capacity;
    return self;
}

fn Array::concat<T>(T[][] arrays) {
    res := []T;

    for array in arrays {
        res.extend(array);
    }

    return res;
}
