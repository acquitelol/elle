use std/runtime/collections/array;
use std/runtime/libc/io;
use std/runtime/libc/fd;
use std/libc/string;
use std/libc/mem;
global pub;

fn string::is_empty(string self) {
    return self.len() == 0;
}

fn string::equals(string self, string other) {
    return #cast(void *, self) == #cast(void *, other) || strcmp(self, other) == 0;
}

external fn string::equals(string self, string other) @alias(string::__equals__) -> bool;

!pub fn __internal_throw_invalid_needle(ElleMeta meta, ElleMeta caller_meta, ...args) {
    io::cprintf(
        "[%s:%d:%d] ERROR: Expected a second argument of type 'string' or 'char'.\n",
        caller_meta.file, caller_meta.line, caller_meta.column
    );

    for i := 0; i < meta.arity; i += 1 {
        if meta.types[i] == "string" {
            io::cprintf("%s", args.yield(string));
        }
    }

    libc::abort();
}

fn string::contains(ElleMeta meta, string self, ...args) -> bool {
    if meta.arity != 2 {
        __internal_throw_invalid_needle(meta, "The needle argument was not provided.\n");
    }

    if meta.types[1] != "char" && meta.types[1] != "string" {
        __internal_throw_invalid_needle(meta, "Got a value of type ", meta.types[1], " instead.\n");
    }

    needle := meta.types[1] == "char"
        ? #[args.yield(char), '\0']
        : args.yield(string);

    return #cast(void *, strstr(self, needle)) != nil;
}

fn string::find(ElleMeta meta, string self, ...args) -> i64 {
    if meta.arity != 2 {
        __internal_throw_invalid_needle(meta, "The needle argument was not provided.\n");
    }

    if meta.types[1] != "char" && meta.types[1] != "string" {
        __internal_throw_invalid_needle(meta, "Got a value of type ", meta.types[1], " instead.\n");
    }

    needle := meta.types[1] == "char"
        ? #[args.yield(char), '\0']
        : args.yield(string);

    let result = strstr(self, needle);

    if !#cast(void *, result) {
        return -1;
    }

    return #cast(i64, result) - #cast(i64, self);
}

fn string::count(string self, char needle) -> i32 {
    let count = 0;

    for let i = 0; i < self.len(); i += 1 {
        if self[i] == needle {
            count += 1;
        }
    }

    return count;
}

fn string::starts_with(string self, string prefix) -> bool {
    return strncmp(prefix, self, prefix.len()) == 0;
}

fn string::ends_with(string self, string suffix) -> bool {
    let self_length = self.len();
    let suffix_length = suffix.len();

    if suffix_length > self_length {
        return false;
    }

    return strncmp(#cast(string, #cast(void *, self) + #cast(void *, self_length) - suffix_length), suffix, suffix_length) == 0;
}

fn string::default(string self, string default) {
    if !#cast(bool, self) || self.is_empty() {
        return default;
    }

    return self;
}

fn string::to_upper(string self) {
    let out = #alloc(char, self.len() + 1);

    for i := 0; i < self.len(); i += 1 {
        c := self[i];

        if c >= 'a' && c <= 'z' {
            out[i] = c - ('a' - 'A');
        } else {
            out[i] = c;
        }
    }

    return out;
}

fn string::to_lower(string self) {
    let out = #alloc(char, self.len() + 1);

    for i := 0; i < self.len(); i += 1 {
        c := self[i];

        if c >= 'A' && c <= 'Z' {
            out[i] = c + ('a' - 'A');
        } else {
            out[i] = c;
        }
    }

    return out;
}

// Note: these are null terminated strings, which means this
// function returns a CLONE of the slice, NOT a string view
fn string::slice(string self, i32 start, i32 end) -> string {
    let length = self.len();

    if start < 0 || end > length || start > end {
        return nil;
    }

    let new_length = end - start;
    let sliced = #alloc(char, new_length + 1);

    if !sliced {
        return nil;
    }

    for let i = 0; i < new_length; i += 1 {
        sliced[i] = self[start + i];
    }

    sliced[new_length] = '\0';
    return sliced;
}

// Concatenates all of the arguments into 1 final string
//
// examples:
//
// "a".concat("b") == "ab"
// string::concat("me", "ow") == "meow"
fn string::concat(ElleMeta meta, ...args) -> string {
    string strings[meta.arity];
    i32 sizes[meta.arity];
    i64 length = 0;

    for let i = 0; i < meta.arity; i += 1 {
        strings[i] = args.yield(string);
        sizes[i] = strings[i].len();
        length += sizes[i];
    }

    let result = #alloc(char, length + 1);

    if !result {
        return nil;
    }

    let index = 0;

    for let i = 0; i < meta.arity; i += 1 {
        let current = strings[i];

        for let j = 0; j < sizes[i]; j += 1 {
            result[index] = current[j];
            index += 1;
        }
    }

    result[index] = '\0';
    return result;
}

// Concatenates all of the strings provided and then finally reassigns
// the original string to the new string
//
// examples:
//
// string a = "a";
// a.extend("b");
// a == "ab";
//
// string a = "me";
// string::extend(a, "ow");
// a == "meow"
fn string::extend(ElleMeta meta, string *self, ...args) {
    // - 1 to account for `string *self` which isnt variadic
    let res = *self;

    for let i = 0; i < meta.arity - 1; i += 1 {
        res <>= args.yield(string);
    }

    *self = res;
}

fn string::clone(string self) {
    return self <> "";
}

fn string::color(string self, string color) {
    let fmt = "\x1b[%dm";
    let code = -1;

    if color == "bold" {
        code = 1;
    } else if color == "italic" {
        code = 3;
    } else if color == "underline" {
        code = 4;
    } else if color == "red" {
        code = 31;
    } else if color == "green" {
        code = 32;
    } else if color == "yellow" {
        code = 33;
    } else if color == "blue" {
        code = 34;
    } else if color == "magenta" {
        code = 35;
    } else if color == "cyan" {
        code = 36;
    } else if color == "white" {
        code = 37;
    }

    if code == -1 {
        return self;
    }

    let result = #alloc(char, fmt.len() + 1);
    io::sprintf(result, fmt, code);
    result <>= self;

    return result;
}

fn string::reset(string self) {
    return self <> "\x1b[0m";
}

// Capitalizes the first character of a string, and lowercases the rest of the string
fn string::capitalize(string self) {
    let first = self.slice(0, 1);
    let rest = self.slice(1, self.len());

    return first.to_upper() <> rest.to_lower();
}

fn string::split(string self, string delimiter) -> string[] {
    let parts = Array::with_capacity<string>(10);

    if self == "" || delimiter.len() == 0 {
        return parts;
    }

    let start = 0;
    for let i = 0; i <= self.len() - delimiter.len(); i += 1 {
        let is_match = true;

        for let j = 0; j < delimiter.len(); j += 1 {
            if self[i + j] != delimiter[j] {
                is_match = false;
                break;
            }
        }

        if is_match {
            parts.push(self.slice(start, i));
            start = i + delimiter.len();
            i = start - 1;
        }
    }

    if start < self.len() {
        parts.push(self.slice(start, self.len()));
    }

    return parts;
}

fn string::replace(string self, string needle, string replacement) -> string {
    let needle_len = needle.len();
    let replacement_len = replacement.len();
    let self_len = self.len();

    if needle_len == 0 || self_len == 0 {
        return self;
    }

    let buf_size = self_len;
    let res = #alloc(char, buf_size + 1);

    if !res {
        return nil;
    }

    let res_index = 0;
    let i = 0;

    while i < self_len {
        if strncmp(#cast(string, #cast(i64, self) + i), needle, needle_len) == 0 {
            if res_index + replacement_len > buf_size {
                buf_size += replacement_len;
                res = #realloc(res, char, buf_size + 1);
            }

            strcpy(#cast(string, #cast(i64, res) + res_index), replacement);
            res_index += replacement_len;
            i += needle_len;
        } else {
            if res_index + 1 > buf_size {
                buf_size += 1;
                res = #realloc(res, char, buf_size + 1);
            }

            res[res_index] = self[i];
            res_index += 1;
            i += 1;
        }
    }

    res[res_index] = '\0';
    return res;
}

// Repeats a string `count` amount of times
//
// examples:
//
// ```
// io::assert("ab".repeat(4) == "abababab")
// io::assert(string::repeat("e", 2) == "ee")
// ```
fn string::repeat(string self, i32 count) {
    if count <= 0 {
        return "";
    }

    let res = self;

    // count - 1 because we already have 1
    // in the initial declaration
    for let i = 0; i < count - 1; i += 1 {
        res <>= self;
    }

    return res;
}

fn string::insert(string *self, i32 index, char c) {
    let length = (*self).len();

    if index < 0 || index > length {
        return nil;
    }

    // +1 for the new char, +1 for the null terminator
    string result = #alloc(char, length + 2);

    if !result {
        return nil;
    }

    strncpy(result, *self, index);
    result[index] = c;
    strcpy(#cast(string, #cast(void *, result) + index + #cast(i64, 1)), #cast(string, #cast(i64, *self) + index));

    result[length + 1] = '\0';
    *self = result;
}

// Pops the last character off of a string and returns it
//
// This function mutates the string in-place
//
// examples:
//
// ```
// string a = "mew";
// char last = a.pop();
//
// io::assert(last == 'w', nil)
// io::assert(a == "me", nil)
// ```
fn string::pop(string *self) -> char {
    let length = (*self).len();

    if length == 0 {
        return '\0';
    }

    let last_char = (*self)[length - 1];
    let result = #alloc(char, length);

    if !result {
        return '\0';
    }

    strncpy(result, *self, length - 1);
    result[length - 1] = '\0';
    *self = result;

    return last_char;
}

fn string::push(string *self, char c) {
    let length = (*self).len();
    let result = #alloc(char, length + 2);

    if !result {
        return nil;
    }

    strcpy(result, *self);
    result[length] = c;
    result[length + 1] = '\0';

    *self = result;
}

fn __internal_to_string<T, U, V>(i64 args, string fmt, fn(T *) -> V cb) {
    T arg = args.yield(U);
    if cb { cb(&arg); }

    let length = io::snprintf(nil, 0, fmt, arg);
    let res = #alloc(char, length);
    io::sprintf(res, fmt, arg);

    return res;
}

// !! Do not use this unless you know what you're doing !!
// If you want to turn a value of arbitrary type to a string
// please use "{}".format()
fn __to_string(string ty, i64 args, bool wrap) {
    if ty.contains("*") {
        return __internal_to_string<i64, i64, void>(args, "%p", nil);
    }

    if ty.starts_with("string") {
        let arg = args.yield(string);

        if wrap {
            arg = string::concat("\"", arg, "\"");
        }

        return arg;
    }

    if ty.starts_with("i8") {
        return __internal_to_string<i8, i8>(args, "%d", fn(i8 *self) (*self &= 0xFF));
    }

    if ty.starts_with("i16") {
        return __internal_to_string<i16, i16>(args, "%d", fn(i16 *self) (*self &= 0xFFFF));
    }

    if ty.starts_with("i32") {
        return __internal_to_string<i32, i32, void>(args, "%d", nil);
    }

    if ty.starts_with("i64") {
        return __internal_to_string<i64, i64, void>(args, "%ld", nil);
    }

    if ty.starts_with("u8") {
        return __internal_to_string<u8, u8>(args, "%u", fn(u8 *self) self & 0xFF);
    }

    if ty.starts_with("u16") {
        return __internal_to_string<u16, u16>(args, "%u", fn(u16 *self) (*self &= 0xFFFF));
    }

    if ty.starts_with("u32") {
        return __internal_to_string<u32, u32, void>(args, "%u", nil);
    }

    if ty.starts_with("u64") {
        return __internal_to_string<u64, u64, void>(args, "%lu", nil);
    }

    if ty.starts_with("f32") {
        return __internal_to_string<f64, f32, void>(args, "%f", nil);
    }

    if ty.starts_with("f64") {
        return __internal_to_string<f64, f64, void>(args, "%f", nil);
    }

    if ty.starts_with("char") {
        return __internal_to_string<char, char, void>(args, wrap ? "'%c'" : "%c", nil);
    }

    if ty.starts_with("bool") {
        return args.yield(bool) ? "true" : "false";
    }

    let arg = args.yield(i64);
    let fmt = "<%s at %p>";
    let length = io::snprintf(nil, 0, fmt, ty, arg);
    let res = #alloc(char, length);
    io::sprintf(res, fmt, ty, arg);

    return res;
}

fn string::as_string(ElleMeta meta, ...args) {
    return __to_string(meta.types[0], args, false);
}

fn string::as_string_wrapped(ElleMeta meta, ...args) {
    return __to_string(meta.types[0], args, true);
}

// !! Do not use this unless you know what you're doing !!
// If you want to format arguments of arbitrary types
// into a new string, use string::format() instead
fn __internal_fmt(string fmt, ElleMeta meta, i64 args) {
    let result = "";

    let arg = 0;
    let is_open = false;
    let wrapped = false;

    for i := 0; i < fmt.len(); i += 1 {
        c := fmt[i];

        if is_open {
            // Allow for escaping { using {{}
            if c == '{' {
                is_open = false;

                // Push '{' as it was skipped the first time
                result.push(c);
                continue;
            }

            // {:} enables wrapped mode which means
            // that strings are printed as "str" not str
            // and chars are printed as 'c' not c
            if c == ':' {
                wrapped = true;
                continue;
            }

            arg += 1;

            if c != '}' {
                io::fprintf(__internal_stderr, "Invalid format for argument '%d' at position '%d' (%c)\n", arg, i, c);
                return "";
            }


            if arg >= meta.arity {
                io::fprintf(__internal_stderr, "Failed to format argument '%d' at position '%d': Ran out of arguments (%c)\n", arg, i, c);
                libc::abort();
            }

            let out = __to_string(meta.types[arg], args, wrapped);
            result.extend(out);

            is_open = false;
            wrapped = false;
            continue;
        }

        if c == '{' {
            is_open = true;
            continue;
        }

        result.push(c);
    }

    return result;
}

// Internal formatting function that does not automatically run
// parameters through their formatter (no @fmt attribute)
fn string::__internal_formatter_do_not_use_unless_you_know_what_youre_doing__(ElleMeta meta, string fmt, ...args) -> string {
    return __internal_fmt(fmt, meta, args);
}

fn string::format(ElleMeta meta, string fmt, ...args) @fmt -> string {
    for let i = 0; i < meta.arity; i += 1 {
        meta.types[i] = "string";
    }

    return __internal_fmt(fmt, meta, args);
}

fn string::ascii_lower() {
    return "abcdefghijklmnopqrstuvwxyz";
}

fn string::ascii_upper() {
    return string::ascii_lower().to_upper();
}

fn string::ascii_numerics() {
    return "0123456789";
}
