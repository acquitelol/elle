use std/runtime/io;
use std/core;
global pub;

fn bool::parse(string str) {
    if str == "true" {
        return true;
    }

    return false;
}

fn bool::try_parse(string str, bool *res) {
    valid := str == "true" || str == "false";

    if valid {
        *res = bool::parse(str);
        return true;
    }

    return false;
}

!pub fn __internal_is_valid(string str, string ty) -> bool {
    valid_strspn := #["-0123456789", "-0123456789", "-0123456789."];
    valid_types := #["i32", "i64", "f64"];
    type_index := -1;

    for i: u64 = 0; i < #len(valid_types); i += 1 {
        if valid_types[i] == ty {
            type_index = i;
        }
    }

    if type_index == -1 {
        io::eprintln(ty, " is not a valid type for casting. Falling back to 0");
        io::eprintln("Valid types:");

        for i: u64 = 0; i < #len(valid_types); i += 1 {
            io::eprintln("-\t", valid_types[i]);
        }

        return false;
    }

    if strspn(str, valid_strspn[type_index]) != str.len() {
        return false;
    }

    return true;
}

!pub fn __internal_is_valid_with_err(string str, string ty) -> bool {
    res := __internal_is_valid(str, ty);

    if !res {
        io::eprintln("Invalid input: '", str, "'. Falling back to 0.");
    }

    return res;
}

fn i32::parse(string str) -> i32 {
    return str.atoi();
}

fn i32::try_parse(string str, i32 *res) -> bool {
    valid := __internal_is_valid(str, "i32");

    if valid {
        *res = str.atoi();
        return true;
    }

    return false;
}

fn i64::parse(string str) -> i64 {
    return str.atol();
}

fn i64::try_parse(string str, i64 *res) -> bool {
    valid := __internal_is_valid(str, "i64");

    if valid {
        *res = str.atol();
        return true;
    }

    return false;
}

fn f32::parse(string str) -> f32 {
    valid := __internal_is_valid_with_err(str, "f64");

    if valid {
        return #cast(f32, str.atof());
    }

    return 0;
}

fn f32::try_parse(string str, f32 *res) -> bool {
    valid := __internal_is_valid(str, "f64");

    if valid {
        *res = #cast(f32, str.atof());
        return true;
    }

    return false;
}

fn f64::parse(string str) -> f64 {
    valid := __internal_is_valid_with_err(str, "f64");

    if valid {
        return str.atof();
    }

    return 0;
}

fn f64::try_parse(string str, f64 *res) -> bool {
    valid := __internal_is_valid(str, "f64");

    if valid {
        *res = str.atof();
        return true;
    }

    return false;
}
