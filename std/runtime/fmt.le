namespace __void_ptr__;
global pub;

fn i32::__fmt__(i32 self, i32 nesting) {
    return string::as_string(self);
}

fn u32::__fmt__(u32 self, i32 nesting) {
    return string::as_string(self);
}

fn i64::__fmt__(i64 self, i32 nesting) {
    return string::as_string(self);
}

