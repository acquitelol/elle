global pub;

fn i64::max() -> i64 {
    return 9_223_372_036_854_775_807;
}

fn i64::min() -> i64 {
    return ~i64::max();
}

fn i32::max() -> i32 {
    return 2_147_483_647;
}

fn i32::min() -> i32 {
    return ~i32::max();
}

fn i16::max() -> i16 {
    return 32_767;
}

fn i16::min() -> i16 {
    return ~i16::max();
}

fn i8::max() -> i8 {
    return 127;
}

fn i8::min() -> i8 {
    return ~i8::max();
}

fn u64::max() -> u64 {
    return 18_446_744_073_709_551_615;
}

fn u64::min() -> u64 {
    return ~u64::max();
}

fn u32::max() -> u32 {
    return 4_294_967_295;
}

fn u32::min() -> u32 {
    return ~u32::max();
}

fn u16::max() -> u16 {
    return 65_535;
}

fn u16::min() -> u16 {
    return ~u16::max();
}

fn u8::max() -> u8 {
    return 255;
}

fn u8::min() -> u8 {
    return ~u8::max();
}

fn f64::max() -> f64 {
    return *#cast(f64 *, &0b111111111101111111111111111111111111111111111111111111111111111);
}

fn f64::min() -> f64 {
    return *#cast(f64 *, &0b1111111111101111111111111111111111111111111111111111111111111111);
}


fn f32::max() -> f32 {
    return *#cast(f32 *, &0b1111111011111111111111111111111);
}

fn f32::min() -> f32 {
    return *#cast(f32 *, &0b11111111011111111111111111111111);
}
