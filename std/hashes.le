namespace __clean_ptr__;
namespace __void_ptr__;
namespace __ptr__;
namespace hash;
global pub, external;

!external fn hash::mod<T, U>(T self, U other) {
    return #cast(u64, (self % other + other) % other);
}

!external fn __ptr__::__hash__<T>(T *self, u64 capacity) {
    return hash::mod(#cast(u64, self), capacity);
}

!external fn __clean_ptr__::__hash__<T>(T *self, u64 capacity) {
    return hash::mod(#cast(u64, self), capacity);
}

fn string::__hash__(string self, u64 capacity) -> u64;
fn __void_ptr__::__hash__(void *self, u64 capacity) -> u64;
fn char::__hash__(char self, u64 capacity) -> u64;
fn bool::__hash__(bool self, u64 capacity) -> u64;
fn i8::__hash__(i8 self, u64 capacity) -> u64;
fn i16::__hash__(i16 self, u64 capacity) -> u64;
fn i32::__hash__(i32 self, u64 capacity) -> u64;
fn i64::__hash__(i64 self, u64 capacity) -> u64;
fn u8::__hash__(u8 self, u64 capacity) -> u64;
fn u16::__hash__(u16 self, u64 capacity) -> u64;
fn u32::__hash__(u32 self, u64 capacity) -> u64;
fn u64::__hash__(u64 self, u64 capacity) -> u64;
fn f32::__hash__(f32 self, u64 capacity) -> u64;
fn f64::__hash__(f64 self, u64 capacity) -> u64;
