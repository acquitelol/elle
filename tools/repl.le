use std/prelude;

const SHORT_EXTENSION = ".le";

fn main(string[] args) {
    if args.len() == 1 || args[1] != "wrapped" {
        libc::system("rlwrap {} wrapped".format(args[0]));
        return;
    }

    lines := []string;

    while true {
        line := io::input(".ೃ࿔* -> ");

        if line.ends_with(";") {
            line.pop();
        }

        backlog := "{}{}".format(
            lines.join(";\n{}".format(" ".repeat(16))),
            lines.len() > 0 ? ";" : ""
        );

        let code = "
            use std/prelude;

            fn main() {{
                {}
                io::println({});
            }".format(backlog, line)
         .split("\n")
         .map(fn(x) x.replace(" ".repeat(12), ""))
         .join("\n");

        if line == "<!dbg>" {
            io::println(code);
            continue;
        }

        src_path := ".repl-{}{}".format(time(nil), SHORT_EXTENSION);
        exec_path := "./{}".format(src_path.replace(SHORT_EXTENSION, ""));

        if !io::write_to_file(src_path, code) {
            io::eprintf("Failed to write to file at path: {}", src_path);
            continue;
        }

        src_code := libc::system("ellec --hush {}".format(src_path));
        io::remove(src_path);

        if !src_code {
            let exec_code = libc::system(exec_path);
            io::remove(exec_path);

            if !exec_code {
                lines.push(line);
            }
        }
    }
}
