use std/prelude;

let ITERATIONS = 1e5;
let ACCURACY = 1e6;
let EPSILON = 0.1305;
let CHANCE = EPSILON * (ACCURACY / 100);

fn roll() {
    attempts := 0;
    roll := ACCURACY;

    while roll > CHANCE {
        attempts += 1;
        roll = rand::random(0, ACCURACY);
    }

    return attempts;
}

fn main() {
    rand::seed(time(nil));
    results := (0..ITERATIONS).map(roll);

    io::printf(
        "Rolled a {}% chance in an average of {} attempts",
        EPSILON, results.sum() / ITERATIONS
    );
}
