use std/prelude;
use std/collections/hashmap;

struct Object {
    HashMap<string, Object *> *entries;
    string type; // for printing
    void *value;
};

fn Object::new() {
    return #alloc(Object);
}

fn Object::__load__(ElleMeta meta, Object *self, string key) {
    if #cast(void *, self.entries) == nil {
        self.entries = HashMap::new();
    }

    if !self.entries.contains_key(key) {
        self.entries[key] = Object::new();
    }

    entry := self.entries[key];

    if entry.value == nil {
        $panic("{} does not exist in the object.", key);
    }

    return entry;
}

fn Object::__store__<T>(ElleMeta meta, Object *self, string key, T value) {
    if #cast(void *, self.entries) == nil {
        self.entries = HashMap::new();
    }

    if !self.entries.contains_key(key) {
        self.entries[key] = Object::new();
    }

    Object *child = self.entries[key];

    value_ptr := #alloc(T);
    *value_ptr = value;

    child.value = value_ptr;
    child.type = meta.types[2]; // the type of `T value`
}

fn Object::to<T>(Object *self) -> T {
    return *#cast(T *, self.value);
}

fn main() {
    obj := Object::new();
    obj["foo"] = 42;
    obj["bar"] = "a";
    obj["baz"] = [1, 2, 3];

    obj["a"] = Object::new();
    obj["a"]["b"] = 1;

    $dbg(
        obj["foo"].to<i32>(),
        obj["bar"].to<string>(),
        obj["baz"].to<i32[]>(),
        obj["a"]["b"].to<i32>(),
        obj
    );
}
