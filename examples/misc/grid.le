use std/prelude;

struct Grid<T> {
    T[] data;
    i32 width;
};

fn Grid::from_str(string input) -> Grid<char> {
    return Grid {
        data = Array::from_string(input),
        width = input.split("\n")[0].len()
    };
}

fn Grid::__load__<T>(Grid<T> self, (i32, i32) coord) {
    return self.data[coord.y * self.width + coord.x];
}

fn main() {
    let grid = Grid::from_str("A159\nB260\nC371\nD482");
    io::dbg(grid[$(0, 0)], grid[$(2, 1)]);
}
