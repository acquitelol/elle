use std/io;
use std/pick;

fn direction(i32 *other) -> bool {
    i32 x = 0;

    if !other {
        return direction(&x);
    } else {
        return &x > other;
    }
}

fn main() {
    io::printf(
        "The stack is growing {}wards for your architecture.",
        pick(direction(nil), "up", "down")
    );
}
