use std/prelude;

fn main() {
    while true {
        bin := Array::from_string(io::input("Enter a binary string: "));

        if !bin.every(fn(char x) "01".contains(x)) {
            $eprintf("Invalid string: {}", bin);
            continue;
        }

        mult := math::pow(2, bin.len());
        res := 0;

        for c in bin {
            // extremely insane expression
            // im surprised this even works
            c == '1' && (res += mult /= 2);
        }

        $dbg(res);
    }
}
