use std/prelude;

fn main() {
    for ;; {
        bin := io::input("Enter a binary string: ");

        if !bin.iter().all(fn(x) "01".contains(x)) {
            $eprintf("Invalid string: {}", bin);
            continue;
        }

        mult := math::pow(2, bin.len());
        res := 0;

        for c in bin {
            mult /= 2;
            c == '1' && res += mult;
        }

        $dbg(res);
    }
}
