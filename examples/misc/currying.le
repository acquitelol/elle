use std/io;

struct Env { i32 a }
struct Function { Env env, void *func }

fn add(i32 a) {
    let env = Env { a = a };
    let func = fn(Env env, i32 b) env.a + b;

    return Function {
        func = func,
        env = env
    };
}

fn main() {
    let res = add(13);
    fn *curried = res.func;
    $dbg(#cast(i32, curried(res.env, 26)));
}
