use std/prelude;

struct FnEnv { i32 a }
struct Function @nofmt { FnEnv env, fn(FnEnv, i32) -> i32 func }

fn add(i32 a) {
    return Function {
        env = FnEnv { a = a },
        func = fn(env, b) env.a + b
    };
}

fn main() {
    res := add(13);
    curried := res.func;
    $dbg(curried(res.env, 26));
}
