use std/prelude;

// NOTE: the below is a desugar for this:
//
// fn add(i32 x) {
//     return fn(i32 y) {
//         return fn(i32 z) {
//             return x + y + z;
//         };
//     };
// }
//
// ----------------------------
//
// OR, in shorthand notation:
//
// const add = fn(i32 x) fn(i32 y) fn(i32 z) x + y + z;
//
// ----------------------------
//
// called like this:
//
// fn main() {
//     add(3)(4)(5);
// }

struct _1 @nofmt {
    i32 x,                        // captured from `fn(i32 x)`
    fn(_1 *, i32) -> _2 closure,  // raw fn*
}

struct _2 @nofmt {
    _1 *captures,                 // captures from `fn(i32 x)`
    i32 y,                        // captured from `fn(i32 y)`
    fn(_2 *, i32) -> i32 closure, // raw fn*
}

fn add(i32 x) {
    return _1 {
        x = x,
        closure = fn(captures, y) {
            return _2 {
                captures = captures,
                y = y,
                closure = fn(captures, z) captures.captures.x + captures.y + z
            };
        }
    };
}

fn main() {
    // initial call, gets us the captured variables and the closure fn*
    func_a := add(3);
    a := func_a.closure;

    // call the closure fn* with ourselves, providing the scope to the closure
    // in the form of the struct when the closure is created
    func_b := a(&func_a, 4);
    b := func_b.closure;

    $dbg(b(&func_b, 5));
}
