use std/prelude;

// NOTE: the below is a desugar for this:
//
// fn add(i32 x) {
//     return fn(i32 y) {
//         return fn(i32 z) {
//             return x + y + z;
//         };
//     };
// }
//
// ----------------------------
//
// OR, in shorthand notation:
//
// const add = fn(i32 x) fn(i32 y) fn(i32 z) x + y + z;
//
// ----------------------------
//
// called like this:
//
// fn main() {
//     add(3)(4)(5);
// }

namespace __closure_12311295; // forward declare

struct __closure_12311294 @nofmt {
    i32 x; // captured from `fn(i32 x)`
    __closure_12311295 *__return_type; // should be autogen from the compiler
    fn *__closure; // raw fn*
};

struct __closure_12311295 @nofmt {
    __closure_12311294 *captures; // captures from `fn(i32 x)`
    i32 y; // captured from `fn(i32 y)`
    i32 __return_type; // should be autogen from the compiler
    fn *__closure; // raw fn*
};

// heap alloc so these structs can be returned from their functions
fn __closure_12311294::new() { return #alloc(__closure_12311294); }
fn __closure_12311295::new() { return #alloc(__closure_12311295); }

fn add(i32 x) {
    func_a := __closure_12311294::new();
    func_a.x = x;
    func_a.__closure = fn(__closure_12311294 *captures, i32 y) {
        func_b := __closure_12311295::new();
        func_b.captures = captures; // save `fn(i32 y)` captures
        func_b.y = y;
        func_b.__closure = fn(__closure_12311295 *captures, i32 z) {
            return captures.captures.x + captures.y + z;
        };
        func_b.__return_type = #cast(i32, nil); // this would be done by the compiler
        return func_b;
    };
    func_a.__return_type = #cast(__closure_12311295 *, nil); // this would be done by the compiler
    return func_a;
}

fn main() {
    // initial call, gets us the captured variables and the closure fn*
    func_a := add(3); // #type(func_a) = `__closure_12311294 *`
    cb_a := func_a.__closure;

    // call the closure fn* with ourselves, providing the scope to the closure in the form of the struct
    // the #cast() ideally would be done to `__closure_12311294.__return_type` which is autogenerated
    // when the closure is created
    func_b := #cast(__closure_12311295 *, cb_a(func_a, 4)); // #type(func_b) = `__closure_12311295 *`
    cb_b := func_b.__closure;

    // get back the final value
    // again, the #cast() should be to `__closure_12311295.__return_type`
    res := #cast(i32, cb_b(func_b, 5)); // #type(res) = `i32`
    $dbg(res);
}
