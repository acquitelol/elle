use std/collections/array;
use std/io;

struct Object {
    void *data,
    bool marked,
    i32 size,
}

fn Object::new(i32 size) {
    Object *obj = mem::malloc(#size(Object));

    obj.data = mem::malloc(size);
    obj.marked = false;
    obj.size = size;

    return obj;
}

fn Object::free(Object *self) {
    mem::free(self.data);
    mem::free(self);
}

struct GC {
    Object *[] heap
}

fn GC::new() {
    let gc = #alloc(GC);
    gc.heap = [];

    return gc;
}

fn GC::alloc(GC *self, i32 size) {
    let obj = Object::new(size);
    self.heap.push(obj);
    return obj.data;
}

fn GC::mark(GC *self, void *ptr) {
    for obj in self.heap {
        if obj.data == ptr {
            obj.marked = true;
        }
    }
}

fn GC::sweep(GC *self) {
    for obj in self.heap {
        if !obj.marked {
            self.heap.remove(#i(obj)).unwrap().free();
        } else {
            obj.marked = false;
        }
    }
}

fn main() {
    let gc = GC::new();

    i32 *num = gc.alloc(#size(i32));
    *num = 42;

    i32 *arr = gc.alloc(10 * #size(i32));
    arr[0] = 5;

    $dbg(num, arr, gc.heap);

    io::println("\nMarking the number pointer...\n");
    gc.mark(num); // Will mark num, making it not be sweeped

    $dbg(gc.heap);

    io::println("\nSweeping non-marked allocations...\n");
    gc.sweep();

    // The array will be garbage because it was freed
    $dbg(num, arr, gc.heap);

    io::println("\nSweeping non-marked allocations...\n");
    gc.sweep(); // Sweep without marking the num pointer

    // Everything will be garbage data because it was freed
    $dbg(num, arr, gc.heap);
}
