// This code was intended to draw snowflakes however
// it was repurposed to draw the Sierpinski Triangle
use std/prelude;
use std/raylib;

let SCREEN_FACTOR = 80;
let SCREEN_WIDTH = 8 * SCREEN_FACTOR;
let SCREEN_HEIGHT = 8 * SCREEN_FACTOR;

let BRANCHES = 3;
let DEPTH = 10;
let ANGLE = 2.0 * PI / BRANCHES;
let ROTATION_OFFSET = PI / 6.0;
let LENGTH = SCREEN_FACTOR * 2.0;
let THICKNESS = 8.0;

fn render_sierpinski(Vector2 center, f32 length, f32 thickness, i32 depth) {
    if depth <= 0 {
        return;
    }

    for i := 0; i < BRANCHES; i += 1 {
        angle := ROTATION_OFFSET + ANGLE * i;

        branch := Vector2 {
            x = center.x + math::cos(angle) * length,
            y = center.y + math::sin(angle) * length
        };

        rl::draw_line_ex(center, branch, thickness, PINK);
        render_sierpinski(branch, length / 2, thickness / 2, depth - 1);
    }
}

fn main() {
    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "Sierpinski Triangle");
    defer rl::close_window();

    rl::set_target_fps(60);

    center := Vector2 {
        x = SCREEN_WIDTH / 2,
        y = SCREEN_HEIGHT / 2,
    };

    while !rl::window_should_close() {
        rl::begin_drawing();
        defer rl::end_drawing();

        rl::clear_background(BLACK);

        render_sierpinski(center, LENGTH, THICKNESS, DEPTH);
        rl::draw_fps(SCREEN_WIDTH - 80, SCREEN_HEIGHT - 24);
    }
}
