use std/raylib;

const MAX_ITERATIONS = 100;
const SCREEN_WIDTH = 800;
const SCREEN_HEIGHT = 800;
const RESET_SPEED = 0.08;
const EPSILON = 0.001;
const RESOLUTION = 1.0 / 4;

fn main() {
    i32 textureWidth = SCREEN_WIDTH * RESOLUTION;
    i32 textureHeight = SCREEN_HEIGHT * RESOLUTION;

    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "Mandelbrot Set");
    defer rl::close_window();

    let target = rl::load_render_texture(textureWidth, textureHeight);
    defer rl::unload_render_texture(target);

    rl::set_texture_filter(target.texture, TextureFilter::TEXTURE_FILTER_BILINEAR);
    rl::set_target_fps(60);

    let zoom = 0.75;
    let offsetX = -0.75;
    let offsetY = 0.0;
    let fontSize = 15 * RESOLUTION;
    let baseZoomScale = 0.02;

    let targetZoom = 0.75;
    let targetOffsetX = -0.75;
    let targetOffsetY = 0.0;
    let isReset = false;

    while !rl::window_should_close() {
        if rl::is_key_down(KeyboardKey::KEY_ONE) {
            zoom *= 1.02;
        }

        if rl::is_key_down(KeyboardKey::KEY_TWO) {
            zoom /= 1.02;
        }

        if rl::is_key_down(KeyboardKey::KEY_THREE) {
            isReset = true;
        }

        if rl::is_key_down(KeyboardKey::KEY_A) {
            offsetX -= baseZoomScale / zoom;
        }

        if rl::is_key_down(KeyboardKey::KEY_D) {
            offsetX += baseZoomScale / zoom;
        }

        if rl::is_key_down(KeyboardKey::KEY_W) {
            offsetY -= baseZoomScale / zoom;
        }

        if rl::is_key_down(KeyboardKey::KEY_S) {
            offsetY += baseZoomScale / zoom;
        }

        if isReset {
            let diff_zoom = targetZoom - zoom;
            let diff_x = targetOffsetX - offsetX;
            let diff_y = targetOffsetY - offsetY;

            zoom += diff_zoom * RESET_SPEED;
            offsetX += diff_x * RESET_SPEED;
            offsetY += diff_y * RESET_SPEED;

            if (math::abs(diff_zoom) < EPSILON) &&
                (math::abs(diff_x) < EPSILON) &&
                (math::abs(diff_y) < EPSILON)
            {
                zoom = targetZoom;
                offsetX = targetOffsetX;
                offsetY = targetOffsetY;
                isReset = false;
            }
        }

        {
            rl::begin_texture_mode(target);
            defer rl::end_texture_mode();

            rl::clear_background(BLACK);

            let zoomFactor = Vector2 {
                x = 0.5 * zoom * textureWidth,
                y = 0.5 * zoom * textureHeight
            };

            for let x = 0; x < textureWidth; x += 1 {
                for let y = 0; y < textureHeight; y += 1 {
                    let z = Vector2 {
                        x = (x - textureWidth / 2.0) / zoomFactor.x + offsetX,
                        y = (y - textureHeight / 2.0) / zoomFactor.y + offsetY
                    };

                    let c = z.clone();
                    let iteration = 0;

                    while (z.x * z.x + z.y * z.y) < 4 && iteration < MAX_ITERATIONS {
                        let temp_x = z.x * z.x - z.y * z.y + c.x;
                        z.y = 2.0 * z.x * z.y + c.y;
                        z.x = temp_x;
                        iteration += 1;
                    }

                    if iteration == MAX_ITERATIONS {
                        rl::draw_pixel(x, y, BLACK);
                    } else {
                        let out = Color {
                            r = (iteration * 8) % 255,
                            g = (iteration * 4) % 255,
                            b = (iteration * 2) % 255,
                            a = 255
                        };

                        rl::draw_pixel(x, y, out);
                    }
                }
            }
        }

        {
            rl::begin_drawing();
            defer rl::end_drawing();

            rl::clear_background(BLACK);

            rl::draw_texture_pro(target.texture,
                Rectangle {
                    x = 0, y = 0,
                    width = target.texture.width,
                    height = -target.texture.height
                },
                Rectangle {
                    x = 0, y = 0,
                    width = SCREEN_WIDTH,
                    height = SCREEN_HEIGHT
                },
                Vector2 { x = 0, y = 0 },
                0, WHITE
            );

            rl::draw_fps(SCREEN_WIDTH - 80, SCREEN_HEIGHT - 24);
            rl::draw_text(
                "1 - Zoom in\n2 - Zoom out\n3 - Reset all\nW - Up\nA - Left\nS - Down\nD - Right",
                18, SCREEN_HEIGHT - 12 * 10, fontSize * 3, WHITE
            );
        }
    }
}
