use ../resources/raylib;
use std/vectors;

const i32 MAX_ITERATIONS = 100;
const i32 SCREEN_WIDTH = 800;
const i32 SCREEN_HEIGHT = 800;
const f32 RESET_SPEED = 0.08;
const f32 EPSILON = 0.001;
const Color BLACK = raylib::get_color(0x00000000);
const Color WHITE = raylib::get_color(0xFFFFFFFF);

fn main() {
    f32 resolution = 1 / 4;
    i32 textureWidth = SCREEN_WIDTH * resolution;
    i32 textureHeight = SCREEN_HEIGHT * resolution;

    raylib::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "Mandelbrot Set");
    defer raylib::close_window();

    let target = raylib::load_render_texture(textureWidth, textureHeight);
    defer raylib::unload_render_texture(target);

    raylib::set_texture_filter(target.texture, 1); // TEXTURE_FILTER_BILINEAR
    raylib::set_target_fps(60);

    let zoom = 0.75;
    let offsetX = -0.75;
    let offsetY = 0.0;
    let fontSize = 15 * resolution;
    let baseZoomScale = 0.02;

    let targetZoom = 0.75;
    let targetOffsetX = -0.75;
    let targetOffsetY = 0.0;
    let isReset = false;

    while !raylib::window_should_close() {
        if raylib::is_key_down('1') {
            zoom *= 1.02;
        }

        if raylib::is_key_down('2') {
            zoom /= 1.02;
        }

        if raylib::is_key_down('3') {
            isReset = true;
        }

        if raylib::is_key_down('A') {
            offsetX -= baseZoomScale / zoom;
        }

        if raylib::is_key_down('D') {
            offsetX += baseZoomScale / zoom;
        }

        if raylib::is_key_down('W') {
            offsetY -= baseZoomScale / zoom;
        }

        if raylib::is_key_down('S') {
            offsetY += baseZoomScale / zoom;
        }

        if isReset {
            let diff_zoom = targetZoom - zoom;
            let diff_x = targetOffsetX - offsetX;
            let diff_y = targetOffsetY - offsetY;

            zoom += diff_zoom * RESET_SPEED;
            offsetX += diff_x * RESET_SPEED;
            offsetY += diff_y * RESET_SPEED;

            if (math::abs(diff_zoom) < EPSILON) &&
                (math::abs(diff_x) < EPSILON) &&
                (math::abs(diff_y) < EPSILON)
            {
                zoom = targetZoom;
                offsetX = targetOffsetX;
                offsetY = targetOffsetY;
                isReset = false;
            }
        }

        raylib::begin_texture_mode(target);
        raylib::clear_background(BLACK);

        let zoomFactor = Vector2 {
            x = 0.5 * zoom * textureWidth,
            y = 0.5 * zoom * textureHeight
        };

        for let x = 0; x < textureWidth; x += 1 {
            for let y = 0; y < textureHeight; y += 1 {
                let z = Vector2 {
                    x = (x - textureWidth / 2.0) / zoomFactor.x + offsetX,
                    y = (y - textureHeight / 2.0) / zoomFactor.y + offsetY
                };

                let c = z.clone();
                let iteration = 0;

                while (z.x * z.x + z.y * z.y) < 4 && iteration < MAX_ITERATIONS {
                    let temp_x = z.x * z.x - z.y * z.y + c.x;
                    z.y = 2.0 * z.x * z.y + c.y;
                    z.x = temp_x;
                    iteration += 1;
                }

                if iteration == MAX_ITERATIONS {
                    raylib::draw_pixel(x, y, BLACK);
                } else {
                    let out = Color {
                        r = (iteration * 8) % 255,
                        g = (iteration * 4) % 255,
                        b = (iteration * 2) % 255,
                        a = 255
                    };

                    raylib::draw_pixel(x, y, out);
                }
            }
        }

        raylib::end_texture_mode();

        raylib::begin_drawing();
        raylib::clear_background(BLACK);

        raylib::draw_texture_pro(target.texture,
            Rectangle {
                x = 0, y = 0,
                width = target.texture.width,
                height = -target.texture.height
            },
            Rectangle {
                x = 0, y = 0,
                width = SCREEN_WIDTH,
                height = SCREEN_HEIGHT
            },
            Vector2 { x = 0, y = 0 },
            0, WHITE
        );

        raylib::draw_fps(SCREEN_WIDTH - 80, SCREEN_HEIGHT - 24);
        raylib::draw_text(
            "1 - Zoom in\n2 - Zoom out\n3 - Reset all\nW - Up\nA - Left\nS - Down\nD - Right",
            18, SCREEN_HEIGHT - 12 * 10, fontSize * 3, WHITE
        );

        raylib::end_drawing();
    }
}
