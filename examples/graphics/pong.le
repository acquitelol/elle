use std/raylib;

const SCREEN_WIDTH = 800;
const SCREEN_HEIGHT = 450;

const PADDLE_WIDTH = 20;
const PADDLE_HEIGHT = 100;
const PADDLE_SPEED = 5.0;

const BALL_SIZE = 10;
const BALL_SPEED = 5.0;

fn main() {
    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "Pong :3");
    defer rl::close_window();

    rl::set_target_fps(60);

    leftPaddle := Rectangle {
        x = 50,
        y = SCREEN_HEIGHT / 2 - PADDLE_HEIGHT / 2,
        width = PADDLE_WIDTH,
        height = PADDLE_HEIGHT
    };

    rightPaddle := Rectangle {
        x = SCREEN_WIDTH - 50 - PADDLE_WIDTH,
        y = SCREEN_HEIGHT / 2 - PADDLE_HEIGHT / 2,
        width = PADDLE_WIDTH,
        height = PADDLE_HEIGHT
    };

    ballPosition := Vector2::new(SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2);
    ballVelocity := Vector2::from(BALL_SPEED);

    leftScore := 0;
    rightScore := 0;
    velocitySign := 1;

    while !rl::window_should_close() {
        if rl::is_key_down(KeyboardKey::KEY_W) && leftPaddle.y > 0 {
            leftPaddle.y -= PADDLE_SPEED;
        }

        if rl::is_key_down(KeyboardKey::KEY_S) && leftPaddle.y < SCREEN_HEIGHT - PADDLE_HEIGHT {
            leftPaddle.y += PADDLE_SPEED;
        }

        if rl::is_key_down(KeyboardKey::KEY_LEFT) && rightPaddle.y > 0 {
            rightPaddle.y -= PADDLE_SPEED;
        }

        if rl::is_key_down(KeyboardKey::KEY_RIGHT) && rightPaddle.y < SCREEN_HEIGHT - PADDLE_HEIGHT {
            rightPaddle.y += PADDLE_SPEED;
        }

        ballPosition.x += ballVelocity.x;
        ballPosition.y += ballVelocity.y;

        if ballPosition.y <= 0 || ballPosition.y >= SCREEN_HEIGHT - BALL_SIZE {
            ballVelocity.y *= -1;
        }

        if rl::check_collision_circle_rec(ballPosition, BALL_SIZE / 2, leftPaddle) ||
            rl::check_collision_circle_rec(ballPosition, BALL_SIZE / 2, rightPaddle) {
            ballVelocity.x *= -1;
        }

        if ballPosition.x <= 0 {
            rightScore += 1;
            velocitySign = -velocitySign;
            ballPosition = Vector2::new(SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2);
            ballVelocity = Vector2::from(BALL_SPEED * velocitySign);
        }

        if ballPosition.x >= SCREEN_WIDTH {
            leftScore += 1;
            velocitySign = -velocitySign;
            ballPosition = Vector2::new(SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2);
            ballVelocity = Vector2::from(BALL_SPEED * velocitySign);
        }

        rl::begin_drawing();
        defer rl::end_drawing();

        rl::clear_background(BLACK);

        rl::draw_rectangle_rec(leftPaddle, WHITE);
        rl::draw_rectangle_rec(rightPaddle, WHITE);
        rl::draw_circle_v(ballPosition, BALL_SIZE / 2, WHITE);

        rl::draw_text("{}".format(leftScore), SCREEN_WIDTH / 4, 20, 40, WHITE);
        rl::draw_text("{}".format(rightScore), 3 * SCREEN_WIDTH / 4, 20, 40, WHITE);
    }
}
