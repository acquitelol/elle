use std/raylib;

const SCREEN_WIDTH = 800;
const SCREEN_HEIGHT = 450;

const BUTTON_UNHOVER = rl::get_color(0x777777FF);
const BUTTON_HOVER = rl::get_color(0x555555FF);
const BACKGROUND = rl::get_color(0x333333FF);

fn render_button(string text, f32 y_offset, Vector2 mouse_pos, i32 *counter, fn *action) {
    button := Rectangle {
        x = (SCREEN_WIDTH - rl::measure_text(text, 20) - 30) / 2,
        y = (SCREEN_HEIGHT - 40 * 2 * y_offset) / 2.0,
        width = rl::measure_text(text, 20) + 30,
        height = 40
    };

    hovering := rl::elle_check_collision_point_rec(mouse_pos, button);
    button_color := hovering ? BUTTON_HOVER : BUTTON_UNHOVER;

    if hovering && rl::is_mouse_button_pressed(MOUSE_BUTTON_LEFT) {
        action(counter);
    }

    rl::draw_rectangle_rec(button, button_color);
    rl::draw_rectangle_lines_ex(button, 2, BLACK);
    rl::draw_text(text, button.x + 15, button.y + 10, 20, WHITE);
}

fn main() {
    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "Counter :3");
    defer rl::close_window();

    rl::set_target_fps(60);
    counter := 0;

    while !rl::window_should_close() {
        rl::begin_drawing();
        defer rl::end_drawing();

        rl::clear_background(BACKGROUND);
        mouse_pos := rl::get_mouse_position();

        render_button("Increment", 1, mouse_pos, &counter, fn(i32 *counter) { *counter += 1; });
        render_button("Decrement", -0.35, mouse_pos, &counter, fn(i32 *counter) { *counter -= 1; });
        render_button("Reset", -1.7, mouse_pos, &counter, fn(i32 *counter) { *counter = 0; });

        count := "Counter: {}".format(counter);
        rl::draw_text(count, (SCREEN_WIDTH - rl::measure_text(count, 40)) / 2, 100, 40, WHITE);
    }
}
