use std/vectors;
use std/math;
use std/io;

let THETA_SPACING = 0.07;
let PHI_SPACING = 0.02;
let LIGHTING = ".,-~:;=!*#$@";

let WIDTH = 60;
let HEIGHT = 24;
let SIZE = WIDTH * HEIGHT;

fn update(f32 rotX, f32 rotZ, f32 *zBuffer, string output, Vector3 *lightDirection) {
    memset(zBuffer, 0, SIZE * #size(f32));
    memset(output, 32, SIZE * #size(char));

    sinRotX := math::sinf(rotX);
    cosRotX := math::cosf(rotX);

    sinRotZ := math::sinf(rotZ);
    cosRotZ := math::cosf(rotZ);

    for theta := 0.0; theta < 2 * PI; theta += THETA_SPACING {
        sinTheta := math::sinf(theta);
        cosTheta := math::cosf(theta);

        for phi := 0.0; phi < 2 * PI; phi += PHI_SPACING {
            sinPhi := math::sinf(phi);
            cosPhi := math::cosf(phi);

            surfacePos := Vector3 {
                x = cosPhi * (cosTheta + 2),
                y = sinPhi * (cosTheta + 2),
                z = sinTheta,
            };

            depth := 1 / (surfacePos.y * sinRotX + surfacePos.z * cosRotX + 5);
            projectionOffset := surfacePos.y * cosRotX - surfacePos.z * sinRotX;

            x: i32 = 30 + 36 * depth * (surfacePos.x * cosRotZ - projectionOffset * sinRotZ);
            y: i32 = 12 + 12 * depth * (surfacePos.x * sinRotZ + projectionOffset * cosRotZ);
            offset := x + WIDTH * y;

            normal := surfacePos.clone();
            normalLengthSquared := normal.length_sq();

            if normalLengthSquared > 0 {
                normal = normal.scale(1.0 / normalLengthSquared);
            }

            illumination := normal.dot(*lightDirection);
            lightingIndex := #cast(i32, math::abs(illumination) * (LIGHTING.len() - 1));

            if HEIGHT > y && y > 0 && x > 0 && WIDTH > x && depth > zBuffer[offset] {
                zBuffer[offset] = depth;
                lightingMapping := #cast(i32, lightingIndex) % (LIGHTING.len() - 1);
                output[offset] = LIGHTING[lightingMapping < 0 ? 0 : lightingMapping];
            }
        }
    }

    io::print("\x1b[H");

    for character := 0; character < SIZE; character += 1 {
        if character % WIDTH {
            io::putchar(output[character]);
        } else {
            io::putchar('\n');
        }
    }
}

fn main() {
    rotX := 0.0;
    rotZ := 0.0;

    zBuffer := #alloc(f32, SIZE);
    output := #alloc(char, SIZE);
    lightDirection := Vector3 { x = 0, y = 1, z = -1 };
    io::print("\x1b[2J");

    while true {
        update(rotX, rotZ, zBuffer, output, &lightDirection);

        rotX += 0.002;
        rotZ += 0.001;
    }
}
