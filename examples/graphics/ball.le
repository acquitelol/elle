use std/prelude;
use std/raylib;

let SCREEN_WIDTH = 600;
let SCREEN_HEIGHT = 600;
let FONT_SIZE = 40;
let UPDATE_FACTOR = 4;

let VELOCITY_FACTOR = 2.0;
let CIRCLE_RADIUS = 50.0;
let GRAVITY = 1000.0;
let DAMPING = -0.8;
let EPSILON = 5.0;

let PINK = rl::get_color(0xFF7DFBFF);
let BERRY = rl::get_color(0x2E172DFF);

fn main() {
    title := "Using raylib in Elle! <3";
    subtitle := "Try controlling the ball with W, A, S, D!";

    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, title);
    defer rl::close_window();

    rl::init_audio_device();
    defer rl::close_audio_device();

    sound := rl::load_sound("examples/resources/hit.wav");
    defer rl::unload_sound(sound);

    rl::set_target_fps(60);

    padding := SCREEN_WIDTH >= 100 ? 100 : 0;
    position := Vector2 {
        x = SCREEN_WIDTH - CIRCLE_RADIUS - padding,
        y = 100
    };

    velocity := Vector2 {
        x = -120 * VELOCITY_FACTOR,
        y = 100 * VELOCITY_FACTOR
    };

    finished := false;
    bounces := 0;

    while !rl::window_should_close() {
        deltaTime := rl::get_frame_time();

        if finished {
            finished = false;
            velocity.x *= UPDATE_FACTOR * -1;
            velocity.y = GRAVITY * UPDATE_FACTOR * 0.2;
        }

        rl::begin_drawing();
        velocity.y += GRAVITY * deltaTime;
        rl::clear_background(BERRY);

        if rl::is_key_down(KeyboardKey::KEY_W) {
            velocity.y = -200;
        }

        if rl::is_key_down(KeyboardKey::KEY_S) {
            velocity.y = 200;
        }

        if rl::is_key_down(KeyboardKey::KEY_A) {
            velocity.x = -200;
        }

        if rl::is_key_down(KeyboardKey::KEY_D) {
            velocity.x = 200;
        }

        newX := position.x + velocity.x * deltaTime;

        if newX < CIRCLE_RADIUS || newX + CIRCLE_RADIUS > rl::get_screen_width() {
            bounces += 1;
            velocity.x *= DAMPING;
            rl::play_sound(sound);
        } else {
            position.x = newX;
        }

        newY := position.y + velocity.y * deltaTime;

        if newY < CIRCLE_RADIUS || newY + CIRCLE_RADIUS > rl::get_screen_height() {
            bounces += 1;
            velocity.y *= DAMPING;
            rl::play_sound(sound);
        } else {
            position.y = newY;
        }

        position.x += velocity.x * deltaTime;
        position.y += velocity.y * deltaTime;

        if (math::abs(velocity.y) < EPSILON) && SCREEN_HEIGHT - CIRCLE_RADIUS - position.y < EPSILON && !finished {
            finished = true;
        }

        rl::draw_circle(#cast(i32, position.x), #cast(i32, position.y), CIRCLE_RADIUS, PINK);

        // Title
        rl::draw_text(title, (SCREEN_WIDTH - rl::measure_text(title, FONT_SIZE)) / 2, 40, FONT_SIZE, BLUE);

        // Bounces
        bouncesString := "Bounces: {}".format(bounces);
        rl::draw_text(bouncesString, (SCREEN_WIDTH - rl::measure_text(bouncesString, FONT_SIZE)) / 2, 100, FONT_SIZE, YELLOW);

        // Subtitle
        rl::draw_text(subtitle, (SCREEN_WIDTH - rl::measure_text(subtitle, FONT_SIZE / 2)) / 2, 160, FONT_SIZE / 2, PURPLE);
        rl::draw_fps(SCREEN_WIDTH - 80, SCREEN_HEIGHT - 24);
        rl::end_drawing();
    }
}
