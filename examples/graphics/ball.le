use std/raylib;

const SCREEN_WIDTH = 600;
const SCREEN_HEIGHT = 600;
const FONT_SIZE = 40;
const UPDATE_FACTOR = 4;

const VELOCITY_FACTOR = 2.0;
const CIRCLE_RADIUS = 50.0;
const GRAVITY = 1000.0;
const DAMPING = -0.8;
const EPSILON = 5.0;

const PINK = rl::get_color(0xFF7DFBFF);
const BERRY = rl::get_color(0x2E172DFF);

fn main() {
    let title = "Using raylib in Elle! <3";
    let subtitle = "Try controlling the ball with W, A, S, D!";

    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, title);
    defer rl::close_window();

    rl::init_audio_device();
    defer rl::close_audio_device();

    let sound = rl::load_sound("./examples/resources/hit.wav");
    defer rl::unload_sound(sound);

    rl::set_target_fps(60);

    let padding = SCREEN_WIDTH >= 100 ? 100 : 0;
    let position = Vector2 {
        x = SCREEN_WIDTH - CIRCLE_RADIUS - padding,
        y = 100
    };

    let velocity = Vector2 {
        x = -120 * VELOCITY_FACTOR,
        y = 100 * VELOCITY_FACTOR
    };

    let finished = false;
    let bounces = 0;

    while !rl::window_should_close() {
        let deltaTime = rl::get_frame_time();

        if finished {
            finished = false;
            velocity.x *= UPDATE_FACTOR * -1;
            velocity.y = GRAVITY * UPDATE_FACTOR * 0.2;
        }

        rl::begin_drawing();
        velocity.y += GRAVITY * deltaTime;
        rl::clear_background(BERRY);

        if rl::is_key_down(KEY_W) {
            velocity.y = -200;
        }

        if rl::is_key_down(KEY_S) {
            velocity.y = 200;
        }

        if rl::is_key_down(KEY_A) {
            velocity.x = -200;
        }

        if rl::is_key_down(KEY_D) {
            velocity.x = 200;
        }

        let newX = position.x + velocity.x * deltaTime;

        if newX < CIRCLE_RADIUS || newX + CIRCLE_RADIUS > rl::get_screen_width() {
            bounces += 1;
            velocity.x *= DAMPING;
            rl::play_sound(sound);
        } else {
            position.x = newX;
        }

        let newY = position.y + velocity.y * deltaTime;

        if newY < CIRCLE_RADIUS || newY + CIRCLE_RADIUS > rl::get_screen_height() {
            bounces += 1;
            velocity.y *= DAMPING;
            rl::play_sound(sound);
        } else {
            position.y = newY;
        }

        position.x += velocity.x * deltaTime;
        position.y += velocity.y * deltaTime;

        if (math::abs(velocity.y) < EPSILON) && SCREEN_HEIGHT - CIRCLE_RADIUS - position.y < EPSILON && !finished {
            finished = true;
        }

        rl::draw_circle((i32)position.x, (i32)position.y, CIRCLE_RADIUS, PINK);

        // Title
        rl::draw_text(title, (SCREEN_WIDTH - rl::measure_text(title, FONT_SIZE)) / 2, 40, FONT_SIZE, BLUE);

        // Bounces
        string bouncesString = "Bounces: {}".format(bounces);
        rl::draw_text(bouncesString, (SCREEN_WIDTH - rl::measure_text(bouncesString, FONT_SIZE)) / 2, 100, FONT_SIZE, YELLOW);

        // Subtitle
        rl::draw_text(subtitle, (SCREEN_WIDTH - rl::measure_text(subtitle, FONT_SIZE / 2)) / 2, 160, FONT_SIZE / 2, PURPLE);
        rl::draw_fps(SCREEN_WIDTH - 80, SCREEN_HEIGHT - 24);
        rl::end_drawing();
    }
}
