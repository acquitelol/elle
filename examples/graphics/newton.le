use std/raylib;
use std/prelude;

const SCREEN_FACTOR = 80;
const SCREEN_WIDTH = 12 * SCREEN_FACTOR;
const SCREEN_HEIGHT = 12 * SCREEN_FACTOR;

fn main() {
    rl::init_window(SCREEN_WIDTH, SCREEN_HEIGHT, "Newton Fractal");
    defer rl::close_window();

    rl::set_target_fps(60);

    x_min, x_max := $(-1.5, 1.5);
    y_min, y_max := $(-1.5, 1.5);

    roots := [
        Vector2::new(0, 1),
        Vector2::new(0, -1),
        Vector2::new(-1.3247, 0),
        Vector2::new(0.6624, 0.5623),
        Vector2::new(0.6624, -0.5623)
    ];

    colors := [
        Vector3::new(0.835, 0.176, 0),
        Vector3::new(0.937, 0.463, 0.153),
        Vector3::new(1, 1, 1),
        Vector3::new(0.710, 0.337, 0.565),
        Vector3::new(0.639, 0.0078, 0.384)
    ];

    shader := rl::load_shader(nil, "examples/resources/newton.fs");
    defer rl::unload_shader(shader);

    locs := HashMap::new<string, i32>();

    for loc in ["x_min", "x_max", "y_min", "y_max", "max_iter", "tol"] {
        locs[loc] = rl::get_shader_location(shader, loc);
    }

    for i in 0..colors.len() {
        loc := rl::get_shader_location(shader, "colors[{}]".format(i));
        rl::set_shader_value(shader, loc, &colors[i].x, ShaderUniformDataType::SHADER_UNIFORM_VEC3);
    }

    max_iter := 100;
    tol := 1.0e-12;
    rl::set_shader_value(shader, locs["max_iter"], &max_iter, ShaderUniformDataType::SHADER_UNIFORM_INT);
    rl::set_shader_value(shader, locs["tol"], &tol, ShaderUniformDataType::SHADER_UNIFORM_FLOAT);

    tex := rl::get_default_texture();
    tex.width = SCREEN_WIDTH;
    tex.height = SCREEN_HEIGHT;

    grabbed := -1;

    while !rl::window_should_close() {
        mouse := rl::get_mouse_position();
        m := Vector2::new(
            x_min + mouse.x * (x_max - x_min) / SCREEN_WIDTH,
            y_max - mouse.y * (y_max - y_min) / SCREEN_HEIGHT,
        );

        if rl::is_mouse_button_pressed(MouseButton::MOUSE_LEFT_BUTTON) {
            for i, root in roots.iter().enumerate() {
                s := $(
                    (root.x - x_min) / (x_max - x_min) * SCREEN_WIDTH,
                    (y_max - root.y) / (y_max - y_min) * SCREEN_HEIGHT
                );

                if math::abs(mouse.x - s.x) < 10 && math::abs(mouse.y - s.y) < 10 {
                    grabbed = i;
                    break;
                }
            }
        }

        if rl::is_mouse_button_down(MouseButton::MOUSE_RIGHT_BUTTON) {
            dx := rl::get_mouse_delta().x * (x_max - x_min) / SCREEN_WIDTH;
            dy := rl::get_mouse_delta().y * (y_max - y_min) / SCREEN_HEIGHT;

            x_min -= dx;
            x_max -= dx;
            y_min += dy;
            y_max += dy;
        }

        if rl::is_mouse_button_released(MouseButton::MOUSE_LEFT_BUTTON) {
            grabbed = -1;
        }

        if grabbed != -1 {
            roots[grabbed] = m;
        }

        wheel := rl::get_mouse_wheel_move();

        if wheel != 0 {
            scale := wheel > 0 ? 0.95 : 1.05;

            x_min = m.x + (x_min - m.x) * scale;
            x_max = m.x + (x_max - m.x) * scale;
            y_min = m.y + (y_min - m.y) * scale;
            y_max = m.y + (y_max - m.y) * scale;
        }

        for i, root in roots.iter_ref().enumerate() {
            loc := rl::get_shader_location(shader, "roots[{}]".format(i));
            rl::set_shader_value(shader, loc, root, ShaderUniformDataType::SHADER_UNIFORM_VEC2);
        }

        rl::set_shader_value(shader, locs["x_min"], &x_min, ShaderUniformDataType::SHADER_UNIFORM_FLOAT);
        rl::set_shader_value(shader, locs["x_max"], &x_max, ShaderUniformDataType::SHADER_UNIFORM_FLOAT);
        rl::set_shader_value(shader, locs["y_min"], &y_min, ShaderUniformDataType::SHADER_UNIFORM_FLOAT);
        rl::set_shader_value(shader, locs["y_max"], &y_max, ShaderUniformDataType::SHADER_UNIFORM_FLOAT);

        rl::begin_drawing();
            rl::clear_background(RAYWHITE);
            rl::begin_shader_mode(shader);

            rl::draw_texture_pro(
                tex,
                Rectangle {
                    x = 0, y = 0,
                    width = tex.width,
                    height = -tex.height
                },
                Rectangle {
                    x = 0, y = 0,
                    width = tex.width,
                    height = tex.height
                },
                Vector2 { x = 0, y = 0 },
                0, WHITE
            );

            rl::end_shader_mode();

            for i, root in roots.iter().enumerate() {
                s := $(
                    (root.x - x_min) / (x_max - x_min) * SCREEN_WIDTH,
                    (y_max - root.y) / (y_max - y_min) * SCREEN_HEIGHT
                );

                rl::draw_circle(s.x, s.y, 4, BLACK);
            }

            rl::draw_fps(4, 4);
        rl::end_drawing();
    }
}
