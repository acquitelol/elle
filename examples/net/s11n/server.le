use std/prelude;
use std/net/tcp;
use shared;

fn main() {
    server := TcpServer::bind(port := 8080);

    while server.is_err_and(fn: it == Errno::EADDRINUSE) {
        server = TcpServer::bind(port += 1);
    }

    server := server!;
    defer server.close()!;

    connection := server.accept()!;
    defer connection.close()!;

    foo := Foo { x = 39, y = "Hello from the server", z = 4.2 };
    $printf("Sending {}", foo);
    connection.write(foo.to_bytes())!;
}
