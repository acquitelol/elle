use std/prelude;
use std/net/tcp;
use shared;

let BUF_SIZE = 1024;

fn main() {
    client := TcpClient::connect("127.0.0.1", port := 8080);

    while client.is_err_and(fn: [Errno::ELOOP, Errno::ECONNREFUSED].contains(it)) {
        client = TcpClient::connect("127.0.0.1", port += 1);
    }

    client := client.unwrap();
    defer client.close().unwrap();

    buf := Array::bytes(BUF_SIZE);
    client.read(buf).unwrap();
    foo := Foo::from_bytes(buf);
    $printf("Received {}", foo);
}
