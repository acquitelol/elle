use std/prelude;

fn main() {
    let input = i32::parse(io::input("Enter a number -> "));

    if input < 1 {
        io::eprintf("Invalid input: {}", input);
        return 1;
    }

    for i in 1..=input {
        let res = "";

        if i % 3 == 0 {
            res <>= "Fizz";
        }

        if i % 5 == 0 {
            res <>= "Buzz";
        }

        io::println(res.default("{}".format(i)));
    }
}
