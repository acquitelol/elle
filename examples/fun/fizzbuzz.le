use std/prelude;

fn main() {
    let input = i32::parse(io::input("Enter a number -> "));

    if input < 1 {
        io::eprintf("Invalid input: {}", input);
        return 1;
    }

    for i in 1..=input {
        if i % 15 == 0 {
            $println("FizzBuzz");
            continue;
        }

        if i % 3 == 0 {
            $println("Fizz");
            continue;
        }

        if i % 5 == 0 {
            $println("Buzz");
            continue;
        }

        $println(i);
    }
}
