use std/prelude;

fn main() {
    let price = 11.50;
    string[] extras = [];

    let ticket_type = io::input("Enter the ticket type -> ").default("Adult");
    let member = bool::parse(io::input("Is the ticket holder a member? (true or false) -> "));

    if member {
        price *= 0.9;
        extras.push("Premier seats");
    }

    if ticket_type == "Infant" {
        price = 0;
    } else { if ticket_type == "Student" || ticket_type == "Senior" {
        price *= 0.8;

        if member {
            extras.push("Popcorn");
        }
    } else {
        ticket_type = "Adult";
    }}

    io::printf("Ticket type: {}", ticket_type);
    io::printf("Membership: {}", member);
    io::printf("Ticket cost: £{}", price);
    io::printf("Extras: {}", extras.join(", ").default("None"));
}
