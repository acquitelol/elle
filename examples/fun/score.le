use std/prelude;

fn main() {
    highestScore := 0;
    winner := "";
    stop := false;

    while true {
        person := io::input("Enter a person's name (or 'stop'): ");

        if person == "stop" {
            break;
        }

        score := i32::parse(io::input(string::format("Enter {}'s score: ", person)));

        if score > highestScore {
            highestScore = score;
            winner = person.clone();
        }
    }

    io::printf("The winner is {} with a score of {}", winner, highestScore);
}
