// This file is not best practices or using any modern Elle semantics
// It simply lives here as a relic of the past
use std/string;
use std/cast;
use std/io;

fn main() {
    i32 highestScore = 0;
    string winner = (string)mem::malloc(BUF_SIZE * #size(char));
    defer free(winner);

    while true {
        string person = io::input("Enter a person's name (or 'stop'): ");
        defer mem::free(person);

        if person == "stop" {
            break;
        }

        i32 score = i32::parse(io::input(string::format("Enter {}'s score: ", person)));

        if score > highestScore {
            highestScore = score;
            strcpy(winner, person);
        }
    }

    io::printf("The winner is {} with a score of {}", winner, highestScore);
}
