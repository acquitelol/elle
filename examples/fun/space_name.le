use std/prelude;

fn Tuple::capitalize((string, string) self) {
    self.x = self.x.capitalize();
    self.y = self.y.capitalize();
    return self;
}

struct Info {
    (string, string) name;
    (string, string) data;
};

fn Info::to_space_name(Info self) {
    let name = $(
        self.name.y.slice(0, 3) <> self.name.x.slice(0, 2),
        self.data.y.slice(0, 3) <> self.data.x.slice(0, 2)
    );

    return name.capitalize();
}

fn main() {
    let info = Info {
        name = $(
            io::input("What is your first name? -> "),
            io::input("What is your last name? -> ")
        ),
        data = $(
            io::input("What is your birth month? -> "),
            io::input("What is your favourite animal? -> ")
        )
    };

    let space_name = info.to_space_name();
    io::printf("Your space name is {} {}", space_name.x, space_name.y);
}
