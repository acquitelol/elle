use std/prelude;

const QUESTION_COUNT = 10;
const LARGEST_INT = 12;

struct Question {
    string display,
    i32 answer,
    i32 index,
    @unused i32 input,
}

fn Question::new(Operation[] operators, i32 index) {
    lhs, rhs := $(
        rand::random(1, LARGEST_INT),
        rand::random(1, LARGEST_INT)
    );

    operator := rand::random(0, operators.len() - 1);
    operation := operators[operator];
    cb := operation.cb;

    return Question {
        display = "What is {} {} {}? -> ".format(lhs, operation.kind, rhs),
        answer = cb(lhs, rhs),
        index = index
    };
}

struct Operation @nofmt {
    string kind,
    fn(i32, i32) -> i32 cb,
}

fn main() {
    rand::seed(time(nil));
    incorrect := [Question;];

    operations := [
        Operation { kind = "+", cb = fn(a, b) a + b },
        Operation { kind = "-", cb = fn(a, b) a - b },
        Operation { kind = "*", cb = fn(a, b) a * b },
        Operation { kind = "/", cb = fn(a, b) a / b }
    ];

    for i := 0; i < QUESTION_COUNT; i += 1 {
        question := Question::new(operations, i);
        input := io::input("({}/{}) {}".format(i + 1, QUESTION_COUNT, question.display));
        answer := 0;

        if !i32::try_parse(input, &answer) || answer != question.answer {
            question.input = answer;
            incorrect.push(question);
        }
    }

    correct := QUESTION_COUNT - incorrect.len();
    io::printf("\nYou answered {}/{} questions correctly!", correct, QUESTION_COUNT);
    io::printf(
        "That's {}%. Congrats!",
        #cast(i32, #cast(f32, correct) * 100 / QUESTION_COUNT)
    );

    if !incorrect.is_empty() {
        io::println("\nIncorrect questions:");
    }

    for question in incorrect {
        io::printf(
            "{}) The correct answer was {}, you wrote {}.",
            question.index + 1, question.answer, question.input
        );
    }
}
