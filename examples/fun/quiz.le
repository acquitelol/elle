use std/collections/array;
use std/io;
use std/rand;
use std/time;
use std/cast;

const QUESTION_COUNT = 10;
const LARGEST_INT = 12;

struct Question {
    string display,
    i32 answer,
    i32 input,
    i32 index,
}

fn Question::new(Operation *[] operators, i32 index) {
    let self = #alloc(Question);
    let lhs = rand::random(1, LARGEST_INT);
    let rhs = rand::random(1, LARGEST_INT);
    let operator = rand::random(0, operators.len() - 1);

    let operation = operators[operator];
    fn *func = operation.func;

    self.display = "What is {} {} {}? -> ".format(lhs, operation.display, rhs);
    self.answer = func(lhs, rhs);
    self.index = index;

    return self;
}

struct Operation {
    string display,
    void *func,
}

fn Operation::new(string display, fn *func) {
    let op = #alloc(Operation);
    op.display = display;
    op.func = func;

    return op;
}

fn main() {
    rand::seed(time(nil));
    Question *[] incorrect = [];

    let operations = [
        Operation::new("+", fn(i32 a, i32 b) a + b),
        Operation::new("-", fn(i32 a, i32 b) a - b),
        Operation::new("*", fn(i32 a, i32 b) a * b),
        Operation::new("/", fn(i32 a, i32 b) a / b)
    ];

    for let i = 0; i < QUESTION_COUNT; i += 1 {
        let question = Question::new(operations, i);
        let input = io::input("({}/{}) {}".format(i + 1, QUESTION_COUNT, question.display));
        let answer = 0;

        if !i32::try_parse(input, &answer) || answer != question.answer {
            question.input = answer;
            incorrect.push(question);
        }
    }

    let correct = QUESTION_COUNT - incorrect.len();
    io::printf("\nYou answered {}/{} questions correctly!", correct, QUESTION_COUNT);
    io::printf(
        "That's {}%. Congrats!",
        #cast(i32, #cast(f32, correct) * 100 / QUESTION_COUNT)
    );

    if !incorrect.is_empty() {
        io::println("\nIncorrect questions:");
    }

    for question in incorrect {
        io::printf(
            "{}) The correct answer was {}, you wrote {}.",
            question.index + 1, question.answer, question.input
        );
    }
}
