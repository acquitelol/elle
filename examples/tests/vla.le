use std/collections/array;
use std/io;

fn main() {
    let a = [1, 2];

    a.push(39);
    a.push(-1);

    io::assert(a.first() == 1, nil);
    io::assert(a.last() == -1, nil);

    string[] b = [];

    b.push("hello");
    b.push("world");
    b.push("meow");
    b.push("abcd");

    io::dbg(a);

    let c = [172];

    // Test extension
    a.extend(c);

    // Test logging
    io::dbg(a, b);

    // Test popping
    io::dbg(b.pop(), b);

    // Test to_string
    io::println(b.to_string());
    io::println(b.join(", "));
    io::print('\n');

    // Test clearing
    b.clear();
    b.push("a");
    io::dbg(b);

    // Test from_string
    let hello_world = Array::from_string("hello world!");

    io::dbg(hello_world.join(""));

    // Test contains
    let d = ["a", "b", "c"];

    io::dbg(d.contains("a"), d.contains("foo"));

    // Generates [0, 1, 2, 3, 4]
    let e = 0..5;

    // Squares every number in `e`
    let e_mapped = e.map<i32>(fn(i32 x) x * x);
    io::dbg(e_mapped);

    let empty = 0..0;

    io::dbg(empty);
    io::assert(
        empty.len() == 0,
        "The length of Array::range(0, 0) should be 0"
    );
}
