use std/io;

struct Counter {
    i32 value;
};

fn Counter::increment(Counter *self) {
    self.value += 1;
    return self;
}

fn main() {
    // Call a nested function lots of times to test the capabilities of
    // the compiler speeds for such operations
    //
    // Internally this is represented as:
    // Counter::increment(Counter::increment(...Counter::increment(&Counter(0)))).value
    //
    // If the compiler does this the old way, this will take very long to compile
    // With the new way it should compile much faster (several magnitudes faster)
    io::dbg((Counter { value = 0 })
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .increment().increment().increment()
        .value
    );
}
