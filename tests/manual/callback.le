use std/io;

fn loop(string str, fn(char) callback) -> void {
    for c in str {
        callback(c);
    }
}

fn formattedPrint(char character) {
    io::print(character, " ");
}

fn main() {
    let test = "Hello World!";

    // Expected result: "H e l l o   W o r l d !"
    loop(test, fn(c) io::print(c, " "));
    io::print('\n');

    loop(test, formattedPrint);
    io::print('\n');
}
