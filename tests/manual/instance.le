use std/io;

struct Foo {
    i32 a;
};

// `Foo`, only gets a copy of Foo
fn Foo::add(Foo self, Foo other) {
    return Foo { a = self.a + other.a };
}

// `Foo *`, edits in-place
fn Foo::divideBy(Foo *self, i32 num) {
    self.a /= num;
}

fn Foo::__equals__(Foo self, Foo other) {
    return self.a == other.a;
}

fn main() {
    let foo1 = Foo { a = 10 };
    let foo2 = Foo { a = 30 };

    // The compiler automatically passes a reference to Foo if the function needs `Foo *` and not `Foo`
    foo2.divideBy(15);
    let resWithInstance = foo1.add(foo2);
    let resWithStruct = Foo::add(foo1, foo2);

    $assert(
        resWithInstance == resWithStruct,
        "Instance and struct methods should produce equal results."
    );

    $dbg(resWithInstance, resWithStruct);
}
