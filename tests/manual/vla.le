use std/collections/array;
use std/io;

fn main() {
    let a = [1, 2];

    a.push(39);
    a.push(-1);

    io::assert(a.first().unwrap() == 1, nil);
    io::assert(a.last().unwrap() == -1, nil);

    string[] b = [];

    b.push("hello");
    b.push("world");
    b.push("meow");
    b.push("abcd");

    $dbg(a);

    let c = [172];

    // Test extension
    a.extend(c);

    // Test logging
    $dbg(a, b);

    // Test popping
    $dbg(b.pop(), b);

    // Test to_string
    io::println(b.to_string());
    io::println(b.join(", "));
    io::print('\n');

    // Test clearing
    b.clear();
    b.push("a");
    $dbg(b);

    // Test from_string
    let hello_world = Array::from_string("hello world!");

    $dbg(hello_world.join(""));

    // Test contains
    let d = ["a", "b", "c"];

    $dbg(d.contains("a"), d.contains("foo"));
}
