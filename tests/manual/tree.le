use std/prelude;

// OBJECTIVE:
// Given a tree:
//      1
//     / \
//    2   3
//   /   / \
//  4   5   6
//
// Print each level on a new line:
//
// 1
// 2 3
// 4 5 6

struct Node {
    Option<Box<Node>> left,
    Option<Box<Node>> right,
    i32 value
}

fn Node::print_on_lines(Node *self) {
    i32[][] levels = [];
    pq := [$(self, 0)];

    while !pq.is_empty() {
        res := pq.remove(0).unwrap();
        node := res.x; level := res.y;

        if levels.len() == level {
            levels.push([i32;]);
        }

        levels[level].push(node.value);

        if left := node.left.to_nilable() {
            pq.push($(left.to_ptr(), level + 1));
        }

        if right := node.right.to_nilable() {
            pq.push($(right.to_ptr(), level + 1));
        }
    }

    return levels
        .map<string>(fn(i32[] level) level.join(" "))
        .join("\n");
}

fn main() {
    root := Node {
        left = Option::Some(Box::new(Node {
            left = Option::Some(Box::new(Node {
                left = Option::None(),
                right = Option::None(),
                value = 4
            })),
            right = Option::None(),
            value = 2
        })),
        right = Option::Some(Box::new(Node {
            left = Option::Some(Box::new(Node {
                left = Option::None(),
                right = Option::None(),
                value = 5
            })),
            right = Option::Some(Box::new(Node {
                left = Option::None(),
                right = Option::None(),
                value = 6
            })),
            value = 3
        })),
        value = 1
    };

    $dbg(root);
    $println();
    $println(root.print_on_lines());
}
