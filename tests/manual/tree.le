use std/prelude;

// OBJECTIVE:
// Given a tree:
//      1
//     / \
//    2   3
//   /   / \
//  4   5   6
//
// Print each level on a new line:
//
// 1
// 2 3
// 4 5 6

struct Node {
    Option<Box<Node>> left,
    Option<Box<Node>> right,
    i32 value
}

fn Node::print_on_lines(Node *self) {
    i32[][] levels = [];
    queue := [$(self, 0)];

    while !queue.is_empty() {
        node, level := queue.remove(0).unwrap();

        if levels.len() == level {
            levels.push([]i32);
        }

        levels[level].push(node.value);

        if _, left := node.left {
            queue.push($(left.to_ptr(), level + 1));
        }

        if _, right := node.right {
            queue.push($(right.to_ptr(), level + 1));
        }
    }

    return levels
        .map(fn(level) level.join(" "))
        .join("\n");
}

fn main() {
    root := Node {
        left = Some(Box::new(Node {
            left = Some(Box::new(Node {
                left = None(),
                right = None(),
                value = 4
            })),
            right = None(),
            value = 2
        })),
        right = Some(Box::new(Node {
            left = Some(Box::new(Node {
                left = None(),
                right = None(),
                value = 5
            })),
            right = Some(Box::new(Node {
                left = None(),
                right = None(),
                value = 6
            })),
            value = 3
        })),
        value = 1
    };

    $dbg(root);
    $println('\n', root.print_on_lines());
}
