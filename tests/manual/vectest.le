use std/vectors;
use std/prelude;

fn Vector3::test() {
    v := Vector3 { x = 1.0, y = 0.0, z = 0.0 };
    axis := Vector3 { x = 0.0, y = 0.0, z = 1.0 };
    angle := PI / 2.0;

    rotated := v.rotate(axis, angle);
    $dbg(rotated);

    v1 := Vector3 { x = 1, y = 0, z = 0 };
    v2 := Vector3 { x = 0, y = 1, z = 0 };
    $dbg(v1.angle(v2));

    zero := Vector3::zero();
    $dbg(zero);
}

fn Vector2::test() {
    v1 := Vector2 { x = 1.0, y = 0.0 };
    rotated := v1.rotate(PI);
    $dbg(rotated);

    v1 := Vector2 { x = 1, y = 0 };
    v2 := Vector2 { x = 0, y = 1 };
    $dbg(v1.angle(v2));

    zero := Vector2::zero();
    $dbg(zero);
}

fn main() {
    Vector3::test();
    io::println();
    Vector2::test();
}
