use std/io;

fn main() {
    $assert('a' == "a", nil); // Will use 'a' == "a"[0]
    $assert("a" != 'b', nil); // Will use "a"[0] == 'b'
    $assert("a" == 'a', nil); // Will use "a"[0] == 'a'
    $assert('a' == "abc", nil); // Will use 'a' == "abc"[0]

    $println("All `string to character` tests have passed!".color("green").reset());
}
