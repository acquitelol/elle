use std/prelude;

struct Foo {
    i32[4] xs
}

fn main() {
    x := #[1, 2, 3];
    $assert(x.len() == 3);
    $assert(!x.is_empty());

    y := #[
        #[1, 2, 3],
        #[4, 5, 6]
    ];

    $assert(y.transpose() == #[
        #[1, 4],
        #[2, 5],
        #[3, 6]
    ]);

    foo := Foo { xs = #[13, 16, 19, -12] };
    $assert(foo.xs == #[13, 16, 19, -12]);
    $assert(*(&foo.xs[1]) == 16);
    $assert(foo.xs[0] == 13);

    foo.xs[3] = -11;
    $assert(foo.xs[3] == -11);

    foos := #[Foo { xs = #[100, 54, 98, 52] }];
    $assert(foos[0].xs[2] == 98);

    foos[0].xs = #[99, 53, 97, 51];
    $assert(foos[0].xs[2] == 97);

    foos[0].xs[1] = 52;
    $assert(foos[0].xs[1] == 52);

    bar := [#[1, 2, 3], #[4, 5, 6]];
    x := &bar[1][2];
    $assert(*x == 6);

    baz := #[#[1, 2, 3], #[4, 5, 6]];
    x := &baz[1][2];
    $assert(*x == 6);

    qux := #[[1, 2, 3], [4, 5, 6]];
    x := &qux[1][2];
    $assert(*x == 6);

    $println("All `static array` tests have passed!".color("green").reset());
}
