use std/prelude;

fn main() {
    x := "foo";
    $assert(x == "foo", nil);
    x := 1;
    $assert(x == 1, nil);

    {
        x = 2;

        x := "a";
        $assert(x == "a", nil);

        {
            x = "b";
            $assert(x == "b", nil);
        }

        $assert(x == "b", nil);
    }

    $assert(x == 2, nil);

    // Redeclare a new `y` using `:=`
    y := 13;
    y := y * 3;

    $assert(y == 39, nil);

    // Redeclare a new `z` using `=`
    z := "foo";
    z = z <> "bar";
    z <>= "baz";

    $assert(z == "foobarbaz", nil);
    io::println("All `variable shadowing` tests have passed!".color("green").reset());
}
