use std/prelude;

fn main() {
    let exclaim = fn(string x) x <> "!";
    let whisper = fn(string x) x.to_lower();

    $assert(exclaim("Hello, world") == "Hello, world!", nil);
    $assert(whisper("Hello, world") == "hello, world", nil);

    let multiline = fn(f32 x) {
        let foo = math::sqrt(x) * E;
        return #cast(i32, foo / 4);
    };

    $assert(multiline(81) == 6, nil);
    $println("All `lambda` tests have passed!".color("green").reset());
}
