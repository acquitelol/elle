use std/prelude;

fn main() {
    a := string::ascii_lower();

    $assert(
        a.to_upper() == "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        string::format("result = \"{}\"", a.to_upper())
    );

    a.insert(11, '9');

    $assert(
        a == "abcdefghijk9lmnopqrstuvwxyz",
        string::format("result = \"{}\"", a)
    );

    b := "";
    $assert(b.is_empty(), "b should be empty");
    $assert(string::is_empty(b), "b should be empty");

    c := "test";

    $assert(
        c.len() == 4,
        string::format("result = \"{}\" & c.len() = {}", c, c.len())
    );

    d := "meow";

    $assert(d.ends_with("ow"), d <> " should end with \"ow\"");
    $assert(!d.starts_with("ow"), d <> " should not start with \"ow\"");
    $assert(d.contains("eo"), d <> " should contain \"eo\"");

    e := "ewew";

    $assert(
        e.concat(e) == "ewewewew" && e <> e == "ewewewew" && e <> e == e.concat(e),
        string::format("result = \"{}\"", e.concat(e))
    );

    f := "awa";

    $assert(
        f.repeat(4) == "awaawaawaawa",
        string::format("result = \"{}\"", f.repeat(4))
    );

    g := "test123AWA";

    $assert(
        g.to_upper() == "TEST123AWA",
        string::format("result = \"{}\"", g.to_upper())
    );

    $assert(
        g.to_lower() == "test123awa",
        string::format("result = \"{}\"", g.to_lower())
    );

    h := string::ascii_upper();
    $assert(
        h.slice(0, 3) == "ABC",
        string::format("result = \"{}\"", h.slice(0, 3))
    );

    i := "me";
    i.extend("wo");

    $assert(
        i == "mewo",
        string::format("result = \"{}\"", i)
    );

    ch := i.pop();

    $assert(ch == 'o', string::format("ch = {}", ch));
    $assert(i == "mew", string::format("result = \"{}\"", i));

    i.push('e');
    i.push('w');

    $assert(i == "mewew", string::format("result = \"{}\"", i));

    j := string::format(
        "abc {}, {}, escaped {{}, mrow {} and a char but i32: {}",
        1, true, ":3", #cast(i32, 'a')
    );

    $assert(
        j == "abc 1, true, escaped {}, mrow :3 and a char but i32: 97",
        string::format("result = \"{}\"", j)
    );

    $println("All `string` tests have passed!".color("green").reset());
}
