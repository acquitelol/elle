use std/prelude;

fn main() {
    counter := Mutex::new(0);
    threads := (0..5)
        .map_with(fn:
            Thread::spawn_with(fn: {
                value := it.lock();
                defer it.unlock();
                return *value += 1;
            }, x1), counter)
        .collect();
    
    res := threads
        .iter()
        .map(fn: it.join())
        .map(fn: *it)
        .collect();
    
    $assert(*counter.lock() == 5);
    $assert(res == (1..=5).collect());
    $println("All `thread` tests have passed!".color("green").reset());
}