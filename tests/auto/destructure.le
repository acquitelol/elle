use std/prelude;
use std/vectors;

fn `array.tuple`() {
    x, y := [1, 2];
    $assert(x == 1, nil);
    $assert(y == 2, nil);
}

fn `array.triple`() {
    x, y, z := [1, 2, 3];
    $assert(x == 1, nil);
    $assert(y == 2, nil);
    $assert(z == 3, nil);
}

fn `tuple.tuple`() {
    x, y := $("a", 39);
    $assert(x == "a", nil);
    $assert(y == 39, nil);
}

fn `triple.tuple`() {
    x, y := $$("a", 39, 1.3);
    $assert(x == "a", nil);
    $assert(y == 39, nil);
}

fn `triple.triple`() {
    x, y, z := $$("a", 39, 1.3);
    $assert(x == "a", nil);
    $assert(y == 39, nil);
    // for some reason directly putting
    // the cond into the assert fails it
    a := z == 1.3;
    $assert(a, nil);
}

fn `Vector2.tuple`() {
    x, y := Vector2::new(1.3, 2.6);
    a := x == 1.3;
    b := y == 2.6;
    $assert(a, nil);
    $assert(b, nil);
}

fn `Vector3.tuple`() {
    x, y := Vector3::new(1.3, 0.6, 2.0);
    a := x == 1.3;
    b := y == 0.6;
    $assert(a, nil);
    $assert(b, nil);
}

fn `Vector3.triple`() {
    x, y, z := Vector3::new(1.3, 0.6, 2.0);
    a := x == 1.3;
    b := y == 0.6;
    c := z == 2.0;
    $assert(a, nil);
    $assert(b, nil);
    $assert(c, nil);
}

fn `let.tuple`() {
    let x, y = Vector2::from(3.9);
    a := x == 3.9;
    b := y == 3.9;
    $assert(a, nil);
    $assert(b, nil);
}

fn `let.triple`() {
    let x, y, z = Vector3::from(3.9);
    a := x == 3.9;
    b := y == 3.9;
    c := z == 3.9;
    $assert(a, nil);
    $assert(b, nil);
    $assert(c, nil);
}

fn `casted.tuple`() {
    i32 x, y = Vector2::from(3.9);
    $assert(x == 3, nil); // casted down
    $assert(y == 3, nil);
}

fn `casted.triple`() {
    i32 x, y, z = Vector3::from(3.9);
    $assert(x == 3, nil); // casted down
    $assert(y == 3, nil);
    $assert(z == 3, nil);
}

fn `Option.some.tuple`() {
    is_some, val := Option::Some(39);
    $assert(is_some, nil);
    $assert(val == 39, nil);

    if is_some, val := Option::Some(39) {} else {
        $assert(false, nil);
    }
}

fn `Option.none.tuple`() {
    is_some, val := Option::None<i32>();
    $assert(!is_some, nil);

    if is_some, val := Option::None<i32>() {
        $assert(false, nil);
    }
}

fn `Result.ok.tuple`() {
    is_ok, val := Result::Ok<i32, string>(39);
    $assert(is_ok, nil);
    $assert(val == 39, nil);

    if is_ok, val := Result::Ok<i32, string>(39) {} else {
        $assert(false, nil);
    }
}

fn `Result.err.tuple`() {
    is_ok, val := Result::Err<i32, string>("a");
    $assert(!is_ok, nil);

    if is_ok, val := Result::Err<i32, string>("a") {
        $assert(false, nil);
    }
}

fn `Result.ok.triple`() {
    is_ok, val, err := Result::Ok<i32, string>(39);
    $assert(is_ok, nil);
    $assert(val == 39, nil);

    if is_ok, val, err := Result::Ok<i32, string>(39) {} else {
        $assert(false, nil);
    }
}

fn `Result.err.triple`() {
    is_ok, val, err := Result::Err<i32, string>("a");
    $assert(!is_ok, nil);
    $assert(err == "a", nil);

    if is_ok, val, err := Result::Err<i32, string>("a") {
        $assert(false, nil);
    }
}


fn main() {
    `array.tuple`();
    `array.triple`();
    `tuple.tuple`();
    `triple.tuple`();
    `triple.triple`();
    `Vector2.tuple`();
    `Vector3.tuple`();
    `Vector3.triple`();
    `let.tuple`();
    `let.triple`();
    `casted.tuple`();
    `casted.triple`();
    `Option.some.tuple`();
    `Option.none.tuple`();
    `Result.ok.tuple`();
    `Result.err.tuple`();
    `Result.ok.triple`();
    `Result.err.triple`();

    $println("All `tuple destructuring` tests have passed!".color("green").reset());
}
