use std/collections/hashset;
use std/io;

fn main() {
    let set = HashSet::new<i32>();
    $assert(set.is_empty(), nil);

    set.add(1);
    $assert(set.size() == 1, nil);

    set.add(1);
    $assert(set.size() == 1, nil);
    $assert(!set.contains(39), nil);

    set.add(39);
    $assert(set.size() == 2, nil);

    set.add(14);
    $assert(set.size() == 3, nil);

    $assert(set.contains(39), nil);

    set.remove(39);
    $assert(!set.contains(39), nil);
    $assert(set.size() == 2, nil);

    set.clear();
    $assert(set.is_empty(), nil);

    $println("All `HashSet` tests have passed!".color("green").reset());
}
